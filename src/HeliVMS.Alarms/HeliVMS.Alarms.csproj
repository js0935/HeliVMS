<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeliVMS.Core\HeliVMS.Core.csproj" />
    <ProjectReference Include="..\HeliVMS.Storage\HeliVMS.Storage.csproj" />
    <ProjectReference Include="..\HeliVMS.Shared\HeliVMS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeliVMS.Alarms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- System.Net.Mail.SmtpClient 在 .NET6+ 標 obsolete（CS0618），通知用仍是既有替代方案 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

</Project>
