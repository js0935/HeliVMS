<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- 服務為 Windows 專用（UseWindowsService）；M310 起直接呼叫 [SupportedOSPlatform("windows")]
         的 SystemClock 校時，故沿用 repo 預設的 net10.0-windows，讓平台相容性分析放行。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-HeliVMS.Agent-fb93b4f4-3696-48c0-9366-87db816f858d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeliVMS.Shared\HeliVMS.Shared.csproj" />
    <ProjectReference Include="..\HeliVMS.Core\HeliVMS.Core.csproj" />
    <ProjectReference Include="..\HeliVMS.Licensing\HeliVMS.Licensing.csproj" />
    <ProjectReference Include="..\HeliVMS.Media\HeliVMS.Media.csproj" />
    <ProjectReference Include="..\HeliVMS.Recording\HeliVMS.Recording.csproj" />
    <ProjectReference Include="..\HeliVMS.Alarms\HeliVMS.Alarms.csproj" />
    <ProjectReference Include="..\HeliVMS.Devices\HeliVMS.Devices.csproj" />
    <ProjectReference Include="..\HeliVMS.Storage\HeliVMS.Storage.csproj" />
  </ItemGroup>

</Project>


