<Window x:Class="HeliVMS.App.DeviceToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="880" Height="680"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}" Foreground="White" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="ToolsHeader" Text="" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="ToolsDesc" Text="" Margin="0,4,0,10"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Device tools. Reboot and firmware are destructive, so they are admin-gated and
             two-stage confirmed in code-behind; diagnostics and the A/V probe are read-only. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="DiagnosticsButton" AutomationProperties.AutomationId="DiagnosticsButton"
                    Content="" Click="OnDiagnosticsClicked" Padding="10,5"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip="" />
            <Button x:Name="AvTestButton" AutomationProperties.AutomationId="AvTestButton"
                    Content="" Click="OnAvTestClicked" Margin="6,0,0,0" Padding="10,5"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip="" />
            <Button x:Name="RebootButton" AutomationProperties.AutomationId="RebootButton"
                    Content="" Click="OnRebootClicked" Margin="6,0,0,0" Padding="10,5"
                    Foreground="White" Background="#8A5A2E" BorderThickness="0" ToolTip="" />
            <Button x:Name="FirmwareButton" AutomationProperties.AutomationId="FirmwareButton"
                    Content="" Click="OnFirmwareClicked" Margin="6,0,0,0" Padding="10,5"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0" ToolTip="" />
            <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton"
                    Content="" Click="OnRefreshHistoryClicked" Margin="6,0,0,0" Padding="10,5"
                    Foreground="White" Background="#2A4A73" BorderThickness="0" ToolTip="" />
        </WrapPanel>

        <TextBlock Grid.Row="2" x:Name="ReportHeader" Text="" FontWeight="Bold" FontSize="13"
                   Margin="0,0,0,4" />

        <TextBox Grid.Row="3" x:Name="ReportText" AutomationProperties.AutomationId="ReportText"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11.5"
                 Foreground="#C8D6E5" Background="#080F1A" BorderBrush="#1F3A5F"
                 Padding="6" Text="" />

        <TextBlock Grid.Row="4" x:Name="HistoryHeader" Text="" FontWeight="Bold" FontSize="13"
                   Margin="0,10,0,4" />

        <ListView Grid.Row="5" x:Name="HistoryList" AutomationProperties.AutomationId="HistoryList"
                  Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="ColTime" Header="" Width="150" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn x:Name="ColOp" Header="" Width="130" DisplayMemberBinding="{Binding Op}" />
                    <GridViewColumn x:Name="ColResult" Header="" Width="90" DisplayMemberBinding="{Binding Result}" />
                    <GridViewColumn x:Name="ColDetail" Header="" Width="440" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Content="" Click="OnCloseClicked" Padding="16,6"
                    DockPanel.Dock="Right" AutomationProperties.AutomationId="DeviceToolsCloseButton"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0" />
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Text="" />
        </DockPanel>
    </Grid>
</Window>
