<Window x:Class="HeliVMS.App.SystemHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SystemHealthWindow"
        Title=""
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadingText"
                   AutomationProperties.AutomationId="HeadingText"
                   Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="HealthSummaryText" AutomationProperties.AutomationId="HealthSummaryText"
                       Foreground="White" FontSize="13" LineHeight="22"/>
            <Button x:Name="HealthRefreshButton" AutomationProperties.AutomationId="HealthRefreshButton"
                    Content="" Click="OnRefreshClicked" Width="84" Padding="0,6" Margin="16,0,0,0"
                    VerticalAlignment="Top" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="TrendLabel" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,4"/>
        <Border Grid.Row="2" BorderBrush="#1F3A5F" BorderThickness="1" Background="#0E1D33"
                Height="90" VerticalAlignment="Bottom" Margin="0,34,0,0">
            <Canvas x:Name="HealthTrendCanvas" AutomationProperties.AutomationId="HealthTrendCanvas"
                    Background="Transparent"/>
        </Border>

        <ListView x:Name="HealthDiskList" AutomationProperties.AutomationId="HealthDiskList"
                  Grid.Row="3" Margin="0,14,0,0"
                  Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Total}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Free}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FreePercent}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Format}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="HealthStatusText" AutomationProperties.AutomationId="HealthStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
