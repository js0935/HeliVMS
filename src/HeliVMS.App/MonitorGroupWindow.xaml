<Window x:Class="HeliVMS.App.MonitorGroupWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="" Height="660" Width="880"
         Background="{StaticResource Brand.BgDeep}" Foreground="White"
         WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="MonitorGroupHeader" Text="" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="MonitorGroupDesc" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,4,0,12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" AutomationProperties.AutomationId="MonitorGroupCloseButton"
                    Content="" Click="OnCloseClicked" Padding="16,6"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Source channels to add into a group. -->
            <TextBlock x:Name="SourceHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
            <ListBox x:Name="SourceChannelList" AutomationProperties.AutomationId="MonitorGroupSourceChannelList"
                     Height="150" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                     DisplayMemberPath="Label"/>

            <!-- Group create / rename / delete. -->
            <WrapPanel Margin="0,14,0,0">
                <TextBlock x:Name="GroupNameLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="GroupNameBox" AutomationProperties.AutomationId="GroupNameBox"
                         Width="130" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <Button x:Name="CreateGroupButton" AutomationProperties.AutomationId="CreateGroupButton"
                        Content="" Click="OnCreateGroupClicked" Padding="8,4"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip=""/>
                <Button x:Name="RenameGroupButton" AutomationProperties.AutomationId="RenameGroupButton"
                        Content="" Click="OnRenameGroupClicked" Margin="6,0,0,0" Padding="8,4"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
                <Button x:Name="DeleteGroupButton" AutomationProperties.AutomationId="DeleteGroupButton"
                        Content="" Click="OnDeleteGroupClicked" Margin="6,0,0,0" Padding="8,4"
                        Foreground="White" Background="#8A3C2E" BorderThickness="0" ToolTip=""/>
            </WrapPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="GroupListHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <ListBox x:Name="GroupList" AutomationProperties.AutomationId="GroupList"
                             Height="170" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                             SelectionChanged="OnGroupSelected" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <Button x:Name="AddToGroupButton" AutomationProperties.AutomationId="AddToGroupButton"
                            Content="" Click="OnAddToGroupClicked" Padding="8,4" Margin="0,0,0,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip=""/>
                    <Button x:Name="RemoveFromGroupButton" AutomationProperties.AutomationId="RemoveFromGroupButton"
                            Content="" Click="OnRemoveFromGroupClicked" Padding="8,4" Margin="0,0,0,6"
                            Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
                    <Button x:Name="GroupUpButton" AutomationProperties.AutomationId="GroupUpButton"
                            Content="" Click="OnGroupUpClicked" Padding="8,4" Margin="0,0,0,6"
                            Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
                    <Button x:Name="GroupDownButton" AutomationProperties.AutomationId="GroupDownButton"
                            Content="" Click="OnGroupDownClicked" Padding="8,4"
                            Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="GroupMembersHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <ListBox x:Name="GroupMemberList" AutomationProperties.AutomationId="GroupMemberList"
                             Height="170" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                             DisplayMemberPath="Name"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="GroupHintText" AutomationProperties.AutomationId="MonitorGroupHint"
                       Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
