<Window x:Class="HeliVMS.App.WallMirrorWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="" Height="752" Width="1128"
         Background="#06090F" WindowStartupLocation="Manual"
         WindowStyle="None" ResizeMode="NoResize" PreviewKeyDown="OnWindowKeyDown">
    <DockPanel>
        <!-- Exit button: the mirror is borderless, so it must carry its own way out
             (same rule as every borderless window in this app). -->
        <Button x:Name="CloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0" Padding="10,4" FontSize="14"
                Foreground="White" Background="#C62828" BorderThickness="0"
                AutomationProperties.AutomationId="MirrorCloseButton" />
        <!-- Split cycle: 1 -> 2 -> 4 -> 9 -> 16. The mirror spends no decode CPU (frames are
             forwarded), but every cell is its own WriteableBitmap, so the ceiling is 16. -->
        <Button x:Name="SplitButton" Content="4" Click="OnSplitClicked" ToolTip=""
                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,6,0" Padding="10,4" FontSize="13"
                Foreground="White" Background="#1F3A5F" BorderThickness="0"
                AutomationProperties.AutomationId="MirrorSplitButton" />
        <!-- Channel source cycle: follow the main wall's tab, or pin one monitor group so the
             second screen can keep showing (say) the gate while the main wall pages elsewhere. -->
        <Button x:Name="SourceButton" Content="" Click="OnSourceClicked" ToolTip=""
                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="10,4" FontSize="13"
                Foreground="White" Background="#1F3A5F" BorderThickness="0"
                AutomationProperties.AutomationId="MirrorSourceButton" />
        <Grid>
            <UniformGrid x:Name="MirrorGrid" Rows="2" Columns="2" />
        </Grid>
    </DockPanel>
</Window>
