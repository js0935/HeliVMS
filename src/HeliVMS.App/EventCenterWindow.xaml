<Window x:Class="HeliVMS.App.EventCenterWindow" FocusManager.FocusedElement="{Binding ElementName=KeywordBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="1100" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" Closing="OnClosing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- filter row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ChannelLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="ChannelCombo" Width="180" Margin="6,0,0,0"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged"/>

            <TextBlock x:Name="RangeLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="RangeCombo" AutomationProperties.AutomationId="RangeCombo" Width="110" Margin="6,0,0,0" SelectedIndex="1"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged">
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content=""/>
            </ComboBox>

            <TextBlock x:Name="TypeLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="TypeCombo" AutomationProperties.AutomationId="TypeCombo" Width="130" Margin="6,0,0,0"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged"/>

            <TextBlock x:Name="KeywordLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox x:Name="KeywordBox" AutomationProperties.AutomationId="KeywordBox"
                     Width="140" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>

            <CheckBox x:Name="PendingOnlyCheck" Content="" AutomationProperties.AutomationId="PendingOnlyCheck"
                      Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"
                      Checked="OnPendingOnlyChanged" Unchecked="OnPendingOnlyChanged"
                      ToolTip=""/>

            <Button x:Name="ApplyQueryButton" AutomationProperties.AutomationId="ApplyQueryButton" ToolTip=""
                    Content="" Click="OnApplyQueryClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" IsDefault="True"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>

            <Button x:Name="RefreshButton" Content="" Click="OnRefreshClicked" ToolTip=""
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="RefreshButton"/>

            <Button x:Name="ExportCsvButton" AutomationProperties.AutomationId="ExportCsvButton" ToolTip=""
                    Content="" Click="OnExportCsvClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>

            <Button x:Name="ViewToggleButton" Content="" Click="OnViewToggleClicked" ToolTip=""
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A7F6E" BorderThickness="0" AutomationProperties.AutomationId="ViewToggleButton"/>
            
            <TextBlock x:Name="CountText" Foreground="{StaticResource Brand.TextDim}"
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EventListHeadingText" Text="" Foreground="{StaticResource Brand.TextDim}" Margin="8,6" FontSize="11"/>
                    
                    <!-- grid view -->
                    <ListView x:Name="EventList" AutomationProperties.AutomationId="EventList" Grid.Row="1"
                              SelectionChanged="OnEventSelected"
                              MouseDoubleClick="OnEventDoubleClick"
                              Background="Transparent" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="{Binding TypeBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationLabel}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{Binding StatusBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AssignedTo}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    
                    <!-- card view -->
                    <ListBox x:Name="CardList" Grid.Row="1" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             SelectionChanged="OnCardSelected" MouseDoubleClick="OnEventDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2C49" BorderBrush="#2A4A73" BorderThickness="1" 
                                        Margin="0,0,0,8" Padding="8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- thumbnail -->
                                        <Border Grid.Column="0" Background="#05090E" Width="48" Height="36" 
                                                CornerRadius="2" VerticalAlignment="Center">
                                            <Image x:Name="ThumbImage" Source="{Binding ThumbnailSource}" 
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Border>
                                        
                                        <!-- event info -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding TypeBrush}" CornerRadius="3" 
                                                        Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="3" 
                                                        Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StartLabel}" FontSize="11" Foreground="White" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="10" Foreground="{StaticResource Brand.TextDim}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="LightSteelBlue" 
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="8,4,8,0">
                        <TextBlock x:Name="DispositionLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DispositionCombo" AutomationProperties.AutomationId="DispositionCombo"
                                  Width="100" Margin="4,0,0,0" SelectedIndex="0"
                                  Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                            <ComboBoxItem Content="" Tag="pending"/>
                            <ComboBoxItem Content="" Tag="acknowledged"/>
                            <ComboBoxItem Content="" Tag="actioned"/>
                            <ComboBoxItem Content="" Tag="false_alarm"/>
                        </ComboBox>
                        <TextBlock x:Name="AssignLabelText" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="AssignBox" AutomationProperties.AutomationId="AssignBox"
                                 Width="100" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <TextBlock x:Name="NoteLabelText" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="NoteBox" AutomationProperties.AutomationId="NoteBox"
                                 Width="180" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <Button x:Name="ApplyDispositionButton" AutomationProperties.AutomationId="ApplyDispositionButton" ToolTip=""
                                Content="" Click="OnApplyDispositionClicked" IsEnabled="False"
                                Padding="10,4" Margin="10,0,0,0" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    </StackPanel>

                    <TextBlock x:Name="TrailText" AutomationProperties.AutomationId="TrailText" Grid.Row="3"
                               Margin="8,4,8,0" FontSize="10" Foreground="LightSteelBlue"
                               TextTrimming="CharacterEllipsis" Text=""/>

                    <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="8">
                        <Button x:Name="AckButton" Content="" Click="OnAckClicked" IsEnabled="False" ToolTip=""
                                Padding="10,4" Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="AckButton"/>
                        <Button x:Name="UnackButton" Content="" Click="OnUnackClicked" IsEnabled="False" ToolTip=""
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#5A4A2A" BorderThickness="0" AutomationProperties.AutomationId="UnackButton"/>
                        <Button x:Name="PlaybackButton" Content="" Click="OnPlaybackClicked" IsEnabled="False" ToolTip=""
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#2A7F6E" BorderThickness="0" AutomationProperties.AutomationId="PlaybackButton"/>
                        <Button x:Name="MapLocateButton" AutomationProperties.AutomationId="MapLocateButton" ToolTip=""
                                Content="" Click="OnMapLocateClicked" IsEnabled="False"
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#3A7A6E" BorderThickness="0"/>
                        <Button x:Name="PrevPageButton" AutomationProperties.AutomationId="PrevPageButton" ToolTip=""
                                Content="" Click="OnPrevPageClicked" IsEnabled="False"
                                Padding="10,4" Margin="22,0,0,0" Foreground="White"
                                Background="#33506E" BorderThickness="0"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <Button x:Name="NextPageButton" AutomationProperties.AutomationId="NextPageButton" ToolTip=""
                                Content="" Click="OnNextPageClicked" IsEnabled="False"
                                Padding="10,4" Foreground="White" Background="#33506E" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SnapshotHeadingText" Text="" Foreground="{StaticResource Brand.TextDim}" Margin="8,6" FontSize="11"/>
                    <Border Grid.Row="1" Background="#05090E" Margin="6">
                        <Grid x:Name="SnapGrid" SizeChanged="OnSnapGridSizeChanged">
                            <Image x:Name="SnapshotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                            <Canvas x:Name="SnapOverlay" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SnapshotHint" Text=""
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brand.TextDim}" FontSize="12"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="8,2">
                        <TextBlock x:Name="SnapshotDetailText" Foreground="LightSteelBlue"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" MaxHeight="34"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SnapshotPathText" Foreground="{StaticResource Brand.TextDim}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="SnapshotRedactButton" AutomationProperties.AutomationId="SnapshotRedactButton"
                                Content="" Click="OnRedactSnapshotClicked" Margin="0,4,0,0"
                                Foreground="White" Background="#5A3A5A" BorderThickness="0" Padding="0,4"
                                ToolTip=""/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>