<Window x:Class="HeliVMS.App.EventCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliVMS 事件中心"
        Width="1100" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" Closing="OnClosing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 過濾列 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ChannelLabel" Text="頻道" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ChannelCombo" Width="180" Margin="6,0,0,0"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged"/>

            <TextBlock x:Name="RangeLabel" Text="範圍" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="RangeCombo" Width="110" Margin="6,0,0,0" SelectedIndex="1"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged">
                <ComboBoxItem Content="今天"/>
                <ComboBoxItem Content="24 小時"/>
                <ComboBoxItem Content="7 天"/>
                <ComboBoxItem Content="全部"/>
            </ComboBox>

            <TextBlock x:Name="TypeLabel" Text="類型" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="TypeCombo" Width="130" Margin="6,0,0,0"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                      SelectionChanged="OnChannelSelectionChanged"/>

            <TextBlock x:Name="KeywordLabel" Text="關鍵字" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox x:Name="KeywordBox" AutomationProperties.AutomationId="KeywordBox"
                     Width="140" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>

            <Button x:Name="ApplyQueryButton" AutomationProperties.AutomationId="ApplyQueryButton"
                    Content="套用" Click="OnApplyQueryClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>

            <Button x:Name="RefreshButton" Content="重新整理" Click="OnRefreshClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>

            <Button x:Name="ExportCsvButton" AutomationProperties.AutomationId="ExportCsvButton"
                    Content="匯出 CSV" Click="OnExportCsvClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            
            <Button x:Name="ViewToggleButton" Content="卡片" Click="OnViewToggleClicked"
                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="White" Background="#2A7F6E" BorderThickness="0"/>
            
            <TextBlock x:Name="CountText" Foreground="{StaticResource Brand.TextDim}"
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="事件清單（motion / offline / ai_person / ai_vehicle…）" Foreground="{StaticResource Brand.TextDim}" Margin="8,6" FontSize="11"/>
                    
                    <!-- 網格檢視（既有） -->
                    <ListView x:Name="EventList" Grid.Row="1"
                              SelectionChanged="OnEventSelected"
                              MouseDoubleClick="OnEventDoubleClick"
                              Background="Transparent" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="時間（本地）" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="頻道" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="類型" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EventType}" FontSize="12" Foreground="{Binding TypeBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="持續" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationLabel}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="詳情" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="狀態" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{Binding StatusBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="指派" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AssignedTo}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    
                    <!-- 卡片檢視（新增） -->
                    <ListBox x:Name="CardList" Grid.Row="1" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             SelectionChanged="OnCardSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2C49" BorderBrush="#2A4A73" BorderThickness="1" 
                                        Margin="0,0,0,8" Padding="8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 縮圖 -->
                                        <Border Grid.Column="0" Background="#05090E" Width="48" Height="36" 
                                                CornerRadius="2" VerticalAlignment="Center">
                                            <Image x:Name="ThumbImage" Source="{Binding ThumbnailSource}" 
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Border>
                                        
                                        <!-- 事件資訊 -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding TypeBrush}" CornerRadius="3" 
                                                        Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EventType}" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="3" 
                                                        Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StartLabel}" FontSize="11" Foreground="White" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="10" Foreground="{StaticResource Brand.TextDim}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="LightSteelBlue" 
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="8,4,8,0">
                        <TextBlock Text="處置" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DispositionCombo" AutomationProperties.AutomationId="DispositionCombo"
                                  Width="100" Margin="4,0,0,0" SelectedIndex="0"
                                  Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                            <ComboBoxItem Content="待處理" Tag="pending"/>
                            <ComboBoxItem Content="已確認" Tag="acknowledged"/>
                            <ComboBoxItem Content="已處理" Tag="actioned"/>
                            <ComboBoxItem Content="誤報" Tag="false_alarm"/>
                        </ComboBox>
                        <TextBlock Text="指派" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="AssignBox" AutomationProperties.AutomationId="AssignBox"
                                 Width="100" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <TextBlock Text="備註" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="NoteBox" AutomationProperties.AutomationId="NoteBox"
                                 Width="180" Margin="4,0,0,0" VerticalAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <Button x:Name="ApplyDispositionButton" AutomationProperties.AutomationId="ApplyDispositionButton"
                                Content="套用處置" Click="OnApplyDispositionClicked" IsEnabled="False"
                                Padding="10,4" Margin="10,0,0,0" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    </StackPanel>

                    <TextBlock x:Name="TrailText" AutomationProperties.AutomationId="TrailText" Grid.Row="3"
                               Margin="8,4,8,0" FontSize="10" Foreground="LightSteelBlue"
                               TextTrimming="CharacterEllipsis" Text="軌跡：—"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="8">
                        <Button x:Name="AckButton" Content="標記為已確認" Click="OnAckClicked" IsEnabled="False"
                                Padding="10,4" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                        <Button x:Name="UnackButton" Content="標記為未確認" Click="OnUnackClicked" IsEnabled="False"
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#5A4A2A" BorderThickness="0"/>
                        <Button x:Name="PlaybackButton" Content="回放此事件" Click="OnPlaybackClicked" IsEnabled="False"
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#2A7F6E" BorderThickness="0"/>
                        <Button x:Name="MapLocateButton" AutomationProperties.AutomationId="MapLocateButton"
                                Content="在地圖定位" Click="OnMapLocateClicked" IsEnabled="False"
                                Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#3A7A6E" BorderThickness="0"/>
                        <Button x:Name="PrevPageButton" AutomationProperties.AutomationId="PrevPageButton"
                                Content="◀ 上一頁" Click="OnPrevPageClicked" IsEnabled="False"
                                Padding="10,4" Margin="22,0,0,0" Foreground="White"
                                Background="#33506E" BorderThickness="0"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <Button x:Name="NextPageButton" AutomationProperties.AutomationId="NextPageButton"
                                Content="下一頁 ▶" Click="OnNextPageClicked" IsEnabled="False"
                                Padding="10,4" Foreground="White" Background="#33506E" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="事件快照" Foreground="{StaticResource Brand.TextDim}" Margin="8,6" FontSize="11"/>
                    <Border Grid.Row="1" Background="#05090E" Margin="6">
                        <Grid x:Name="SnapGrid" SizeChanged="OnSnapGridSizeChanged">
                            <Image x:Name="SnapshotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                            <Canvas x:Name="SnapOverlay" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SnapshotHint" Text="選擇 AI／運動事件以顯示觸發快照"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brand.TextDim}" FontSize="12"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="8,2">
                        <TextBlock x:Name="SnapshotDetailText" Foreground="LightSteelBlue"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" MaxHeight="34"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SnapshotPathText" Foreground="{StaticResource Brand.TextDim}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>