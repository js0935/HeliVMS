<Window x:Class="HeliVMS.App.RulesWindow" FocusManager.FocusedElement="{Binding ElementName=RulesNameBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="RulesWindow"
        Title=""
        Width="880" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White" Loaded="OnLoaded" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
            </StackPanel>
            <Button x:Name="CloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                    Grid.Column="1" Padding="10,4" FontSize="14"
                    Foreground="White" Background="#C62828" BorderThickness="0"
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RulesCloseButton"/>
        </Grid>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="RulesDescText" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="RulesAddToggleButton" AutomationProperties.AutomationId="RulesAddToggleButton" ToolTip=""
                        Content="" Click="OnAddToggleClicked"
                        Width="92" Padding="0,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="RulesRefreshButton" AutomationProperties.AutomationId="RulesRefreshButton" ToolTip=""
                        Content="" Click="OnRefreshClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" x:Name="RulesEditPanel" Visibility="Collapsed"
                Background="#102030" BorderBrush="#2A5C8A" BorderThickness="1" CornerRadius="3"
                Margin="0,12,0,0" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RulesModeLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <ComboBox x:Name="RulesModeCombo" AutomationProperties.AutomationId="RulesModeCombo"
                              Width="120" Margin="8,0,0,0" SelectionChanged="OnRulesModeChanged">
                        <ComboBoxItem x:Name="RulesModeSimple"/>
                        <ComboBoxItem x:Name="RulesModeAdvanced"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="RulesSimplePanel" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RulesSimpleEventLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="RulesSimpleEventCombo" AutomationProperties.AutomationId="RulesSimpleEventCombo"
                                  Width="170" Margin="8,0,0,0"/>
                        <TextBlock x:Name="RulesSimpleChannelLabel" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="RulesSimpleChannelCombo" AutomationProperties.AutomationId="RulesSimpleChannelCombo"
                                  Width="170" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="RulesSimpleCountCheck" Content="" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox x:Name="RulesSimpleCountBox" Width="46" Margin="6,0,0,0" Text="3" Foreground="Black"/>
                        <TextBlock x:Name="RulesSimpleCountWithinLabel" Text="" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="RulesSimpleSecondsBox" Width="46" Margin="6,0,0,0" Text="60" Foreground="Black"/>
                        <TextBlock x:Name="RulesSimpleSecondsUnit" Text="" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="RulesSimpleTimeCheck" Content="" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox x:Name="RulesSimpleStartBox" Width="52" Margin="6,0,0,0" Text="0000" Foreground="Black"/>
                        <TextBlock x:Name="RulesSimpleTimeDash" Text="-" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource Brand.TextDim}"/>
                        <TextBox x:Name="RulesSimpleEndBox" Width="52" Margin="0,0,0,0" Text="2359" Foreground="Black"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="RulesSimpleSeverityLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="RulesSimpleSeverityCombo" Width="110" Margin="8,0,0,0"/>
                        <TextBlock x:Name="RulesSimpleTagLabel" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="RulesSimpleTagBox" Width="140" Margin="8,0,0,0" Foreground="Black"/>
                        <CheckBox x:Name="RulesSimpleNotifyCheck" Content="" IsChecked="True" Margin="14,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RulesNameLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <TextBox x:Name="RulesNameBox" AutomationProperties.AutomationId="RulesNameBox"
                             Width="180" Margin="8,0,0,0" Foreground="Black"/>
                    <CheckBox x:Name="RulesEnabledBox" Content="" IsChecked="True" AutomationProperties.AutomationId="RulesEnabledBox" ToolTip=""
                              Margin="16,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="RulesAdvancedPanel">
                <TextBlock x:Name="RulesExprLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <TextBox x:Name="RulesExprBox" AutomationProperties.AutomationId="RulesExprBox"
                         Height="56" AcceptsReturn="True" TextWrapping="NoWrap" Foreground="Black" FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="RulesActionsLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <TextBox x:Name="RulesActionsBox" AutomationProperties.AutomationId="RulesActionsBox"
                         Height="40" AcceptsReturn="True" TextWrapping="NoWrap" Foreground="Black" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RulesConfirmButton" AutomationProperties.AutomationId="RulesConfirmButton" ToolTip=""
                            Content="" Click="OnAddConfirmed"
                            Width="90" Padding="0,5"
                            Foreground="White" Background="#3A6A5A" BorderThickness="0"/>
                    <Button x:Name="RulesCancelButton" Click="OnAddToggleClicked" ToolTip=""
                            Content="" Width="60" Padding="0,5" Margin="8,0,0,0"
                            Foreground="White" Background="#5A3A3A" BorderThickness="0" AutomationProperties.AutomationId="RulesCancelButton"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" x:Name="RulesList" AutomationProperties.AutomationId="RulesList"
                  Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                  Foreground="White" SelectionMode="Single" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="RulesColName" Header="" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="RulesColState" Header="" Width="64">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding EnabledText}" FontSize="12" Foreground="{Binding EnabledColor}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="RulesColExpr" Header="" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ExpressionSummary}" FontSize="12" TextWrapping="Wrap" Foreground="#C9D8E8"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="RulesColActions" Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ActionsSummary}" FontSize="12" TextWrapping="Wrap" Foreground="#C9D8E8"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="RulesColOps" Header="" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding ToggleText}" Click="OnToggleClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding EditText}" Click="OnEditClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding DeleteText}" Click="OnDeleteClicked"
                                            Foreground="White" Background="#7A3A3A" BorderThickness="0"
                                            Padding="6,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- IO linkage: contacts are registered in Settings > IO; this configures
             what a DI trigger does (alarm event / DO output). -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="IoRulesHeaderText" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="IoRulesAddToggleButton" AutomationProperties.AutomationId="IoRulesAddToggleButton" ToolTip=""
                        Content="" Click="OnIoRuleAddToggleClicked"
                        Width="92" Padding="0,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="IoRulesRefreshButton" AutomationProperties.AutomationId="IoRulesRefreshButton" ToolTip=""
                        Content="" Click="OnIoRuleRefreshClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
            </StackPanel>
            <Border x:Name="IoRulesEditPanel" Visibility="Collapsed"
                    Background="#102030" BorderBrush="#2A5C8A" BorderThickness="1" CornerRadius="3"
                    Margin="0,10,0,0" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IoRuleInputLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="IoRuleInputCombo" AutomationProperties.AutomationId="IoRuleInputCombo"
                                  Width="230" Margin="8,0,0,0"/>
                        <TextBlock x:Name="IoRuleActionLabel" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="IoRuleActionCombo" AutomationProperties.AutomationId="IoRuleActionCombo"
                                  Width="150" Margin="8,0,0,0" SelectionChanged="OnIoRuleActionChanged">
                            <ComboBoxItem x:Name="IoRuleActionAlarmItem"/>
                            <ComboBoxItem x:Name="IoRuleActionDoItem"/>
                        </ComboBox>
                        <CheckBox x:Name="IoRuleEnabledBox" Content="" IsChecked="True" Margin="16,0,0,0"
                                  Foreground="White" VerticalAlignment="Center" ToolTip=""/>
                    </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="IoRuleTargetLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="IoRuleOutputCombo" AutomationProperties.AutomationId="IoRuleOutputCombo"
                                  Width="200" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBox x:Name="IoRuleEventTypeBox" AutomationProperties.AutomationId="IoRuleEventTypeBox"
                                 Width="140" Margin="8,0,0,0" Visibility="Visible" Foreground="Black"/>
                        <TextBlock x:Name="IoRuleRetriggerLabel" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="IoRuleRetriggerBox" AutomationProperties.AutomationId="IoRuleRetriggerBox"
                                 Width="46" Margin="6,0,0,0" Text="30" Foreground="Black"/>
                        <TextBlock x:Name="IoRuleOutputSecLabel" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="IoRuleOutputSecBox" AutomationProperties.AutomationId="IoRuleOutputSecBox"
                                 Width="46" Margin="6,0,0,0" Text="0" Foreground="Black"/>
                        <TextBlock x:Name="IoRuleResetLabel" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="IoRuleResetBox" AutomationProperties.AutomationId="IoRuleResetBox"
                                 Width="46" Margin="6,0,0,0" Text="0" Foreground="Black"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="IoRuleLinkLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="IoRuleLinkCombo" AutomationProperties.AutomationId="IoRuleLinkCombo"
                                  Width="200" Margin="8,0,0,0"/>
                        <CheckBox x:Name="IoRuleFullscreenBox" Content="" Margin="12,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="IoRuleSnapshotBox" Content="" Margin="10,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="IoRuleMapBox" Content="" Margin="10,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox x:Name="IoRuleSoundBox" AutomationProperties.AutomationId="IoRuleSoundBox"
                                 Width="170" Margin="10,0,0,0" Foreground="Black"/>
                        <Button x:Name="IoRuleSoundBrowseButton" Content="" Click="OnIoRuleSoundBrowseClicked"
                                Margin="6,0,0,0" Padding="8,3"
                                Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="IoRuleConfirmButton" AutomationProperties.AutomationId="IoRuleConfirmButton" ToolTip=""
                                Content="" Click="OnIoRuleConfirmed"
                                Width="90" Padding="0,5"
                                Foreground="White" Background="#3A6A5A" BorderThickness="0"/>
                        <Button x:Name="IoRuleCancelButton" Click="OnIoRuleAddToggleClicked" ToolTip=""
                                Content="" Width="60" Padding="0,5" Margin="8,0,0,0"
                                Foreground="White" Background="#5A3A3A" BorderThickness="0" AutomationProperties.AutomationId="IoRuleCancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ListView Grid.Row="4" x:Name="IoRuleList" AutomationProperties.AutomationId="IoRuleList"
                  Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                  Foreground="White" SelectionMode="Single" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="IoRuleColInput" Header="" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding InputText}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="IoRuleColAction" Header="" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ActionText}" FontSize="12" TextWrapping="Wrap" Foreground="#C9D8E8"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="IoRuleColRetrigger" Header="" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding RetriggerText}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="IoRuleColState" Header="" Width="64">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding EnabledText}" FontSize="12" Foreground="{Binding EnabledColor}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="IoRuleColOps" Header="" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding ToggleText}" Click="OnIoRuleToggleClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding EditText}" Click="OnIoRuleEditClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding DeleteText}" Click="OnIoRuleDeleteClicked"
                                            Foreground="White" Background="#7A3A3A" BorderThickness="0"
                                            Padding="6,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Scheduled maintenance tasks: reboot / snapshot / reconnect.
             Timing decisions live in Shared.MaintenanceTaskPlanner; execution in App.Services.MaintenanceTaskHost. -->
        <StackPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="TasksHeaderText" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="TasksAddToggleButton" AutomationProperties.AutomationId="TasksAddToggleButton" ToolTip=""
                        Content="" Click="OnTaskAddToggleClicked"
                        Width="92" Padding="0,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="TasksRefreshButton" AutomationProperties.AutomationId="TasksRefreshButton" ToolTip=""
                        Content="" Click="OnTaskRefreshClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
            </StackPanel>
            <Border x:Name="TasksEditPanel" Visibility="Collapsed"
                    Background="#102030" BorderBrush="#2A5C8A" BorderThickness="1" CornerRadius="3"
                    Margin="0,10,0,0" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TaskNameLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TaskNameBox" AutomationProperties.AutomationId="TaskNameBox"
                                 Width="170" Margin="8,0,0,0" Foreground="Black"/>
                        <TextBlock x:Name="TaskKindLabel" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="TaskKindCombo" AutomationProperties.AutomationId="TaskKindCombo"
                                  Width="150" Margin="8,0,0,0">
                            <ComboBoxItem x:Name="TaskKindRebootItem"/>
                            <ComboBoxItem x:Name="TaskKindSnapshotItem"/>
                            <ComboBoxItem x:Name="TaskKindReconnectItem"/>
                            <ComboBoxItem x:Name="TaskKindRestartAppItem"/>
                        </ComboBox>
                        <CheckBox x:Name="TaskEnabledBox" Content="" IsChecked="True" Margin="16,0,0,0"
                                  Foreground="White" VerticalAlignment="Center" ToolTip=""/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="TaskSchedLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="TaskSchedCombo" AutomationProperties.AutomationId="TaskSchedCombo"
                                  Width="120" Margin="8,0,0,0" SelectionChanged="OnTaskSchedChanged">
                            <ComboBoxItem x:Name="TaskSchedDailyItem"/>
                            <ComboBoxItem x:Name="TaskSchedWeeklyItem"/>
                            <ComboBoxItem x:Name="TaskSchedIntervalItem"/>
                        </ComboBox>
                        <TextBlock x:Name="TaskTimeLabel" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TaskTimeBox" AutomationProperties.AutomationId="TaskTimeBox"
                                 Width="52" Margin="8,0,0,0" Text="0330" Foreground="Black" ToolTip=""/>
                        <TextBlock x:Name="TaskIntervalLabel" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TaskIntervalBox" AutomationProperties.AutomationId="TaskIntervalBox"
                                 Width="52" Margin="8,0,0,0" Text="60" Foreground="Black"/>
                        <TextBlock x:Name="TaskIntervalUnit" Text="" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBlock x:Name="TaskChannelLabel" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <ComboBox x:Name="TaskChannelCombo" AutomationProperties.AutomationId="TaskChannelCombo"
                                  Width="190" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" x:Name="TaskWeekdaysPanel">
                        <TextBlock x:Name="TaskWeekdayLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <CheckBox x:Name="TaskDow0" Content="" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow1" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow2" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow3" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow4" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow5" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TaskDow6" Content="" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TaskConfirmButton" AutomationProperties.AutomationId="TaskConfirmButton" ToolTip=""
                                Content="" Click="OnTaskConfirmed"
                                Width="90" Padding="0,5"
                                Foreground="White" Background="#3A6A5A" BorderThickness="0"/>
                        <Button x:Name="TaskCancelButton" Click="OnTaskAddToggleClicked" ToolTip=""
                                Content="" Width="60" Padding="0,5" Margin="8,0,0,0"
                                Foreground="White" Background="#5A3A3A" BorderThickness="0" AutomationProperties.AutomationId="TaskCancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ListView Grid.Row="6" x:Name="TaskList" AutomationProperties.AutomationId="TaskList"
                  Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                  Foreground="White" SelectionMode="Single" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="TaskColName" Header="" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding NameText}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TaskColKind" Header="" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding KindText}" FontSize="12" Foreground="#C9D8E8"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TaskColSchedule" Header="" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding ScheduleText}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TaskColLastRun" Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LastRunText}" FontSize="12" TextWrapping="Wrap" Foreground="#C9D8E8"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TaskColState" Header="" Width="64">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding EnabledText}" FontSize="12" Foreground="{Binding EnabledColor}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TaskColOps" Header="" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding ToggleText}" Click="OnTaskToggleClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button x:Name="TaskRunButton" Content="{Binding RunText}" Click="OnTaskRunClicked"
                                            Foreground="White" Background="#2F6E5A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding EditText}" Click="OnTaskEditClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="{Binding DeleteText}" Click="OnTaskDeleteClicked"
                                            Foreground="White" Background="#7A3A3A" BorderThickness="0"
                                            Padding="6,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="7" Margin="0,14,0,0">
            <TextBlock x:Name="RulesEvalHeaderText" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBlock x:Name="RulesEvalText" AutomationProperties.AutomationId="RulesEvalText"
                       Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="RulesStatusText" AutomationProperties.AutomationId="RulesStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
