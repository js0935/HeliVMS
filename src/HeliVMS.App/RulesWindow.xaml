<Window x:Class="HeliVMS.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="RulesWindow"
        Title="HeliVMS 複合事件規則"
        Width="880" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White" Loaded="OnLoaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="複合事件規則（M62，§5.10）：match / all / any / not / within / count / timeBetween。"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="RulesAddToggleButton" AutomationProperties.AutomationId="RulesAddToggleButton"
                        Content="＋ 新增規則" Click="OnAddToggleClicked"
                        Width="92" Padding="0,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="RulesRefreshButton" AutomationProperties.AutomationId="RulesRefreshButton"
                        Content="重新整理" Click="OnRefreshClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" x:Name="RulesEditPanel" Visibility="Collapsed"
                Background="#102030" BorderBrush="#2A5C8A" BorderThickness="1" CornerRadius="3"
                Margin="0,12,0,0" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="名稱" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <TextBox x:Name="RulesNameBox" AutomationProperties.AutomationId="RulesNameBox"
                             Width="180" Margin="8,0,0,0" Foreground="Black"/>
                    <CheckBox x:Name="RulesEnabledBox" Content="啟用" IsChecked="True"
                              Margin="16,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="條件 JSON（expression_json）" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <TextBox x:Name="RulesExprBox" AutomationProperties.AutomationId="RulesExprBox"
                         Height="56" AcceptsReturn="True" TextWrapping="NoWrap" Foreground="Black" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="行為 JSON（actions_json，可留空）" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <TextBox x:Name="RulesActionsBox" AutomationProperties.AutomationId="RulesActionsBox"
                         Height="40" AcceptsReturn="True" TextWrapping="NoWrap" Foreground="Black" FontFamily="Consolas" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RulesConfirmButton" AutomationProperties.AutomationId="RulesConfirmButton"
                            Content="確認新增" Click="OnAddConfirmed"
                            Width="90" Padding="0,5"
                            Foreground="White" Background="#3A6A5A" BorderThickness="0"/>
                    <Button x:Name="RulesCancelButton" Click="OnAddToggleClicked"
                            Content="取消" Width="60" Padding="0,5" Margin="8,0,0,0"
                            Foreground="White" Background="#5A3A3A" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" x:Name="RulesList" AutomationProperties.AutomationId="RulesList"
                  Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                  Foreground="White" SelectionMode="Single" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名稱" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="狀態" Width="64">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EnabledText}" Foreground="{Binding EnabledColor}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="條件摘" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExpressionSummary}" TextWrapping="Wrap" Foreground="#C9D8E8"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="動作" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActionsSummary}" TextWrapping="Wrap" Foreground="#C9D8E8"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding ToggleText}" Click="OnToggleClicked"
                                            Foreground="White" Background="#3A5A7A" BorderThickness="0"
                                            Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Content="刪除" Click="OnDeleteClicked"
                                            Foreground="White" Background="#7A3A3A" BorderThickness="0"
                                            Padding="6,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="內建樣本序列評估（t0 motion → t+5 ai_intrusion → t+10 offline → t+20/t+25 motion；t 為視窗開啟當下）"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBlock x:Name="RulesEvalText" AutomationProperties.AutomationId="RulesEvalText"
                       Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="RulesStatusText" AutomationProperties.AutomationId="RulesStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>