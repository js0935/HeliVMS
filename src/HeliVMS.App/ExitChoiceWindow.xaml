<Window x:Class="HeliVMS.App.ExitChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" FontSize="13"
                   Foreground="White" Text="" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="MinimizeButton" Content="" Click="OnMinimizeClicked" Padding="14,5" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="ExitMinimizeButton"
                    Foreground="White" Background="#2A4A73" BorderThickness="0" />
            <Button x:Name="QuitButton" Content="" Click="OnQuitClicked" Padding="14,5" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="ExitQuitButton"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0" />
            <Button x:Name="CancelButton" Content="" Click="OnCancelClicked" Padding="14,5" IsCancel="True"
                    AutomationProperties.AutomationId="ExitCancelButton"
                    Foreground="White" Background="#333F4F" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
