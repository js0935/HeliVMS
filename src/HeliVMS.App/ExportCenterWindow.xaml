<Window x:Class="HeliVMS.App.ExportCenterWindow" FocusManager.FocusedElement="{Binding ElementName=StartTime}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ExportCenterWindow"
        Title=""
        Width="760" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Add export -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="ExportCenterAddHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="ExportCenterChannelLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ListBox x:Name="ChannelList" Width="200" Height="56" Margin="8,0,0,0"
                         SelectionMode="Multiple" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <DatePicker x:Name="StartDate" AutomationProperties.AutomationId="CenterStartDate"
                            Width="120" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBox x:Name="StartTime" AutomationProperties.AutomationId="ExportCenterStartTime" Width="64" Margin="6,0,0,0" Text="00:00:00"
                         VerticalContentAlignment="Center" Foreground="White"
                         Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="～" VerticalAlignment="Center" Margin="8,0"/>
                <DatePicker x:Name="EndDate" AutomationProperties.AutomationId="CenterEndDate"
                            Width="120" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBox x:Name="EndTime" AutomationProperties.AutomationId="ExportCenterEndTime" Width="64" Margin="6,0,0,0" Text="23:59:59"
                         VerticalContentAlignment="Center" Foreground="White"
                         Background="#1A2C49" BorderBrush="#2A4A73"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="ExportCenterOutputLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="CenterOutputBox" AutomationProperties.AutomationId="CenterOutputBox"
                         Width="420" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="CenterBrowseButton" Content="" Click="OnCenterBrowseClicked" ToolTip=""
                        Width="60" Margin="8,0,0,0" Padding="0,6"
                        Foreground="White" Background="#2A4A73" BorderThickness="0" AutomationProperties.AutomationId="CenterBrowseButton"/>
                <Button x:Name="AddExportButton" AutomationProperties.AutomationId="AddExportButton" ToolTip=""
                        Content="" Click="OnAddClicked"
                        Width="80" Margin="8,0,0,0" Padding="0,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <!-- Job list -->
        <TextBlock Grid.Row="1" x:Name="ExportCenterListLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,2"/>
        <ListView Grid.Row="2" x:Name="JobList" AutomationProperties.AutomationId="JobList"
                  Background="#0E1C30" BorderBrush="#2A4A73" Foreground="White"
                  MouseDoubleClick="OnJobDoubleClick"
                  ToolTip="">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" Foreground="White"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Action row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CenterRefreshButton" Content="" Click="OnRefreshClicked" ToolTip=""
                    Width="64" Padding="0,6" Foreground="White" Background="#2A4A73" BorderThickness="0" AutomationProperties.AutomationId="CenterRefreshButton"/>
            <Button x:Name="CenterRunButton" AutomationProperties.AutomationId="CenterRunButton" ToolTip=""
                    Content="" Click="OnRunClicked"
                    Width="80" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <Button x:Name="CenterVerifyButton" AutomationProperties.AutomationId="CenterVerifyButton" ToolTip=""
                    Content="" Click="OnVerifyClicked"
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#4A5C4A" BorderThickness="0"/>
            <Button x:Name="CenterSigningKeysButton" AutomationProperties.AutomationId="CenterSigningKeysButton" ToolTip=""
                    Content="" Click="OnSigningKeysClicked"
                    Width="80" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#3A4A6A" BorderThickness="0"/>
            <Button x:Name="CenterDeleteButton" Content="" Click="OnDeleteClicked" ToolTip=""
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0" AutomationProperties.AutomationId="CenterDeleteButton"/>
            <Button x:Name="CenterRetryButton" AutomationProperties.AutomationId="CenterRetryButton" ToolTip=""
                    Content="" Click="OnRetryClicked"
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A6F3A" BorderThickness="0"/>
            <Button x:Name="CenterOpenFolderButton" AutomationProperties.AutomationId="CenterOpenFolderButton" ToolTip=""
                    Content="" Click="OnOpenFolderClicked"
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A7F6E" BorderThickness="0"/>
            <Button x:Name="CenterPurgeButton" Content="" Click="OnPurgeClicked" ToolTip=""
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#3A4A6A" BorderThickness="0" AutomationProperties.AutomationId="CenterPurgeButton"/>
            <Button x:Name="ShareFromExportButton" AutomationProperties.AutomationId="ShareFromExportButton" ToolTip=""
                    Content="" Click="OnShareClicked"
                    Width="100" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ExportCenterStatus" AutomationProperties.AutomationId="ExportCenterStatus"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
