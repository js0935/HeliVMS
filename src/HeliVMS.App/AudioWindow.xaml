<Window x:Class="HeliVMS.App.AudioWindow" FocusManager.FocusedElement="{Binding ElementName=AudioChannelCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AudioWindow"
        Title=""
        Width="780" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="AudioDescriptionText" Grid.Row="0" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="AudioChannelLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <ComboBox x:Name="AudioChannelCombo" AutomationProperties.AutomationId="AudioChannelCombo"
                      Width="180" Margin="8,0,0,0" Foreground="Black"/>
            <Button x:Name="AudioFeedButton" AutomationProperties.AutomationId="AudioFeedButton" ToolTip=""
                    Content="" Click="OnFeedClicked"
                    Width="90" Padding="0,6" Margin="14,0,0,0"
                    Foreground="White" Background="#7A2A2A" BorderThickness="0"/>
            <Button x:Name="AudioResetButton" AutomationProperties.AutomationId="AudioResetButton" ToolTip=""
                    Content="" Click="OnResetClicked"
                    Width="70" Padding="0,6" Margin="10,0,0,0"
                    Foreground="White" Background="#5A5A6A" BorderThickness="0"/>
            <Button x:Name="AudioFlushButton" AutomationProperties.AutomationId="AudioFlushButton" ToolTip=""
                    Content="" Click="OnFlushClicked"
                    Width="70" Padding="0,6" Margin="10,0,0,0"
                    Foreground="White" Background="#3A5A2A" BorderThickness="0"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="AudioStateList" AutomationProperties.AutomationId="AudioStateList"
                  Margin="0,12,0,0" Foreground="White" Background="#0E1B2A" BorderBrush="#1F3A5F" BorderThickness="1"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="100" DisplayMemberBinding="{Binding ChannelText}"/>
                    <GridViewColumn Header="" Width="60" DisplayMemberBinding="{Binding EnabledText}"/>
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding LastKindText}"/>
                    <GridViewColumn Header="" Width="80" DisplayMemberBinding="{Binding EventCountText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" x:Name="AudioStatusText" AutomationProperties.AutomationId="AudioStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>