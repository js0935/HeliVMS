<Window x:Class="HeliVMS.App.EvidenceWindow" FocusManager.FocusedElement="{Binding ElementName=EvidenceDirBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="EvidenceWindow"
        Title=""
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="EvidenceHeadingText" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="EvidenceDirectoryLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBox x:Name="EvidenceDirBox" AutomationProperties.AutomationId="EvidenceDirBox"
                     Width="460" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <Button x:Name="EvidenceBrowseButton" AutomationProperties.AutomationId="EvidenceBrowseButton" ToolTip=""
                    Content="" Click="OnBrowseClicked"
                    Margin="8,0,0,0" Padding="10,5"
                    Foreground="White" Background="#2A4A73" BorderThickness="0"/>
            <Button x:Name="EvidenceCreateButton" AutomationProperties.AutomationId="EvidenceCreateButton" ToolTip=""
                    Content="" Click="OnCreateClicked"
                    Margin="12,0,0,0" Padding="12,6" IsDefault="True"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <Button x:Name="EvidenceVerifyButton" AutomationProperties.AutomationId="EvidenceVerifyButton" ToolTip=""
                    Content="" Click="OnVerifyClicked"
                    Margin="8,0,0,0" Padding="12,6"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="EvidenceList" AutomationProperties.AutomationId="EvidenceList"
                  Margin="0,12,0,0" Background="#0E1C30" BorderBrush="#2A4A73" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="250" DisplayMemberBinding="{Binding RelPath}"/>
                    <GridViewColumn Header="SHA-256" Width="292" DisplayMemberBinding="{Binding Sha256}"/>
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding SizeLabel}"/>
                    <GridViewColumn Header="" Width="110" DisplayMemberBinding="{Binding StatusLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" x:Name="EvidenceStatusText" AutomationProperties.AutomationId="EvidenceStatusText"
                   Margin="0,12,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>