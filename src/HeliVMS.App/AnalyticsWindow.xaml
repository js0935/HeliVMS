<Window x:Class="HeliVMS.App.AnalyticsWindow" FocusManager.FocusedElement="{Binding ElementName=AnalyticsNameBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AnalyticsWindow"
        Title=""
        Width="900" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Create analytics zone -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="AnalyticsDescText" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="AnalyticsNameLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsNameBox" AutomationProperties.AutomationId="AnalyticsNameBox"
                         Width="130" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="AnalyticsChannelLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsChannelCombo" AutomationProperties.AutomationId="AnalyticsChannelCombo"
                          Width="180" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Display"/>
                <TextBlock x:Name="AnalyticsModuleLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsModuleCombo" AutomationProperties.AutomationId="AnalyticsModuleCombo"
                          Width="120" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Label"/>
                <TextBlock x:Name="AnalyticsDirectionLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsDirectionCombo" AutomationProperties.AutomationId="AnalyticsDirectionCombo"
                          Width="90" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Label"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="AnalyticsPolygonLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsPolygonBox" AutomationProperties.AutomationId="AnalyticsPolygonBox"
                         Width="360" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="AnalyticsMinCountLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsMinCountBox" AutomationProperties.AutomationId="AnalyticsMinCountBox"
                         Width="56" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="AnalyticsDwellLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsDwellBox" AutomationProperties.AutomationId="AnalyticsDwellBox"
                         Width="56" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="AnalyticsAddButton" AutomationProperties.AutomationId="AnalyticsAddButton" ToolTip=""
                        Content="" Click="OnAddClicked"
                        Margin="12,0,0,0" Padding="12,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="AnalyticsListHeaderText" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,2"/>
        <ListView Grid.Row="2" x:Name="AnalyticsList" AutomationProperties.AutomationId="AnalyticsList"
                  Background="#0E1C30" BorderBrush="#2A4A73" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="AnalyticsColId" Header="ID"/>
                    <GridViewColumn x:Name="AnalyticsColName" Header=""/>
                    <GridViewColumn x:Name="AnalyticsColModule" Header=""/>
                    <GridViewColumn x:Name="AnalyticsColChannel" Header=""/>
                    <GridViewColumn x:Name="AnalyticsColState" Header=""/>
                    <GridViewColumn x:Name="AnalyticsColGeometry" Header=""/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="AnalyticsRefreshButton" AutomationProperties.AutomationId="AnalyticsRefreshButton" ToolTip=""
                    Content="" Click="OnRefreshClicked"
                    Width="64" Padding="0,6"
                    Foreground="White" Background="#2A4A73" BorderThickness="0"/>
            <Button x:Name="AnalyticsToggleButton" AutomationProperties.AutomationId="AnalyticsToggleButton" ToolTip=""
                    Content="" Click="OnToggleClicked"
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A4A73" BorderThickness="0"/>
            <Button x:Name="AnalyticsEvaluateButton" AutomationProperties.AutomationId="AnalyticsEvaluateButton" ToolTip=""
                    Content="" Click="OnEvaluateClicked"
                    Width="120" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <Button x:Name="AnalyticsDeleteButton" AutomationProperties.AutomationId="AnalyticsDeleteButton" ToolTip=""
                    Content="" Click="OnDeleteClicked"
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="AnalyticsStatusText" AutomationProperties.AutomationId="AnalyticsStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
