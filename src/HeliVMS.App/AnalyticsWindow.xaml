<Window x:Class="HeliVMS.App.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AnalyticsWindow"
        Title="HeliVMS 分析情境"
        Width="900" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 建立分析區 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="建立分析情境區（幾何 0..1 正規化；跨線需 2 點、區域／聚集需 3 點以上）"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="名稱" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsNameBox" AutomationProperties.AutomationId="AnalyticsNameBox"
                         Width="130" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="頻道" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsChannelCombo" AutomationProperties.AutomationId="AnalyticsChannelCombo"
                          Width="180" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Display"/>
                <TextBlock Text="模組" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsModuleCombo" AutomationProperties.AutomationId="AnalyticsModuleCombo"
                          Width="120" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="DisplayName"/>
                <TextBlock Text="方向" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AnalyticsDirectionCombo" AutomationProperties.AutomationId="AnalyticsDirectionCombo"
                          Width="90" Margin="8,0,0,0" Foreground="Black"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="多邊形" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsPolygonBox" AutomationProperties.AutomationId="AnalyticsPolygonBox"
                         Width="360" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="門檻" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsMinCountBox" AutomationProperties.AutomationId="AnalyticsMinCountBox"
                         Width="56" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="停留秒" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AnalyticsDwellBox" AutomationProperties.AutomationId="AnalyticsDwellBox"
                         Width="56" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="AnalyticsAddButton" AutomationProperties.AutomationId="AnalyticsAddButton"
                        Content="新增分析區" Click="OnAddClicked"
                        Margin="12,0,0,0" Padding="12,6"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="現有分析區" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,2"/>
        <ListView Grid.Row="2" x:Name="AnalyticsList" AutomationProperties.AutomationId="AnalyticsList"
                  Background="#0E1C30" BorderBrush="#2A4A73" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="44" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="名稱" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="模組" Width="110" DisplayMemberBinding="{Binding ModuleLabel}"/>
                    <GridViewColumn Header="頻道" Width="150" DisplayMemberBinding="{Binding ChannelLabel}"/>
                    <GridViewColumn Header="狀態" Width="70" DisplayMemberBinding="{Binding StateLabel}"/>
                    <GridViewColumn Header="幾何" Width="230" DisplayMemberBinding="{Binding GeometryLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AnalyticsRefreshButton" Content="刷新" Click="OnRefreshClicked"
                    Width="64" Padding="0,6" Foreground="White" Background="#2A4A73" BorderThickness="0"/>
            <Button x:Name="AnalyticsToggleButton" AutomationProperties.AutomationId="AnalyticsToggleButton"
                    Content="啟用/停用" Click="OnToggleClicked"
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A4A73" BorderThickness="0"/>
            <Button x:Name="AnalyticsEvaluateButton" AutomationProperties.AutomationId="AnalyticsEvaluateButton"
                    Content="以範例偵測評估" Click="OnEvaluateClicked"
                    Width="120" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <Button x:Name="AnalyticsDeleteButton" AutomationProperties.AutomationId="AnalyticsDeleteButton"
                    Content="刪除" Click="OnDeleteClicked"
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="AnalyticsStatusText" AutomationProperties.AutomationId="AnalyticsStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
