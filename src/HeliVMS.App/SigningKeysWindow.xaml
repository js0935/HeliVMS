<Window x:Class="HeliVMS.App.SigningKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SigningKeysWindow"
        Title=""
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="CurrentHeadingText"
                   AutomationProperties.AutomationId="CurrentHeadingText"
                   Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
        <TextBox Grid.Row="1" x:Name="CurrentFingerprintBox" AutomationProperties.AutomationId="CurrentFingerprintBox"
                 IsReadOnly="True" Margin="0,4,0,0" Padding="4,3" TextWrapping="Wrap"
                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>

        <TextBlock Grid.Row="2" x:Name="HistoryHeadingText"
                   AutomationProperties.AutomationId="HistoryHeadingText"
                   Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,2"/>
        <ListView Grid.Row="3" x:Name="KeyHistoryList" AutomationProperties.AutomationId="KeyHistoryList"
                  Background="#0E1C30" BorderBrush="#2A4A73" Foreground="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="560" DisplayMemberBinding="{Binding Fingerprint}"/>
                    <GridViewColumn Header="" Width="150" DisplayMemberBinding="{Binding RetiredLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RefreshKeysButton" Content="" Click="OnRefreshClicked" ToolTip=""
                    Width="64" Padding="0,6" Foreground="White" Background="#2A4A73" BorderThickness="0"
                    AutomationProperties.AutomationId="RefreshKeysButton"/>
            <Button x:Name="RotateKeyButton" Content="" Click="OnRotateClicked"
                    ToolTip=""
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A6F3A" BorderThickness="0"
                    AutomationProperties.AutomationId="RotateKeyButton"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="SigningStatusText" AutomationProperties.AutomationId="SigningStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
