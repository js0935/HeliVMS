<Window x:Class="HeliVMS.App.AlarmManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AlarmManagerWindow"
        Title="HeliVMS 警報管理器"
        Width="1000" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="警報管理器（分診／指派／優先序／處理時限）" FontSize="17" FontWeight="Bold"/>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton"
                    Content="重新整理" Click="OnRefreshClicked" DockPanel.Dock="Right"
                    Padding="12,4" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="SummaryText"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="#9FB3C8"/>
        </DockPanel>

        <ListView Grid.Row="2" x:Name="BoardList" AutomationProperties.AutomationId="BoardList"
                  Margin="0,8,0,0" Background="#0D1B2B" BorderBrush="#1F3A5F" Foreground="White"
                  SelectionChanged="OnBoardSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時間" Width="140" DisplayMemberBinding="{Binding StartLabel}"/>
                    <GridViewColumn Header="頻道" Width="90" DisplayMemberBinding="{Binding ChannelLabel}"/>
                    <GridViewColumn Header="類型" Width="80" DisplayMemberBinding="{Binding TypeLabel}"/>
                    <GridViewColumn Header="狀態" Width="80" DisplayMemberBinding="{Binding StatusLabel}"/>
                    <GridViewColumn Header="優先序" Width="70" DisplayMemberBinding="{Binding PriorityLabel}"/>
                    <GridViewColumn Header="負責人" Width="100" DisplayMemberBinding="{Binding OwnerLabel}"/>
                    <GridViewColumn Header="到期" Width="150" DisplayMemberBinding="{Binding DueLabel}"/>
                    <GridViewColumn Header="逾期" Width="60" DisplayMemberBinding="{Binding OverdueLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="狀態" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="DispositionCombo" AutomationProperties.AutomationId="DispositionCombo"
                      Width="90" Margin="0,0,12,0" DisplayMemberPath="Label" SelectedValuePath="Value"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <TextBlock Text="優先序" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PriorityCombo" AutomationProperties.AutomationId="PriorityCombo"
                      Width="80" Margin="0,0,12,0" DisplayMemberPath="Label" SelectedValuePath="Value"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <TextBlock Text="負責人" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="OwnerBox" AutomationProperties.AutomationId="OwnerBox"
                     Width="110" Margin="0,0,12,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <TextBlock Text="到期" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="DueDate" AutomationProperties.AutomationId="DueDate"
                        Width="120" Margin="0,0,6,0"
                        Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <TextBox x:Name="DueTime" AutomationProperties.AutomationId="DueTime"
                     Width="70" Text="00:00:00" Margin="0,0,12,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <TextBlock Text="備註" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="NoteBox" AutomationProperties.AutomationId="NoteBox"
                     Width="150" Margin="0,0,12,0" VerticalContentAlignment="Center"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            <Button x:Name="ApplyButton" AutomationProperties.AutomationId="ApplyButton"
                    Content="套用" Click="OnApplyClicked" Padding="14,4"
                    Foreground="White" Background="#A04A2A" BorderThickness="0"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" x:Name="ManagerStatusText" AutomationProperties.AutomationId="ManagerStatusText"
                   Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource Brand.TextDim}"/>
    </Grid>
</Window>