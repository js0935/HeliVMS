<Window x:Class="HeliVMS.App.SynopsisWindow" FocusManager.FocusedElement="{Binding ElementName=SynopsisFromBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SynopsisWindow"
        Title=""
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="SynopsisHeadingText" AutomationProperties.AutomationId="SynopsisHeadingText"
                       Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="SynopsisChannelLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="SynopsisChannelCombo" AutomationProperties.AutomationId="SynopsisChannelCombo"
                          Width="150" Margin="8,0,0,0" Foreground="Black"/>
                <TextBlock x:Name="SynopsisFromLabel" Text="" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="SynopsisFromBox" AutomationProperties.AutomationId="SynopsisFromBox"
                         Width="150" Margin="8,0,0,0" Foreground="Black"/>
                <TextBlock x:Name="SynopsisToLabel" Text="" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="SynopsisToBox" AutomationProperties.AutomationId="SynopsisToBox"
                         Width="150" Margin="8,0,0,0" Foreground="Black"/>
                <Button x:Name="SynopsisBuildButton" AutomationProperties.AutomationId="SynopsisBuildButton" ToolTip=""
                        Content="" Click="OnBuildClicked"
                        Width="92" Padding="0,6" Margin="14,0,0,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="SynopsisTimeHintText" AutomationProperties.AutomationId="SynopsisTimeHintText"
                       Text="" Margin="2,4,0,0"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="10"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="SynopsisSummaryText" AutomationProperties.AutomationId="SynopsisSummaryText"
                           Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>
                <Image x:Name="SynopsisImage" AutomationProperties.AutomationId="SynopsisImage"
                       Margin="0,10,0,0" Stretch="Uniform" MaxHeight="640"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SynopsisStatusText" AutomationProperties.AutomationId="SynopsisStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>