<Window x:Class="HeliVMS.App.SmartwallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SmartwallWindow"
        Title="HeliVMS 智慧牆"
        Width="1180" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="智慧牆（M105/M106，§14.7 #14）：版面網格編輯與警報牆快照（每頻道最新事件、≤5 秒高亮、>300 秒移出）。"
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左：版面清單與建立 -->
            <Border Grid.Column="0" BorderBrush="#1F3A5F" BorderThickness="1" Background="#0E1D33" Margin="0,0,10,0">
                <StackPanel Margin="8">
                    <TextBlock Text="版面" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,6"/>
                    <ListBox x:Name="LayoutList" AutomationProperties.AutomationId="SmartwallLayoutList"
                             Height="240" SelectionChanged="OnLayoutSelected"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             DisplayMemberPath="Name"/>
                    <TextBlock Text="名稱" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,10,0,2"/>
                    <TextBox x:Name="LayoutNameBox" AutomationProperties.AutomationId="SmartwallNameBox"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="列" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="LayoutRowsBox" AutomationProperties.AutomationId="SmartwallRowsBox" Text="2"
                                 Width="40" Margin="4,0,10,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,4"/>
                        <TextBlock Text="欄" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="LayoutColsBox" AutomationProperties.AutomationId="SmartwallColsBox" Text="2"
                                 Width="40" Margin="4,0,0,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,4"/>
                    </StackPanel>
                    <Button x:Name="CreateLayoutButton" AutomationProperties.AutomationId="SmartwallCreateButton"
                            Content="建立版面" Click="OnCreateLayoutClicked" Margin="0,8,0,0" Padding="0,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <Button x:Name="RenameLayoutButton" AutomationProperties.AutomationId="SmartwallRenameButton"
                            Content="重新命名" Click="OnRenameLayoutClicked" Margin="0,6,0,0" Padding="0,6"
                            Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- 中：版面網格 -->
            <Border Grid.Column="1" BorderBrush="#1F3A5F" BorderThickness="1" Background="#0A1420" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Margin="8">
                        <Grid x:Name="SmartwallGrid" AutomationProperties.AutomationId="SmartwallGrid"
                              Width="520" Height="360" Background="#06101A"/>
                    </Viewbox>

                    <WrapPanel Grid.Row="1" Margin="8">
                        <TextBlock Text="列" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TileRowBox" AutomationProperties.AutomationId="SmartwallTileRowBox" Text="0"
                                 Width="34" Margin="4,0,8,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,3"/>
                        <TextBlock Text="欄" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TileColBox" AutomationProperties.AutomationId="SmartwallTileColBox" Text="0"
                                 Width="34" Margin="4,0,8,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,3"/>
                        <TextBlock Text="列跨" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TileRowSpanBox" AutomationProperties.AutomationId="SmartwallTileRowSpanBox" Text="1"
                                 Width="34" Margin="4,0,8,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,3"/>
                        <TextBlock Text="欄跨" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="TileColSpanBox" AutomationProperties.AutomationId="SmartwallTileColSpanBox" Text="1"
                                 Width="34" Margin="4,0,8,0" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="4,3"/>
                        <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="SmartwallChannelCombo"
                                  Width="150" Margin="0,0,8,4" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <ComboBox x:Name="TileViewCombo" AutomationProperties.AutomationId="SmartwallTileViewCombo"
                                  Width="90" Margin="0,0,8,4" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="單鏡頭" Tag="0"/>
                            <ComboBoxItem Content="馬賽克" Tag="1"/>
                        </ComboBox>
                        <Button x:Name="AddTileButton" AutomationProperties.AutomationId="SmartwallAddTileButton"
                                Content="加方塊" Click="OnAddTileClicked" Padding="8,4" Margin="0,0,8,4"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                        <Button x:Name="RemoveTileButton" AutomationProperties.AutomationId="SmartwallRemoveTileButton"
                                Content="移除選取方塊" Click="OnRemoveTileClicked" Padding="8,4" Margin="0,0,8,4"
                                Foreground="White" Background="#7A3A3A" BorderThickness="0"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 右：警報牆 -->
            <Border Grid.Column="2" BorderBrush="#1F3A5F" BorderThickness="1" Background="#0E1D33">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="警報牆（每頻道最新）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <ListView x:Name="BoardList" AutomationProperties.AutomationId="SmartwallBoardList"
                              Grid.Row="1" Margin="0,8,0,0"
                              Background="#0A1420" Foreground="White" BorderBrush="#1F3A5F">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Rank}" FontSize="12"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="頻道" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Channel}" FontSize="12"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="型別" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding EventType}" FontSize="12"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="優先" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Priority}" FontSize="12"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="秒前" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Age}" FontSize="12"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2" x:Name="BoardStatusText" AutomationProperties.AutomationId="SmartwallBoardStatusText"
                               Margin="0,8,0,0" Foreground="#9FB8D8" TextWrapping="Wrap" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="TileStatusText" AutomationProperties.AutomationId="SmartwallTileStatusText"
                   Grid.Row="2" Margin="0,10,0,0"
                   Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
