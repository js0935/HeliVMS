<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeliVMS.Shared\HeliVMS.Shared.csproj" />
    <ProjectReference Include="..\HeliVMS.Core\HeliVMS.Core.csproj" />
    <ProjectReference Include="..\HeliVMS.Licensing\HeliVMS.Licensing.csproj" />
    <ProjectReference Include="..\HeliVMS.Media\HeliVMS.Media.csproj" />
    <ProjectReference Include="..\HeliVMS.Recording\HeliVMS.Recording.csproj" />
    <ProjectReference Include="..\HeliVMS.Alarms\HeliVMS.Alarms.csproj" />
    <ProjectReference Include="..\HeliVMS.Devices\HeliVMS.Devices.csproj" />
    <ProjectReference Include="..\HeliVMS.Storage\HeliVMS.Storage.csproj" />
    <!-- M305：設定中心「網路」頁要在行程內啟停 Web 服務，因此桌面程式直接引用 WebApi 專案。 -->
    <ProjectReference Include="..\HeliVMS.WebApi\HeliVMS.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 內嵌 ASP.NET Core（Kestrel）所需的共用框架；WebApi 是 Microsoft.NET.Sdk.Web，
         這裡用一般 SDK，必須明確加參考才編得過。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>HeliVMS</AssemblyTitle>
    <Product>HeliVMS</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Common" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Assets\app.ico">
      <Link>Assets\app.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Assets\splash.png">
      <Link>Assets\splash.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Assets\Disable.png">
      <Link>Assets\Disable.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Assets\Invisible.png">
      <Link>Assets\Invisible.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
