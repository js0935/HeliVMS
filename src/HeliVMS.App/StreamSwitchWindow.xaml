<Window x:Class="HeliVMS.App.StreamSwitchWindow" FocusManager.FocusedElement="{Binding ElementName=StreamChannelCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="StreamWindow"
        Title=""
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescriptionText" Grid.Row="0" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="ChannelLabelText" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <ComboBox x:Name="StreamChannelCombo" AutomationProperties.AutomationId="StreamChannelCombo"
                      Width="180" Margin="8,0,0,0" Foreground="Black"/>

            <TextBlock x:Name="BitrateLabelText" Text="" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBox x:Name="StreamBitrateText" AutomationProperties.AutomationId="StreamBitrateText"
                     Width="90" Margin="6,0,0,0" Text="10000000" Foreground="Black"/>

            <TextBlock x:Name="ViewersLabelText" Text="" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBox x:Name="StreamViewersText" AutomationProperties.AutomationId="StreamViewersText"
                     Width="50" Margin="6,0,0,0" Text="2" Foreground="Black"/>

            <TextBlock x:Name="HoldLabelText" Text="" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBox x:Name="StreamHoldText" AutomationProperties.AutomationId="StreamHoldText"
                     Width="50" Margin="6,0,0,0" Text="5" Foreground="Black"/>

            <Button x:Name="StreamBurstButton" AutomationProperties.AutomationId="StreamBurstButton" ToolTip=""
                    Content="" Click="OnBurstClicked"
                    Width="90" Padding="0,6" Margin="14,0,0,0"
                    Foreground="White" Background="#7A2A2A" BorderThickness="0"/>
            <Button x:Name="StreamEvalButton" AutomationProperties.AutomationId="StreamEvalButton" ToolTip=""
                    Content="" Click="OnEvalClicked"
                    Width="70" Padding="0,6" Margin="10,0,0,0"
                    Foreground="White" Background="#2A6A9A" BorderThickness="0"/>
            <Button x:Name="StreamApplyButton" AutomationProperties.AutomationId="StreamApplyButton" ToolTip=""
                    Content="" Click="OnApplyClicked"
                    Width="70" Padding="0,6" Margin="10,0,0,0"
                    Foreground="White" Background="#3A5A2A" BorderThickness="0"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="StreamStateList" AutomationProperties.AutomationId="StreamStateList"
                  Margin="0,12,0,0" Foreground="White" Background="#0E1B2A" BorderBrush="#1F3A5F" BorderThickness="1"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="StreamColChannel" Header="" Width="80" DisplayMemberBinding="{Binding ChannelText}"/>
                    <GridViewColumn x:Name="StreamColCurrent" Header="" Width="70" DisplayMemberBinding="{Binding CurrentText}"/>
                    <GridViewColumn x:Name="StreamColLastSwitch" Header="" Width="140" DisplayMemberBinding="{Binding LastSwitchText}"/>
                    <GridViewColumn x:Name="StreamColDecision" Header="" Width="220" DisplayMemberBinding="{Binding DecisionText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" x:Name="StreamDecisionText" AutomationProperties.AutomationId="StreamDecisionText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
