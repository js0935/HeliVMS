<Window x:Class="HeliVMS.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="LoginWindow"
        Title="登入"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1622" Foreground="White">
    <StackPanel Margin="28,22,28,22">
        <TextBlock Text="HeliVMS 登入" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="請輸入帳號與密碼" Foreground="{StaticResource Brand.TextDim}"
                   FontSize="11" Margin="0,0,0,18"/>

        <TextBlock Text="使用者名稱" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
        <TextBox x:Name="UsernameInput" AutomationProperties.AutomationId="UsernameBox"
                 Height="30" Margin="0,3,0,12" Padding="6,2"/>

        <TextBlock Text="密碼" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
        <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="LoginPasswordBox"
                     Height="30" Margin="0,3,0,12" Padding="6,2"/>

        <TextBlock x:Name="LoginMessage" AutomationProperties.AutomationId="LoginMessage"
                   Foreground="#FF8080" FontSize="12" TextWrapping="Wrap"
                   MinHeight="18" Margin="0,0,0,10"/>

        <StackPanel x:Name="OidcPanel" Visibility="Collapsed" Margin="0,0,0,10"
                    AutomationProperties.AutomationId="OidcPanel">
            <Border Background="#12283D" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="企業 SSO（OIDC 權杖登入）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="OidcProviderCombo" AutomationProperties.AutomationId="OidcProviderCombo"
                              Height="28" Margin="0,0,0,6" DisplayMemberPath="Name"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <TextBox x:Name="OidcTokenBox" AutomationProperties.AutomationId="OidcTokenBox"
                             Height="28" Padding="6,2" Margin="0,0,0,6" ToolTip="貼上 IdP 核發的 ID Token"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="OidcLoginButton" AutomationProperties.AutomationId="OidcLoginButton"
                            Content="以權杖登入" Height="28" Click="OnOidcLoginClicked"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="OidcMessage" AutomationProperties.AutomationId="OidcMessage"
                       Foreground="#FF8080" FontSize="11" TextWrapping="Wrap"
                       MinHeight="14" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel x:Name="LdapPanel" Visibility="Collapsed" Margin="0,0,0,10"
                    AutomationProperties.AutomationId="LdapPanel">
            <Border Background="#12283D" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="企業登入（LDAP／Active Directory）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LdapProviderCombo" AutomationProperties.AutomationId="LdapProviderCombo"
                              Height="28" Margin="0,0,0,6" DisplayMemberPath="Name"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="LdapLoginButton" AutomationProperties.AutomationId="LdapLoginButton"
                            Content="以 LDAP 登入" Height="28" Click="OnLdapLoginClicked"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="LdapMessage" AutomationProperties.AutomationId="LdapMessage"
                       Foreground="#FF8080" FontSize="11" TextWrapping="Wrap"
                       MinHeight="14" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" AutomationProperties.AutomationId="LoginCancelButton"
                    Content="取消" Width="86" Height="32" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancelClicked"/>
            <Button x:Name="LoginButton" AutomationProperties.AutomationId="LoginButton"
                    Content="登入" Width="86" Height="32" IsDefault="True"
                    Click="OnLoginClicked"/>
        </StackPanel>
    </StackPanel>
</Window>