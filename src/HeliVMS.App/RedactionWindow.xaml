<Window x:Class="HeliVMS.App.RedactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="RedactionWindow"
        Title="HeliVMS 錄影遮蔽"
        Width="720" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="錄影遮蔽（隱私遮罩）" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="選擇範圍後，以矩形區域模糊（boxblur）重新編碼輸出；可用於遮蔽敏感區域後提供影片。"
                   Grid.Row="1" Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="頻道" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="RedactChannelCombo"
                          Width="150" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <DatePicker x:Name="StartDate" AutomationProperties.AutomationId="RedactStartDate"
                            Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Width="120"/>
                <TextBox x:Name="StartTime" Width="70" Text="00:00:00" Margin="6,0,0,0"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="至" VerticalAlignment="Center" Margin="8,0"/>
                <DatePicker x:Name="EndDate" AutomationProperties.AutomationId="RedactEndDate"
                            Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Width="120"/>
                <TextBox x:Name="EndTime" Width="70" Text="23:59:59" Margin="6,0,0,0"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="遮蔽區域（像素座標）" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="X" VerticalAlignment="Center"/>
                <TextBox x:Name="RoiX" AutomationProperties.AutomationId="RedactRoiX" Width="56"
                         Text="0" Margin="4,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="Y" VerticalAlignment="Center"/>
                <TextBox x:Name="RoiY" AutomationProperties.AutomationId="RedactRoiY" Width="56"
                         Text="0" Margin="4,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="寬" VerticalAlignment="Center"/>
                <TextBox x:Name="RoiW" AutomationProperties.AutomationId="RedactRoiW" Width="56"
                         Text="120" Margin="4,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text="高" VerticalAlignment="Center"/>
                <TextBox x:Name="RoiH" AutomationProperties.AutomationId="RedactRoiH" Width="56"
                         Text="80" Margin="4,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="AddRoiButton" Content="加入遮罩" Click="OnAddRoiClicked" Margin="10,0,0,0"
                        Padding="10,4" Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="RemoveRoiButton" Content="移除所選" Click="OnRemoveRoiClicked" Margin="6,0,0,0"
                        Padding="10,4" Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
            </StackPanel>

            <ListView Grid.Row="1" x:Name="RoiList" AutomationProperties.AutomationId="RoiList"
                      Margin="0,8,0,0" Background="#0D1B2B" BorderBrush="#1F3A5F" Foreground="White">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="X" Width="60" DisplayMemberBinding="{Binding X}"/>
                        <GridViewColumn Header="Y" Width="60" DisplayMemberBinding="{Binding Y}"/>
                        <GridViewColumn Header="寬" Width="60" DisplayMemberBinding="{Binding Width}"/>
                        <GridViewColumn Header="高" Width="60" DisplayMemberBinding="{Binding Height}"/>
                        <GridViewColumn Header="遮罩" Width="140" DisplayMemberBinding="{Binding Label}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="RedactButton" AutomationProperties.AutomationId="RedactButton"
                    Content="開始遮蔽" Click="OnRedactClicked"
                    DockPanel.Dock="Right" Padding="14,8"
                    Foreground="White" Background="#A04A2A" BorderThickness="0"/>
            <ProgressBar x:Name="RedactProgress" AutomationProperties.AutomationId="RedactProgress"
                         Height="4" Margin="0,12,12,0" Value="0"/>
        </DockPanel>

        <TextBlock Grid.Row="4" x:Name="RedactStatusText" AutomationProperties.AutomationId="RedactStatusText"
                   Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource Brand.TextDim}"/>
    </Grid>
</Window>