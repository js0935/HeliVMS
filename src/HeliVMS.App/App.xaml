<Application x:Class="HeliVMS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HeliVMS.App">
    <Application.Resources>
        <!-- 深色主題（BRAND.md 第 1 節 Design Tokens）-->
        <SolidColorBrush x:Key="Brand.BgDeep" Color="#0B1B2E" />
        <SolidColorBrush x:Key="Brand.BgPanel" Color="#12233C" />
        <SolidColorBrush x:Key="Brand.TextPrimary" Color="#EBF3FF" />
        <SolidColorBrush x:Key="Brand.TextDim" Color="#8296B4" />
        <SolidColorBrush x:Key="Brand.Accent" Color="#2660AA" />

        <!-- 全域深色元件樣式：修復視窗內未自訂屬性時的下拉選單／按鈕白底白字 -->
        <!-- 說明：各視窗若已在 XAML 本機設定 Foreground/Background，該值優先於樣式，不受影響。 -->
        <!-- 鍵盤焦點視覺：僅在有鍵盤焦點時顯示（WPF 內建切換），滑鼠操作不影響畫面 -->
        <Style x:Key="FocusVisualAccent">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="4" RadiusY="4"
                                   Stroke="#4D9FFF" StrokeThickness="1.5"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 統一深色按鈕模板：hover 提亮／按下加深／停用降透明度，
             顏色由 TemplateBinding 承接本機設定，任何按鈕底色皆適用。
             以 ButtonBase 為目標型別，讓 Button 與 ToggleButton 共用同一外觀；
             ToggleButton（如跳台）若不套用，就會退回 Aero2 預設方形外框，
             在標頭列大小／格式都與旁邊按鈕不一致。 -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
            <Grid>
                <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                </Border>
                <Border x:Name="hov" Background="#14FFFFFF" CornerRadius="4"
                        IsHitTestVisible="False" Opacity="0" />
                <Border x:Name="prs" Background="#24FFFFFF" CornerRadius="4"
                        IsHitTestVisible="False" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="hov" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="prs" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#2660AA" />
            <Setter Property="BorderBrush" Value="#1D4C8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
        </Style>

        <!-- 開關型按鈕（標頭列的跳台等）與一般按鈕同尺寸／同外框，
             僅以選取時的底色變化表示啟用狀態。 -->
        <Style x:Key="HeaderToggleButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A5C8A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2F8A5A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <!-- 只設 Background/Foreground 蓋不掉 Aero2 預設模板：下拉彈出視窗是淺色底，
                 在全域白色 TextBlock 之下變成「白底白字」。必須自訂模板連彈出清單一起換成深色。
                 這與右鍵選單同一個病根（見 ContextMenu）。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#9FB8D8" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                                  SnapsToDevicePixels="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#5A6070" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="#12233C"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#3A6AA8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8296B4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 深色右鍵選單：全域 TextBlock 樣式把文字設為近白（#EBF3FF），但 ContextMenu/MenuItem
             預設模板是淺色彈出視窗且未套用品牌色，於是監控中心格位右鍵選單變成「白底白字」。
             補深色底＋強調色 hover，並自訂 MenuItem 模板避免預設模板以系統淺色 highlight 覆蓋。
             另必須自訂 ContextMenu 模板：Aero2 預設模板會在選單左側硬畫一塊 #F1F1F1 的
             「圖示欄」底色與兩條分隔線（供勾選圖示用），MenuItem 底為透明時這塊淺色就從左半邊
             透出來，只改 Background 蓋不掉。自訂模板只留深色框與 ItemsPresenter，別無其他。 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8296B4" />
                            </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 深色分隔線：預設 Separator 是淺色細線，在深色選單上幾乎看不見。 -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="#2A4A73" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="Foreground" Value="#2660AA" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
        </Style>

        <!-- 深色 GroupBox：僅 PtzWindow（雲台移動／預設點）使用；表頭本機色優先，
             未自訂時以品牌顏色呈現外框與標題文字。 -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <!-- 深色月曆：以隱含樣式直擊 Calendar 內層元件（預設模板產生的元件同樣套用隱含樣式，
             不覆寫模板以保全月曆標題/選取/黑日期邏輯）。IsSelected/IsMouseOver 仍由預設模板
             以強調色呈現，深底上保持可讀。 -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="CalendarItem">
            <Setter Property="Background" Value="#0F1D2E" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#1D3A5F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <!-- 全域輸入框深色樣式：統一 TextBox/PasswordBox 深色，並於右側內嵌「⌨」螢幕虛擬鍵盤呼叫按鈕。
             呼叫按鈕不隨焦點自動彈出；點擊後以 Osk 於視窗底部顯示 ASCII 鍵盤。 -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CaretBrush" Value="#EBF3FF" />
            <Setter Property="SelectionBrush" Value="#2660AA" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="8,4,40,4" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                                <Button x:Name="PART_OskCall" AutomationProperties.AutomationId="OskCallButton" Content="&#x2328;" Width="24" Height="24"
                                        HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Focusable="False" IsTabStop="False" Cursor="Hand"
                                        FontSize="12" Padding="0" Visibility="{x:Static local:Osk.CallVisibility}"
                                        Foreground="#EBF3FF" Background="#1A2C49"
                                        BorderThickness="0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="OnInputLoaded" />
            <EventSetter Event="Unloaded" Handler="OnInputUnloaded" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CaretBrush" Value="#EBF3FF" />
            <Setter Property="SelectionBrush" Value="#2660AA" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="8,4,40,4" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                                <Button x:Name="PART_OskCall" AutomationProperties.AutomationId="OskCallButton" Content="&#x2328;" Width="24" Height="24"
                                        HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Focusable="False" IsTabStop="False" Cursor="Hand"
                                        FontSize="12" Padding="0" Visibility="{x:Static local:Osk.CallVisibility}"
                                        Foreground="#EBF3FF" Background="#1A2C49"
                                        BorderThickness="0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="OnInputLoaded" />
            <EventSetter Event="Unloaded" Handler="OnInputUnloaded" />
        </Style>

        <!-- 深色提示框：全域 TextBlock 樣式會連 ContentPresenter 產生的文字一起染成近白，
             淺底（#F0F4FA）會變成白底白字，故改用深色底以維持可讀。 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2660AA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style x:Key="DarkThumbVertical" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="#2A4A73" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A5A85" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2660AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkThumbHorizontal" TargetType="Thumb">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="#2A4A73" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A5A85" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2660AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色卷軸：取代 ListView/ListBox/ScrollViewer 隱性出現的系統淺灰卷軸樣式。
             保留 Track 頁面點按（PageUp/Down、PageLeft/Right），Thumb 圓角＋hover/拖曳狀態降溫。
             注意：Thumb 樣式必須定義於卷軸樣式之前，StaticResource 不支援同字典向前引用。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A1624" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumbVertical}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DarkThumbHorizontal}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 深色進度條：僅兜底未自訂色的視窗（Dewarp/Redaction）；Export/OnvifWizard 本機色優先。
             不覆蓋模板，保留 OnvifWizard IsIndeterminate 動畫。 -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="Foreground" Value="#2660AA" />
        </Style>
    </Application.Resources>
</Application>
