<Application x:Class="HeliVMS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HeliVMS.App">
    <Application.Resources>
        <!-- 深色主題（BRAND.md 第 1 節 Design Tokens）-->
        <SolidColorBrush x:Key="Brand.BgDeep" Color="#0B1B2E" />
        <SolidColorBrush x:Key="Brand.BgPanel" Color="#12233C" />
        <SolidColorBrush x:Key="Brand.TextPrimary" Color="#EBF3FF" />
        <SolidColorBrush x:Key="Brand.TextDim" Color="#8296B4" />
        <SolidColorBrush x:Key="Brand.Accent" Color="#2660AA" />

        <!-- 全域深色元件樣式：修復視窗內未自訂屬性時的下拉選單／按鈕白底白字 -->
        <!-- 說明：各視窗若已在 XAML 本機設定 Foreground/Background，該值優先於樣式，不受影響。 -->
        <!-- 鍵盤焦點視覺：僅在有鍵盤焦點時顯示（WPF 內建切換），滑鼠操作不影響畫面 -->
        <Style x:Key="FocusVisualAccent">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="4" RadiusY="4"
                                   Stroke="#4D9FFF" StrokeThickness="1.5"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#2660AA" />
            <Setter Property="BorderBrush" Value="#1D4C8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <!-- 統一深色按鈕模板：hover 提亮／按下加深／停用降透明度，
                 顏色由 TemplateBinding 承接本機設定，任何按鈕底色皆適用 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            </Border>
                            <Border x:Name="hov" Background="#14FFFFFF" CornerRadius="4"
                                    IsHitTestVisible="False" Opacity="0" />
                            <Border x:Name="prs" Background="#24FFFFFF" CornerRadius="4"
                                    IsHitTestVisible="False" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="prs" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <!-- 全域輸入框深色樣式：統一 TextBox/PasswordBox 深色，並於右側內嵌「⌨」螢幕虛擬鍵盤呼叫按鈕。
             呼叫按鈕不隨焦點自動彈出；點擊後以 Osk 於視窗底部顯示 ASCII 鍵盤。 -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CaretBrush" Value="#EBF3FF" />
            <Setter Property="SelectionBrush" Value="#2660AA" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="8,4,40,4" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                                <Button x:Name="PART_OskCall" AutomationProperties.AutomationId="OskCallButton" Content="&#x2328;" Width="24" Height="24"
                                        HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Focusable="False" IsTabStop="False" Cursor="Hand"
                                        FontSize="12" Padding="0" Visibility="{x:Static local:Osk.CallVisibility}"
                                        ToolTip="螢幕虛擬鍵盤" Foreground="#EBF3FF" Background="#1A2C49"
                                        BorderThickness="0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="OnInputLoaded" />
            <EventSetter Event="Unloaded" Handler="OnInputUnloaded" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CaretBrush" Value="#EBF3FF" />
            <Setter Property="SelectionBrush" Value="#2660AA" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="8,4,40,4" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                                <Button x:Name="PART_OskCall" AutomationProperties.AutomationId="OskCallButton" Content="&#x2328;" Width="24" Height="24"
                                        HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Focusable="False" IsTabStop="False" Cursor="Hand"
                                        FontSize="12" Padding="0" Visibility="{x:Static local:Osk.CallVisibility}"
                                        ToolTip="螢幕虛擬鍵盤" Foreground="#EBF3FF" Background="#1A2C49"
                                        BorderThickness="0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="OnInputLoaded" />
            <EventSetter Event="Unloaded" Handler="OnInputUnloaded" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F0F4FA" />
            <Setter Property="Foreground" Value="#12233C" />
            <Setter Property="BorderBrush" Value="#2660AA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>
    </Application.Resources>
</Application>