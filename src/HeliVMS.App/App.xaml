<Application x:Class="HeliVMS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HeliVMS.App">
    <Application.Resources>
        <!-- 深色主題（BRAND.md 第 1 節 Design Tokens）-->
        <SolidColorBrush x:Key="Brand.BgDeep" Color="#0B1B2E" />
        <SolidColorBrush x:Key="Brand.BgPanel" Color="#12233C" />
        <SolidColorBrush x:Key="Brand.TextPrimary" Color="#EBF3FF" />
        <SolidColorBrush x:Key="Brand.TextDim" Color="#8296B4" />
        <SolidColorBrush x:Key="Brand.Accent" Color="#2660AA" />

        <!-- 全域深色元件樣式：修復視窗內未自訂屬性時的下拉選單／按鈕白底白字 -->
        <!-- 說明：各視窗若已在 XAML 本機設定 Foreground/Background，該值優先於樣式，不受影響。 -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#2660AA" />
            <Setter Property="BorderBrush" Value="#1D4C8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#1A2C49" />
            <Setter Property="BorderBrush" Value="#2A4A73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EBF3FF" />
            <Setter Property="Background" Value="#12233C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2660AA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4C8A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBF3FF" />
        </Style>
    </Application.Resources>
</Application>