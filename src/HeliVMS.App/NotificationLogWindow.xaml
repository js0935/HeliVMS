<Window x:Class="HeliVMS.App.NotificationLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliVMS 通知紀錄"
        Width="860" Height="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="NotificationLogWindow"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NotificationRefreshButton" Content="重新整理" Click="OnRefreshClicked"
                    Padding="10,4" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <TextBlock x:Name="NotificationCountText" Foreground="{StaticResource Brand.TextDim}"
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
            <ListView x:Name="NotificationLogList" AutomationProperties.AutomationId="NotificationLogList"
                      Background="Transparent" BorderThickness="0" Foreground="White">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="時間（本地）" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="頻道" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="事件" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EventType}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="通道" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Route}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="結果" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResultLabel}" FontSize="12" Foreground="{Binding ResultBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="嘗試" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AttemptsLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="說明" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" Text="通知送達紀錄（notification_log，§16.3）：成功與最終失敗事件，靜默時段跳過不記錄。"
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>