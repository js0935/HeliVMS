<Window x:Class="HeliVMS.App.NotificationLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="860" Height="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="NotificationLogWindow"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- No header bar: the labeled close button in this toolbar is the exit (Esc also works). -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            
            <Button x:Name="NotificationRefreshButton" Content="" Click="OnRefreshClicked" ToolTip=""
                    DockPanel.Dock="Left" MinWidth="88" Padding="12,6" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="NotificationRefreshButton"/>
            <TextBlock x:Name="NotificationCountText" Foreground="{StaticResource Brand.TextDim}"
                       VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
            <ListView x:Name="NotificationLogList" AutomationProperties.AutomationId="NotificationLogList"
                      Background="Transparent" BorderThickness="0" Foreground="White"
                      MouseDoubleClick="OnLogDoubleClick"
                      ToolTip="">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EventTypeLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RouteLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResultLabel}" FontSize="12" Foreground="{Binding ResultBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AttemptsLabel}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="NotificationLogFootnote" Grid.Row="2" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
    
        <!-- Unified close button: red X at the top-right corner. -->
        <Button x:Name="CloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="10,4" FontSize="14"
                    Foreground="White" Background="#C62828" BorderThickness="0"
                    AutomationProperties.AutomationId="NotificationCloseButton" IsCancel="True" />
</Grid>
</Window>
