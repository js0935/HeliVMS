<Window x:Class="HeliVMS.App.ShareWindow" FocusManager.FocusedElement="{Binding ElementName=SharePathBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ShareWindow"
        Title=""
        Width="800" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Create share -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="DescriptionText" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="PathLabelText" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="SharePathBox" AutomationProperties.AutomationId="SharePathBox"
                         Width="520" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="ShareBrowseButton" Content="" Click="OnBrowseClicked" ToolTip=""
                        Width="60" Margin="8,0,0,0" Padding="0,6"
                        Foreground="White" Background="#2A4A73" BorderThickness="0" AutomationProperties.AutomationId="ShareBrowseButton"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="KindLabelText" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="ShareKindCombo" AutomationProperties.AutomationId="ShareKindCombo"
                          Width="110" Margin="8,0,0,0" Foreground="Black"/>
                <TextBlock x:Name="LabelLabelText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="ShareLabelBox" AutomationProperties.AutomationId="ShareLabelBox" Width="140" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="ExpireLabelText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="ShareExpireBox" AutomationProperties.AutomationId="ShareExpireBox"
                         Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="MaxUsesLabelText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="ShareMaxUsesBox" AutomationProperties.AutomationId="ShareMaxUsesBox" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="PasswordLabelText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <PasswordBox x:Name="SharePasswordBox" AutomationProperties.AutomationId="SharePasswordBox" Width="110" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <Button x:Name="ShareCreateButton" AutomationProperties.AutomationId="ShareCreateButton" ToolTip=""
                        Content="" Click="OnCreateClicked"
                        Width="110" Padding="0,6" Margin="12,0,0,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ListHeaderText" Grid.Row="1" Text="" Margin="0,10,0,0"
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
        <ListView Grid.Row="2" x:Name="ShareList" AutomationProperties.AutomationId="ShareList"
                  Margin="0,6,0,0" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="44" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn x:Name="ShareColTitle" Header="" Width="250" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn x:Name="ShareColStatus" Header="" Width="150" DisplayMemberBinding="{Binding Detail}"/>
                    <GridViewColumn x:Name="ShareColUser" Header="" Width="110" DisplayMemberBinding="{Binding CreatedBy}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Action row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ShareRefreshButton" Content="" Click="OnRefreshClicked" ToolTip=""
                    Width="64" Padding="0,6" Foreground="White" Background="#2A4A73" BorderThickness="0" AutomationProperties.AutomationId="ShareRefreshButton"/>
            <Button x:Name="ShareCopyButton" AutomationProperties.AutomationId="ShareCopyButton" ToolTip=""
                    Content="" Click="OnCopyClicked"
                    Width="80" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
            <Button x:Name="ShareRevokeButton" AutomationProperties.AutomationId="ShareRevokeButton" ToolTip=""
                    Content="" Click="OnRevokeClicked"
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A5C2E" BorderThickness="0"/>
            <Button x:Name="ShareDeleteButton" Content="" Click="OnDeleteClicked" ToolTip=""
                    Width="64" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#8A3C2E" BorderThickness="0" AutomationProperties.AutomationId="ShareDeleteButton"/>
            <Button x:Name="SharePurgeButton" Content="" Click="OnPurgeClicked" ToolTip=""
                    Width="90" Padding="0,6" Margin="8,0,0,0"
                    Foreground="White" Background="#3A4A6A" BorderThickness="0" AutomationProperties.AutomationId="SharePurgeButton"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ShareStatusText" AutomationProperties.AutomationId="ShareStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
