<Window x:Class="HeliVMS.App.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="PosWindow"
        Title="HeliVMS POS 交易"
        Width="980" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="POS 交易與對帳（M93/M104/M113，§14.7 #8）：匯入去重、區間查詢、與警報事件時間窗對帳。"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="設備ID" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="PosDeviceBox" AutomationProperties.AutomationId="PosDeviceBox" Text="1"
                         Width="50" Margin="6,0,12,4" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock Text="收銀機" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="PosRegisterBox" AutomationProperties.AutomationId="PosRegisterBox"
                         Width="100" Margin="6,0,12,4" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock Text="起" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="PosFromDate" AutomationProperties.AutomationId="PosFromDate" Width="110" Margin="6,0,12,4"/>
                <TextBlock Text="迄" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="PosToDate" AutomationProperties.AutomationId="PosToDate" Width="110" Margin="6,0,12,4"/>
                <Button x:Name="PosQueryButton" AutomationProperties.AutomationId="PosQueryButton"
                        Content="查詢" Click="OnQueryClicked" Width="64" Padding="0,6" Margin="0,0,8,4"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="PosImportButton" AutomationProperties.AutomationId="PosImportButton"
                        Content="匯入 CSV" Click="OnImportClicked" Width="84" Padding="0,6" Margin="0,0,8,4"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"
                        ToolTip="CSV 每列：收銀機,交易號,金額,時間（可含表頭；同鍵於 2 分鐘窗內視為重複不新增）"/>
                <Button x:Name="PosReconcileButton" AutomationProperties.AutomationId="PosReconcileButton"
                        Content="對帳" Click="OnReconcileClicked" Width="64" Padding="0,6" Margin="0,0,0,4"
                        Foreground="White" Background="#5A3A5A" BorderThickness="0"
                        ToolTip="以同時段警報事件為候選，統計 matched/unmatched/duplicates"/>
            </WrapPanel>
        </StackPanel>

        <ListView x:Name="PosList" AutomationProperties.AutomationId="PosList"
                  Grid.Row="1" Margin="0,12,0,0"
                  Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時間" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Time}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="設備" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Device}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="收銀機" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Register}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="交易號" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding TransactionNo}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="金額" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Amount}" FontSize="12"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="PosStatusText" AutomationProperties.AutomationId="PosStatusText"
                       Foreground="#9FB8D8" TextWrapping="Wrap"/>
            <TextBlock x:Name="PosReconText" AutomationProperties.AutomationId="PosReconText"
                       Foreground="#C8D8F0" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
