<Window x:Class="HeliVMS.App.PtzWindow" FocusManager.FocusedElement="{Binding ElementName=PtzProfileCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="220" Height="340" MinWidth="200" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        AutomationProperties.AutomationId="PtzWindow"
        Background="{StaticResource Brand.BgDeep}" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PtzStatusText" Grid.Row="0" Text="" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Brand.TextPrimary}" Margin="2,0,2,6" />

        <ComboBox x:Name="PtzProfileCombo" Grid.Row="1" AutomationProperties.AutomationId="PtzProfileCombo"
                  Height="24" Margin="2,0,2,8" Foreground="White" Background="#1A2C49"
                  BorderBrush="#2A4A73" SelectionChanged="OnProfileChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="12" Foreground="White">
                        <Run Text="{Binding Name}" /><Run Text="（" /><Run Text="{Binding Token}" /><Run Text="）" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <UniformGrid Grid.Row="2" Columns="3">
            <Button x:Name="PtzUpLeftButton" AutomationProperties.AutomationId="PtzUpLeftButton"
                    Content="↖" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="-0.6,-0.6,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzUpButton" AutomationProperties.AutomationId="PtzUpButton"
                    Content="↑" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0,-0.8,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzUpRightButton" AutomationProperties.AutomationId="PtzUpRightButton"
                    Content="↗" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0.6,-0.6,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzLeftButton" AutomationProperties.AutomationId="PtzLeftButton"
                    Content="←" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="-0.8,0,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzStopButton" AutomationProperties.AutomationId="PtzStopButton"
                    Content="■" ToolTip="" Click="OnStopClicked"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#8A3C2E" BorderThickness="0" />
            <Button x:Name="PtzRightButton" AutomationProperties.AutomationId="PtzRightButton"
                    Content="→" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0.8,0,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzDownLeftButton" AutomationProperties.AutomationId="PtzDownLeftButton"
                    Content="↙" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="-0.6,0.6,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzDownButton" AutomationProperties.AutomationId="PtzDownButton"
                    Content="↓" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0,0.8,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzDownRightButton" AutomationProperties.AutomationId="PtzDownRightButton"
                    Content="↘" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0.6,0.6,0"
                    FontSize="13" Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
        </UniformGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="PtzZoomInButton" AutomationProperties.AutomationId="PtzZoomInButton"
                    Content="＋" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0,0,0.8"
                    FontSize="12" Padding="8,5" Margin="2" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
            <Button x:Name="PtzZoomOutButton" AutomationProperties.AutomationId="PtzZoomOutButton"
                    Content="－" ToolTip="" Click="OnMoveClicked" PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveMouseLeave" Tag="0,0,-0.8"
                    FontSize="12" Padding="8,5" Margin="2" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
            <Button x:Name="PtzHomeButton" AutomationProperties.AutomationId="PtzHomeButton" Content="H" ToolTip="" Click="OnHomeClicked" FontSize="12" Padding="8,5" Margin="2" Foreground="White" Background="#5A6A3A" BorderThickness="0" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="PtzPresetList" Grid.Column="0" AutomationProperties.AutomationId="PtzPresetList"
                      Height="26" Margin="0,0,4,0" VerticalContentAlignment="Center"
                      Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="White" Margin="2" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button x:Name="PtzSavePresetButton" Grid.Column="1" AutomationProperties.AutomationId="PtzSavePresetButton"
                    Content="＋" ToolTip="" Click="OnSavePresetClicked"
                    Width="28" Height="26" Margin="2,0" FontSize="13" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
            <Button x:Name="PtzGotoPresetButton" Grid.Column="2" AutomationProperties.AutomationId="PtzGotoPresetButton"
                    Content="▶" ToolTip="" Click="OnGotoPresetClicked"
                    Width="28" Height="26" Margin="2,0" FontSize="12" Foreground="White" Background="#2660AA" BorderThickness="0" />
            <Button x:Name="PtzDeletePresetButton" Grid.Column="3" AutomationProperties.AutomationId="PtzDeletePresetButton"
                    Content="✕" ToolTip="" Click="OnDeletePresetClicked"
                    Width="28" Height="26" Margin="2,0" FontSize="12" Foreground="White" Background="#8A3C2E" BorderThickness="0" />
        </Grid>

        <Button Grid.Row="5" x:Name="PtzCloseButton" Content="" ToolTip="" Click="OnCloseClicked"
                HorizontalAlignment="Right" Width="80" Height="26" Margin="2,10,2,0"
                FontSize="12" Foreground="White" Background="#333F55" BorderThickness="0" />
    </Grid>
</Window>