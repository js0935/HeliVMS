<Window x:Class="HeliVMS.App.PtzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PTZ 控制"
        Width="520" Height="470"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="PtzWindow"
        Background="{StaticResource Brand.BgDeep}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="PtzStatusText" Text="連線中…" TextWrapping="Wrap"
                       Foreground="{StaticResource Brand.TextPrimary}" FontSize="13" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="雲台移動" Foreground="{StaticResource Brand.TextDim}" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,6,0,0">
                    <Button x:Name="PtzUpLeftButton" AutomationProperties.AutomationId="PtzUpLeftButton"
                            Content="↖" Click="OnMoveClicked" Tag="-0.6,-0.6,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzUpButton" AutomationProperties.AutomationId="PtzUpButton"
                            Content="↑" Click="OnMoveClicked" Tag="0,-0.8,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzUpRightButton" AutomationProperties.AutomationId="PtzUpRightButton"
                            Content="↗" Click="OnMoveClicked" Tag="0.6,-0.6,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzLeftButton" AutomationProperties.AutomationId="PtzLeftButton"
                            Content="←" Click="OnMoveClicked" Tag="-0.8,0,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzStopButton" AutomationProperties.AutomationId="PtzStopButton"
                            Content="■" Click="OnStopClicked"
                            Padding="0,6" Margin="2" Foreground="White" Background="#8A3C2E" BorderThickness="0" />
                    <Button x:Name="PtzRightButton" AutomationProperties.AutomationId="PtzRightButton"
                            Content="→" Click="OnMoveClicked" Tag="0.8,0,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzDownLeftButton" AutomationProperties.AutomationId="PtzDownLeftButton"
                            Content="↙" Click="OnMoveClicked" Tag="-0.6,0.6,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzDownButton" AutomationProperties.AutomationId="PtzDownButton"
                            Content="↓" Click="OnMoveClicked" Tag="0,0.8,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="PtzDownRightButton" AutomationProperties.AutomationId="PtzDownRightButton"
                            Content="↘" Click="OnMoveClicked" Tag="0.6,0.6,0"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="0,6" Margin="2" Foreground="White" Background="#2660AA" BorderThickness="0" />
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PtzZoomInButton" AutomationProperties.AutomationId="PtzZoomInButton"
                            Content="＋變焦" Click="OnMoveClicked" Tag="0,0,0.8"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="14,6" Margin="2" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                    <Button x:Name="PtzZoomOutButton" AutomationProperties.AutomationId="PtzZoomOutButton"
                            Content="－變焦" Click="OnMoveClicked" Tag="0,0,-0.8"
                            PreviewMouseLeftButtonDown="OnMoveHeldDown" PreviewMouseLeftButtonUp="OnMoveHeldUp" MouseLeave="OnMoveHeldUp"
                            Padding="14,6" Margin="2" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                    <Button x:Name="PtzHomeButton" AutomationProperties.AutomationId="PtzHomeButton"
                            Content="回原點" Click="OnHomeClicked"
                            Padding="14,6" Margin="2" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
</Grid>
        <GroupBox Grid.Row="2" Header="預設點" Foreground="{StaticResource Brand.TextDim}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="PtzPresetNameBox" Width="140" ToolTip="預設點名稱"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />
                    <Button x:Name="PtzSavePresetButton" AutomationProperties.AutomationId="PtzSavePresetButton"
                            Content="儲存目前位置" Click="OnSavePresetClicked"
                            Margin="6,0,0,0" Padding="10,6" Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                    <Button x:Name="PtzRefreshButton" AutomationProperties.AutomationId="PtzRefreshButton"
                            Content="重新整理" Click="OnRefreshClicked"
                            Margin="6,0,0,0" Padding="10,6" Foreground="White" Background="#333F55" BorderThickness="0" />
                </StackPanel>

                <ListBox x:Name="PtzPresetList" Grid.Row="1" AutomationProperties.AutomationId="PtzPresetList"
                         Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" Margin="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="PtzGotoPresetButton" AutomationProperties.AutomationId="PtzGotoPresetButton"
                        Content="移至選取預設點" Click="OnGotoPresetClicked"
                        Padding="10,7" Foreground="White" Background="#2660AA" BorderThickness="0" />
                <Button x:Name="PtzDeletePresetButton" AutomationProperties.AutomationId="PtzDeletePresetButton"
                        Content="刪除選取預設點" Click="OnDeletePresetClicked"
                        Margin="6,0,0,0" Padding="10,7" Foreground="White" Background="#8A3C2E" BorderThickness="0" />
            </StackPanel>
        </Grid>

        <Button Grid.Row="3" Content="關閉" Click="OnCloseClicked"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="20,8"
                Foreground="White" Background="#333F55" BorderThickness="0" />
    </Grid>
</Window>
