<Window x:Class="HeliVMS.App.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="720" Height="480"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}"
        WindowStyle="None" ResizeMode="CanResize">
    <Border BorderBrush="#1F3A5F" BorderThickness="1">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A borderless window has no system title bar, so dragging is provided here. -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="" FontSize="15" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="" Foreground="{StaticResource Brand.TextDim}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="PlaybackButton" Content="" Click="OnPlaybackClicked" ToolTip=""
                            Padding="12,5" Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            VerticalAlignment="Center" AutomationProperties.AutomationId="LivePlaybackButton" />
                    <Button x:Name="CloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                            Padding="10,5" Margin="8,0,0,0" FontSize="13"
                            Foreground="White" Background="#C62828" BorderThickness="0"
                            VerticalAlignment="Center" AutomationProperties.AutomationId="LiveCloseButton" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="Black" BorderBrush="#1F3A5F" BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="PlaybackMenuItem" Click="OnPlaybackClicked"
                                  AutomationProperties.AutomationId="LivePlaybackMenuItem" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Image x:Name="FrameImage" Stretch="Uniform" Visibility="Collapsed"
                           AutomationProperties.AutomationId="LiveFrameImage" />

                    <Border x:Name="OverlayStatus" Background="#B3000000" CornerRadius="6"
                            Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="" Foreground="White" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock x:Name="FooterText" Grid.Row="2" Margin="0,6,0,0" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="10" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
