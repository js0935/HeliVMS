<Window x:Class="HeliVMS.App.MapWindow" FocusManager.FocusedElement="{Binding ElementName=MapCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="1100" Height="720"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="MapFloorLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="12" />
            <ComboBox x:Name="MapCombo" AutomationProperties.AutomationId="MapCombo" Width="260"
                      Margin="8,0,10,0" SelectionChanged="OnMapComboChanged"
                      Foreground="White" Background="#14243F" BorderBrush="#2A4A73" Padding="6,3" />
            <Button x:Name="MapRefreshButton" Content="" Click="OnRefreshClicked" ToolTip="" Padding="10,4"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="MapRefreshButton"/>
            <TextBlock x:Name="MapScaleText" AutomationProperties.AutomationId="MapScaleText"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="12" />
            <TextBlock x:Name="MapStatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="12" />
        </DockPanel>

        <Border Grid.Row="1" Background="#080F1A" BorderBrush="#1F3A5F" BorderThickness="1">
            <ScrollViewer x:Name="MapScroll" AutomationProperties.AutomationId="MapScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnScrollWheel" PanningMode="None">
                <Border x:Name="MapHost" Background="#080F1A">
                    <Canvas x:Name="MapCanvas" AutomationProperties.AutomationId="MapCanvas">
                        <Image x:Name="MapImage" Stretch="None" />
                    </Canvas>
                </Border>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="MapHintText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                   Text="" />
    </Grid>
</Window>