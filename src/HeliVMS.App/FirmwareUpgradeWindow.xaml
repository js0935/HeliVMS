<Window x:Class="HeliVMS.App.FirmwareUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Firmware Upgrade"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#1E2733" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="FirmwareHeader" Text="" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="FirmwareDesc" Text="" Foreground="#A9B7C6" Margin="0,4,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FileLabel" Grid.Column="0" Text="" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="FileText" Grid.Column="1" IsReadOnly="True" Background="#101822" Foreground="#C7D2E0"
                     BorderBrush="#2A4A73" BorderThickness="1" Padding="6,4" VerticalAlignment="Center"/>
            <Button x:Name="PickFirmwareButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,5" Click="OnPickFirmwareClicked"
                    Content="" Foreground="White" Background="#2A4A73" BorderThickness="0" ToolTip=""/>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="CheckButton" Padding="14,5" Click="OnCheckClicked" Margin="0,0,6,0"
                    Content="" Foreground="White" Background="#2A4A73" BorderThickness="0" ToolTip=""/>
            <Button x:Name="UpgradeButton" Padding="14,5" Click="OnUpgradeClicked" Margin="0,0,6,0"
                    Content="" Foreground="White" Background="#8A3C2E" BorderThickness="0" ToolTip=""/>
            <CheckBox x:Name="RebootAfterCheck" Margin="6,0,12,0" VerticalAlignment="Center"
                      Foreground="White" Content=""/>
            <Button x:Name="RefreshButton" Padding="14,5" Click="OnRefreshClicked" Margin="0,0,6,0"
                    Content="" Foreground="White" Background="#2A4A73" BorderThickness="0" ToolTip=""/>
            <Button x:Name="CloseButton" Padding="14,5" Click="OnCloseClicked"
                    Content="" Foreground="White" Background="#3E4C5E" BorderThickness="0" ToolTip=""/>
        </WrapPanel>

        <ListView Grid.Row="3" x:Name="DeviceList" Background="#101822" Foreground="#C7D2E0" BorderBrush="#2A4A73"
                  BorderThickness="1" Padding="2" SelectionMode="Single">
            <ListView.View>
                <GridView x:Name="DeviceGridView">
                    <GridViewColumn x:Name="ColSelect" Width="46">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColName" Header="" Width="190" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn x:Name="ColAddress" Header="" Width="210" DisplayMemberBinding="{Binding Address}"/>
                    <GridViewColumn x:Name="ColVersion" Header="" Width="150" DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn x:Name="ColResult" Header="" Width="200" DisplayMemberBinding="{Binding Result}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,10,0,0" Foreground="#A9B7C6" TextWrapping="Wrap"/>
    </Grid>
</Window>
