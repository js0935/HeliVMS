<Window x:Class="HeliVMS.App.OnvifWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONVIF 設備探索"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ONVIF 設備探索" Foreground="{StaticResource Brand.TextPrimary}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="自動探索本機網段的 ONVIF 攝影機；或指定 IP 直接連線。取得的 RTSP 串流可加入頻道清單。"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：探索參數 -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="指定位址（可留空）" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="AddressBox" ToolTip="設備 IP（如 192.168.1.64）；留空則自動探索"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                <TextBlock Text="帳號（可留空）" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,12,0,6" />
                <TextBox x:Name="UserBox"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                <TextBlock Text="密碼（可留空）" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,12,0,6" />
                <PasswordBox x:Name="PasswordBox"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                <Button x:Name="DiscoverButton" Content="探索 / 連線" Click="OnDiscoverClicked"
                        Margin="0,16,0,0" Padding="0,8"
                        Foreground="White" Background="#2660AA" BorderThickness="0" />

                <TextBlock x:Name="WizardHint" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,12,0,0"
                           Text="選取設備後自動擷取其影像串流設定。" />
            </StackPanel>

            <!-- 右：設備與 Profile -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="設備" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                    <ListBox x:Name="DeviceList" Grid.Row="1" SelectionChanged="OnDeviceSelected"
                             Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding NameHint}" FontSize="13" Foreground="White" />
                                    <TextBlock Text="{Binding HttpXAddr}" FontSize="11" Foreground="{StaticResource Brand.TextDim}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="影像 Profile（選取後加入）" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                    <ListBox x:Name="ProfileList" Grid.Row="1" SelectionChanged="OnProfileSelected"
                             Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" />
                                    <TextBlock Text="{Binding StreamUri}" FontSize="11" Foreground="{StaticResource Brand.TextDim}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AddButton" Content="加入頻道" Click="OnAddClicked"
                    Padding="16,8" Margin="0,0,10,0" IsEnabled="False"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" />
            <Button Content="關閉" Click="OnCloseClicked"
                    Padding="16,8" Foreground="White" Background="#333F55" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>