<Window x:Class="HeliVMS.App.OnvifWizardWindow" FocusManager.FocusedElement="{Binding ElementName=AddressBox}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Closed="OnWindowClosed"
        Background="{StaticResource Brand.BgDeep}" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" PreviewKeyDown="OnWindowKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="OnvifHeader" Text="" Foreground="{StaticResource Brand.TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="OnvifDesc" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: discovery parameters -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock x:Name="OnvifAddressLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="AddressBox" AutomationProperties.AutomationId="AddressBox" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />
                <TextBlock x:Name="OnvifAddressHint" Text="" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,4,0,0" />

                <TextBlock x:Name="OnvifUserLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,12,0,6" />
                <TextBox x:Name="UserBox" AutomationProperties.AutomationId="UserBox" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                <TextBlock x:Name="OnvifPasswordLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,12,0,6" />
                <PasswordBox x:Name="PasswordBox" AutomationProperties.AutomationId="PasswordBox" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                <Button x:Name="DiscoverButton" Content="" ToolTip="" Click="OnDiscoverClicked"
                        Margin="0,16,0,0" Padding="0,8"
                        Foreground="White" Background="#2660AA" BorderThickness="0" AutomationProperties.AutomationId="DiscoverButton"/>

                <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="#4C9AFF" Background="#1A2C49"
                             Margin="0,14,0,0" />

                <TextBlock x:Name="WizardHint" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,12,0,0"
                           Text="" />
            </StackPanel>

            <!-- Right: devices and profiles -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="SelectAllButton" Content="" Click="OnSelectAllClicked"
                                DockPanel.Dock="Right" Padding="10,2" Visibility="Collapsed"
                                Foreground="White" Background="#2A4A73" BorderThickness="0"
                                AutomationProperties.AutomationId="SelectAllButton" />
                        <TextBlock x:Name="OnvifDeviceLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12" />
                    </DockPanel>
                    <ListBox x:Name="DeviceList" Grid.Row="1" SelectionChanged="OnDeviceSelected"
                             Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Checkbox feeds batch enrollment; selecting the row still loads profiles for the single-camera flow. -->
                                <DockPanel Margin="2">
                                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="DeviceCheckBox" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameHint}" FontSize="13" Foreground="White" />
                                        <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{StaticResource Brand.TextDim}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="OnvifProfilesLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                    <ListBox x:Name="ProfileList" Grid.Row="1" SelectionChanged="OnProfileSelected"
                             Foreground="White" Background="#0B1626" BorderBrush="#2A4A73">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="13" Foreground="White" />
                                    <TextBlock Text="{Binding StreamUri}" FontSize="11" Foreground="{StaticResource Brand.TextDim}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="" ToolTip="" Click="OnCancelClicked"
                    Padding="16,8" Margin="0,0,10,0" IsEnabled="False"
                    Foreground="White" Background="#8A4B2A" BorderThickness="0" AutomationProperties.AutomationId="CancelButton"/>
            <Button x:Name="BatchAddButton" Content="" ToolTip="" Click="OnBatchAddClicked"
                    Padding="16,8" Margin="0,0,10,0" Visibility="Collapsed" IsEnabled="False"
                    Foreground="White" Background="#1F6B4A" BorderThickness="0" AutomationProperties.AutomationId="BatchAddButton"/>
            <Button x:Name="AddButton" Content="" ToolTip="" Click="OnAddClicked"
                    Padding="16,8" Margin="0,0,10,0" IsEnabled="False"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="AddButton"/>
            
        </StackPanel>
    
        <!-- Unified close button: red X at the top-right corner. -->
        <Button x:Name="CloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="10,4" FontSize="14"
                    Foreground="White" Background="#C62828" BorderThickness="0"
                    AutomationProperties.AutomationId="CloseButton" />
</Grid>
</Window>