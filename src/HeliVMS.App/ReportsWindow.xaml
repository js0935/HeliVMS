<Window x:Class="HeliVMS.App.ReportsWindow" FocusManager.FocusedElement="{Binding ElementName=ReportPeriodCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ReportsWindow"
        Title=""
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="PeriodLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="ReportPeriodCombo" AutomationProperties.AutomationId="ReportPeriodCombo"
                          Width="130" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Label"/>
                <Button x:Name="ReportRefreshButton" AutomationProperties.AutomationId="ReportRefreshButton" ToolTip=""
                        Content="" Click="OnRefreshClicked"
                        Width="92" Padding="0,6" Margin="14,0,0,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="ReportExportButton" AutomationProperties.AutomationId="ReportExportButton" ToolTip=""
                        Content="" Click="OnExportClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#3A6A5A" BorderThickness="0"/>
                <Button x:Name="ReportEmailButton" AutomationProperties.AutomationId="ReportEmailButton" ToolTip=""
                        Content="" Click="OnEmailClicked"
                        Width="92" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#6A5A3A" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="ReportScheduleCheck" AutomationProperties.AutomationId="ReportScheduleCheck"
                          Content="" Foreground="#C9D8E8" VerticalAlignment="Center"/>
                <ComboBox x:Name="ReportCadenceCombo" AutomationProperties.AutomationId="ReportCadenceCombo"
                          ToolTip="" Width="90" Margin="12,0,0,0" Foreground="Black" DisplayMemberPath="Label"/>
                <TextBlock x:Name="WeekdayLabel" Text="" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="ReportWeeklyDayCombo" AutomationProperties.AutomationId="ReportWeeklyDayCombo"
                          Width="90" Foreground="Black" DisplayMemberPath="Label"/>
                <TextBlock x:Name="TimeLabel" Text="" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="ReportScheduleTimeBox" AutomationProperties.AutomationId="ReportScheduleTimeBox"
                         ToolTip="" Width="60" Foreground="Black" Text="08:00"/>
                <Button x:Name="ReportScheduleSaveButton" AutomationProperties.AutomationId="ReportScheduleSaveButton"
                        ToolTip="" Content=""
                        Click="OnSaveScheduleClicked" Padding="10,6" Margin="12,0,0,0"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="ReportScheduleStatusText" AutomationProperties.AutomationId="ReportScheduleStatusText"
                       Margin="0,6,0,0" Foreground="#9FB8D8" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="RecordingLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="ReportRecordingText" AutomationProperties.AutomationId="ReportRecordingText"
                           Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>

                <TextBlock x:Name="DisconnectLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="ReportDisconnectText" AutomationProperties.AutomationId="ReportDisconnectText"
                           Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>

                <TextBlock x:Name="TrendLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,12,0,0"/>
                <Canvas x:Name="ReportTrendCanvas" AutomationProperties.AutomationId="ReportTrendCanvas"
                        Height="140" Margin="0,6,0,0" Background="#0E1B29"/>
                <TextBlock x:Name="ReportTrendText" AutomationProperties.AutomationId="ReportTrendText"
                           Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>

                <TextBlock x:Name="AiLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="ReportAiText" AutomationProperties.AutomationId="ReportAiText"
                           Margin="0,4,0,0" Foreground="#C9D8E8" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="ReportStatusText" AutomationProperties.AutomationId="ReportStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
