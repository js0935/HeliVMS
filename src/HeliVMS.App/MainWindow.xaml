<Window x:Class="HeliVMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeliVMS.App"
        mc:Ignorable="d"
        Title=""
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brand.BgDeep}"
        d:DesignHeight="800" d:DesignWidth="1280"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnWindowClosed">

    <Window.Resources>
        <!-- Consistent styles for the left rail of the main screen: section headers,
             field labels and tool buttons. Previously each button had its own inline
             background, which looked like a paint palette; they are now collapsed into
             local styles, and only primary / dangerous actions keep color emphasis. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#8A3C2E" />
            <Setter Property="BorderBrush" Value="#6A2E24" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand.TextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource Brand.BgPanel}" Padding="12,8" BorderBrush="#1F3A5F" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="HeliVMS" Foreground="{StaticResource Brand.TextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox x:Name="AiToggle" Grid.Column="2" Content="" Foreground="White" VerticalAlignment="Center" AutomationProperties.AutomationId="AiToggle" ToolTip=""
                          Margin="28,0,0,0" Checked="OnAiToggleChanged" Unchecked="OnAiToggleChanged"/>
                <!-- Split-layout selector lives in the top bar so the monitor wall gets the full
                     height of the content row; the status/hint line shares the same line. -->
                <Grid Grid.Column="3" Margin="28,0,24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LayoutHeader" Style="{StaticResource SectionHeader}" Text=""
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="LayoutCombo" AutomationProperties.AutomationId="LayoutCombo"
                                  SelectedIndex="0" SelectionChanged="OnLayoutChanged"
                                  Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4">
                            <ComboBoxItem x:Name="LayoutItemSingle" Content="" />
                            <ComboBoxItem x:Name="LayoutItem4" Content="" />
                            <ComboBoxItem x:Name="LayoutItem6" Content="" />
                            <ComboBoxItem x:Name="LayoutItem9" Content="" />
                            <ComboBoxItem x:Name="LayoutItem12" Content="" />
                            <ComboBoxItem x:Name="LayoutItem16" Content="" />
                            <ComboBoxItem x:Name="LayoutItem20" Content="" />
                            <ComboBoxItem x:Name="LayoutItem25" Content="" />
                            <ComboBoxItem x:Name="LayoutItem30" Content="" />
                            <ComboBoxItem x:Name="LayoutItem36" Content="" />
                            <ComboBoxItem x:Name="LayoutItem42" Content="" />
                            <ComboBoxItem x:Name="LayoutItem56" Content="" />
                            <ComboBoxItem x:Name="LayoutItem64" Content="" />
                            <!-- Undo the last camera reorder. Lives in the layout menu so "restore the
                                 order" sits with the control that changes the wall; disabled when there
                                 is nothing to restore (see UpdateUndoCellOrderButton). -->
                            <ComboBoxItem x:Name="LayoutItemUndo" AutomationProperties.AutomationId="LayoutItemUndo"
                                          Content="" IsEnabled="False" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="HintText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11" Text="" />
                </Grid>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Monitor entry points (events / playback / map) live up here; every other feature button is in the settings center. -->
                    <Button x:Name="HeaderEventButton" AutomationProperties.AutomationId="HeaderEventButton"
                            Content="" ToolTip="" Click="OnEventClicked"
                            VerticalAlignment="Center" Padding="12,4" Margin="0,0,8,0"
                            Foreground="White" Background="#6A5A2E" BorderThickness="0" />
                    <Button x:Name="HeaderPlaybackButton" AutomationProperties.AutomationId="HeaderPlaybackButton"
                            Content="" ToolTip="" Click="OnPlaybackClicked"
                            VerticalAlignment="Center" Padding="12,4" Margin="0,0,8,0"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                    <Button x:Name="MapButton" AutomationProperties.AutomationId="MapButton"
                            Content="" ToolTip="" Click="OnMapClicked"
                            VerticalAlignment="Center" Padding="12,4" Margin="0,0,8,0"
                            Foreground="White" Background="#2F6E5A" BorderThickness="0" />
                    <ToggleButton x:Name="WallSequenceToggle" AutomationProperties.AutomationId="WallSequenceToggle"
                                  Content="" ToolTip="" Click="OnWallSequenceToggled"
                                  VerticalAlignment="Center" Padding="12,4" Margin="0,0,8,0"
                                  Foreground="White" Background="#3F5A8A" BorderThickness="0" />
                    <Button x:Name="HeaderSettingsButton" AutomationProperties.AutomationId="HeaderSettingsButton"
                            Content="" ToolTip="" Click="OnSettingsClicked"
                            VerticalAlignment="Center" Padding="12,4"
                            Foreground="White" Background="#2660AA" BorderThickness="0" />
                    <Button x:Name="HeaderExitButton" AutomationProperties.AutomationId="HeaderExitButton"
                            Content="" ToolTip="" Click="OnExitClicked"
                            VerticalAlignment="Center" Padding="12,4" Margin="8,0,0,0"
                            Foreground="White" Background="#8A3C2E" BorderThickness="0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ExitButtonContextMenu">
                                <MenuItem x:Name="ExitFullScreenMenuItem" Header="" Click="OnToggleFullScreenClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- License expiry banner (M211 / section 19.4 "UI banner reminder 14 days before expiry").
             Collapsed by default; only shown when Evaluate() decides a reminder is due. An
             unimported license is not shown here (the settings center already explains it). -->
        <Border x:Name="LicenseBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#4A3A10" BorderBrush="#C89B3C" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LicenseBannerText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#F5D78E" TextWrapping="Wrap" Text=""
                           AutomationProperties.AutomationId="LicenseBannerText" />
                <Button Grid.Column="1" x:Name="LicenseBannerAction" Content=""
                        Click="OnLicenseBannerActionClicked" VerticalAlignment="Center" Margin="12,0,0,0"
                        Foreground="#F5D78E" Background="#6B5418" BorderThickness="0" Padding="12,4"
                        AutomationProperties.AutomationId="LicenseBannerAction"
                        ToolTip="" />
            </Grid>
        </Border>

        <!-- Main area: the monitor wall fills the whole row. The split-layout selector and the
             status/hint line now live in the top bar, leaving as much height as possible for the
             video wall; the channel list and connect/record controls are gone (auto start). -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Monitor group tabs: the first tab is "All" and always shows every camera, the
                 remaining tabs are user-defined groups. Only the header strip is rendered here
                 (custom template with just a TabPanel); the shared wall below is not duplicated
                 per tab, so switching tabs just re-maps existing sessions to cells. -->
            <TabControl x:Name="GroupTabs" Grid.Row="0" Background="Transparent" BorderThickness="0"
                        Margin="0,0,0,8" SelectionChanged="OnGroupTabChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource Brand.TextDim}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBd" Background="#1A2C49" CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBd" Property="Background" Value="#2660AA" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
            </TabControl>

            <Border x:Name="MonitorArea" Grid.Row="1" Background="#06090F" BorderBrush="#1F3A5F" BorderThickness="1"
                    ClipToBounds="True" SizeChanged="OnMonitorAreaSizeChanged">
                <Grid>
                    <UniformGrid x:Name="CellGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                    </UniformGrid>

                    <Border x:Name="RecBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10" Padding="10,4" CornerRadius="3" Background="#B0352A" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="REC" Foreground="White" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar: live alert line + status + unacknowledged badge -->
        <Border Grid.Row="3" Background="{StaticResource Brand.BgPanel}" Padding="12,6" BorderBrush="#1F3A5F" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AlertText" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MouseLeftButtonUp="OnAlertTextClicked" Cursor="Hand"
                           Text="" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Notification backlog: hidden normally, shown persistently when the outbound
                         channel backs up. Without this indicator a dead webhook just silently piles
                         notifications up in memory, and the operator cannot tell "it never sent". -->
                    <Border x:Name="NotifyBacklogBadge" Background="#7A5A1E" CornerRadius="3"
                            Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="OnNotifyBacklogClicked"
                            ToolTip="">
                        <TextBlock x:Name="NotifyBacklogText" Foreground="White" FontSize="11" Text=""/>
                    </Border>
                    <Border x:Name="UnackBadge" Background="#6A2E2E" CornerRadius="3" Padding="8,2" Visibility="Collapsed"
                        Cursor="Hand" MouseLeftButtonUp="OnUnackBadgeClicked" ToolTip="">
                        <TextBlock x:Name="UnackText" Foreground="White" FontSize="11" Text=""/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource Brand.TextDim}"
                               FontSize="12" Margin="10,0,0,0"/>
                    <!-- Current date/time: updated by _uiTimer (every second); monospace avoids the
                         whole row shifting when the seconds tick. -->
                    <TextBlock x:Name="ClockText" AutomationProperties.AutomationId="ClockText"
                               Foreground="{StaticResource Brand.TextPrimary}"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0" Text=""/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
