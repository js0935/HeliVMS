<Window x:Class="HeliVMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeliVMS.App"
        mc:Ignorable="d"
        Title="HeliVMS"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brand.BgDeep}"
        d:DesignHeight="800" d:DesignWidth="1280"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnWindowClosed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂欄 -->
        <Border Grid.Row="0" Background="{StaticResource Brand.BgPanel}" Padding="12,8" BorderBrush="#1F3A5F" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderLogo" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="HeliVMS" Foreground="{StaticResource Brand.TextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox x:Name="AiToggle" Content="AI 疊加" Foreground="White" VerticalAlignment="Center"
                          Margin="28,0,0,0" Checked="OnAiToggleChanged" Unchecked="OnAiToggleChanged"/>
            </StackPanel>
        </Border>

        <!-- 主區 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 控制面板 -->
            <Border Grid.Column="0" Background="{StaticResource Brand.BgPanel}" BorderBrush="#1F3A5F" BorderThickness="0,0,1,0">
                <StackPanel Margin="16" VerticalAlignment="Top">
                    <TextBlock Text="佈局" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox x:Name="LayoutCombo" AutomationProperties.AutomationId="LayoutCombo"
                              SelectedIndex="0" SelectionChanged="OnLayoutChanged"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4">
                        <ComboBoxItem Content="單一畫面" />
                        <ComboBoxItem Content="2 × 2 四路" />
                        <ComboBoxItem Content="3 × 3 九路" />
                        <ComboBoxItem Content="4 × 4 十六路" />
                    </ComboBox>

                    <TextBlock Text="頻道" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,14,0,6" />
                    <ComboBox x:Name="ChannelCombo" SelectedIndex="0"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />

                    <TextBlock Text="串流位址" Foreground="{StaticResource Brand.TextDim}" FontSize="12" Margin="0,14,0,6" />
                    <TextBox x:Name="UrlBox"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                             Padding="8,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="NameBox" Width="80" ToolTip="頻道名稱"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" />
                        <Button x:Name="AddChannelButton" Content="＋加入頻道" Click="OnAddChannelClicked"
                                Margin="6,0,0,0" Padding="8,4"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                        <Button x:Name="OnvifButton" Content="ONVIF 探索" Click="OnOnvifClicked"
                                Margin="6,0,0,0" Padding="8,4"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton"
                                Content="連線" Click="OnConnectClicked"
                                Width="110" Padding="0,8" Margin="0,0,10,0"
                                Foreground="White" Background="#2660AA" BorderThickness="0" />
                        <Button x:Name="RecordButton" Content="錄影" Click="OnRecordClicked"
                                Width="100" Padding="0,8" IsEnabled="False"
                                Foreground="White" Background="#8A3C2E" BorderThickness="0" />
                        <Button x:Name="PlaybackButton" Content="回放" Click="OnPlaybackClicked"
                                Width="80" Padding="0,8" Margin="10,0,0,0"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                        <Button x:Name="EventButton" Content="事件" Click="OnEventClicked"
                                Width="80" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#6A5A2E" BorderThickness="0" />
                        <Button x:Name="ExportButton" Content="匯出" Click="OnExportClicked"
                                Width="60" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#5A4A2E" BorderThickness="0" />
                        <Button x:Name="ExportCenterButton" AutomationProperties.AutomationId="ExportCenterButton"
                                Content="匯出中心" Click="OnExportCenterClicked"
                                Width="80" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A6A5A" BorderThickness="0" />
                        <Button x:Name="NotificationButton" AutomationProperties.AutomationId="NotificationButton"
                                Content="通知" Click="OnNotificationClicked"
                                Width="60" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#2A7F6E" BorderThickness="0" />
                        <Button x:Name="ScheduleButton" Content="排程" Click="OnScheduleClicked"
                                Width="60" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A5A7A" BorderThickness="0" />
                        <Button x:Name="DetectionButton" Content="偵測" Click="OnDetectionClicked"
                                Width="60" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#4A4A7A" BorderThickness="0" />
                        <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton"
                                Content="設定" Click="OnSettingsClicked"
                                Width="60" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A3A5A" BorderThickness="0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AlarmButton" AutomationProperties.AutomationId="AlarmButton"
                                Content="警報" Click="OnAlarmManagerClicked"
                                Width="50" Padding="0,8" Margin="0,0,6,0"
                                Foreground="White" Background="#7A3A5A" BorderThickness="0" />
                        <Button x:Name="RedactionButton" AutomationProperties.AutomationId="RedactionButton"
                                Content="遮蔽" Click="OnRedactionClicked"
                                Width="50" Padding="0,8" Margin="0,0,6,0"
                                Foreground="White" Background="#6A4A2A" BorderThickness="0" />
                        <Button x:Name="DewarpButton" AutomationProperties.AutomationId="DewarpButton"
                                Content="矯正" Click="OnDewarpClicked"
                                Width="50" Padding="0,8" Margin="0,0,6,0"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0" />
                        <Button x:Name="PtzButton" AutomationProperties.AutomationId="PtzButton"
                                Content="PTZ" Click="OnPtzClicked"
                                Width="50" Padding="0,8" Margin="0,0,6,0"
                                Foreground="White" Background="#5A4A8A" BorderThickness="0" />
                        <Button x:Name="MapButton" AutomationProperties.AutomationId="MapButton"
                                Content="地圖" Click="OnMapClicked"
                                Width="50" Padding="0,8"
                                Foreground="White" Background="#2A7F6E" BorderThickness="0" />
                        <Button x:Name="ReportsButton" AutomationProperties.AutomationId="ReportsButton"
                                Content="報表" Click="OnReportsClicked"
                                Width="50" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#5A3A7A" BorderThickness="0" />
                        <Button x:Name="RulesButton" AutomationProperties.AutomationId="RulesButton"
                                Content="規則" Click="OnRulesClicked"
                                Width="50" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A5A7A" BorderThickness="0" />
                        <Button x:Name="SynopsisButton" AutomationProperties.AutomationId="SynopsisButton"
                                Content="摘要" Click="OnSynopsisClicked"
                                Width="50" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A5A7A" BorderThickness="0" />
                        <Button x:Name="LegalHoldButton" AutomationProperties.AutomationId="LegalHoldButton"
                                Content="保存鎖定" Click="OnLegalHoldClicked"
                                Width="70" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#7A5A3A" BorderThickness="0" />
                        <Button x:Name="PatrolButton" AutomationProperties.AutomationId="PatrolButton"
                                Content="巡航" Click="OnPatrolClicked"
                                Width="56" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#2A6A9A" BorderThickness="0" />
                        <Button x:Name="IoButton" AutomationProperties.AutomationId="IoButton"
                                Content="感測IO" Click="OnIoClicked"
                                Width="64" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#3A5A2A" BorderThickness="0" />
                        <Button x:Name="StreamButton" AutomationProperties.AutomationId="StreamButton"
                                Content="切流" Click="OnStreamClicked"
                                Width="56" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#5A3A6A" BorderThickness="0" />
                        <Button x:Name="AudioButton" AutomationProperties.AutomationId="AudioButton"
                                Content="音訊" Click="OnAudioClicked"
                                Width="56" Padding="0,8" Margin="6,0,0,0"
                                Foreground="White" Background="#6A5A2A" BorderThickness="0" />
                    </StackPanel>

                    <TextBlock x:Name="HintText" TextWrapping="Wrap"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,18,0,0"
                               Text="提示：請先以 Tools\TestStream\Start-TestStream.ps1 啟動虛擬 RTSP 測試流。" />
                </StackPanel>
            </Border>

            <!-- 監看區 -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Background="#06090F" BorderBrush="#1F3A5F" BorderThickness="1">
                    <Grid>
                        <UniformGrid x:Name="CellGrid">
                        </UniformGrid>

                        <Border x:Name="RecBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="10" Padding="10,4" CornerRadius="3" Background="#B0352A" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="REC" Foreground="White" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 頻道總覽側欄 -->
                <Border Grid.Column="1" Background="#0F1D2E" BorderBrush="#1F3A5F" BorderThickness="1,1,0,1" Margin="12,0,0,0">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="頻道總覽" AutomationProperties.Name="頻道總覽"
                                   Foreground="{StaticResource Brand.TextDim}"
                                   FontSize="11" Margin="2,0,0,6"/>
                        <TextBlock x:Name="OverviewHint" DockPanel.Dock="Bottom" Text="點選格子定位頻道 · 點列反選畫面格"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="10" Margin="2,6,0,0"
                                   TextWrapping="Wrap"/>
                        <ListView x:Name="OverviewList" AutomationProperties.AutomationId="OverviewList"
                                  SelectionChanged="OnOverviewSelection"
                                  Background="Transparent" BorderThickness="0" Foreground="White">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="頻道" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CellLabel}" FontSize="12"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="狀態" Width="86">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                           Foreground="{Binding StateBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="REC" Width="38">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RecLabel}" FontSize="11" Foreground="#FF6A5A"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="AI">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AiLabel}" FontSize="11" Foreground="#AAB8C8"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 底欄：即時警報列＋狀態＋未確認徽章 -->
        <Border Grid.Row="2" Background="{StaticResource Brand.BgPanel}" Padding="12,6" BorderBrush="#1F3A5F" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AlertText" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MouseLeftButtonUp="OnAlertTextClicked" Cursor="Hand"
                           Text="（即時警報：AI 偵測／離線／重連）"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="UnackBadge" Background="#6A2E2E" CornerRadius="3" Padding="8,2" Visibility="Collapsed">
                        <TextBlock x:Name="UnackText" Foreground="White" FontSize="11" Text=""/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="正在驗證授權…" Foreground="{StaticResource Brand.TextDim}"
                               FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>