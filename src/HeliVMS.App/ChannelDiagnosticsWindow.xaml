<Window x:Class="HeliVMS.App.ChannelDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="860" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brand.BgDeep}" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Verdict first: this row answers what most people opened the window to find out. -->
        <Border Grid.Row="0" x:Name="VerdictBorder" Padding="10,8" CornerRadius="3"
                BorderThickness="1" BorderBrush="#1F3A5F">
            <TextBlock x:Name="VerdictText" AutomationProperties.AutomationId="VerdictText"
                       TextWrapping="Wrap" FontSize="13" Foreground="White" Text="" />
        </Border>

        <TextBlock Grid.Row="1" x:Name="DetailText" AutomationProperties.AutomationId="DetailText"
                   Margin="0,10,0,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource Brand.TextDim}" Text="" />

        <GroupBox Grid.Row="2" Header="" Padding="8">
            <TextBox x:Name="LogText" AutomationProperties.AutomationId="LogText"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11.5"
                     Foreground="#C8D6E5" Background="#080F1A" BorderThickness="0"
                     VerticalAlignment="Stretch" Text="" />
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource Brand.TextDim}" Text="" />
            <Button x:Name="CopyButton" Content="" Click="OnCopyClicked" Padding="12,4"
                    DockPanel.Dock="Right" AutomationProperties.AutomationId="CopyButton"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" />
            <Button x:Name="CloseButton" Content="" Click="OnCloseClicked" Padding="12,4" Margin="0,0,8,0"
                    DockPanel.Dock="Right" AutomationProperties.AutomationId="CloseButton"
                    Foreground="White" Background="#2A4A73" BorderThickness="0" />
        </DockPanel>
    </Grid>
</Window>