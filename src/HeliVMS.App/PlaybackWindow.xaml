<Window x:Class="HeliVMS.App.PlaybackWindow" FocusManager.FocusedElement="{Binding ElementName=ChannelCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="980" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Picker row -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="PlaybackChannelLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="PlaybackChannelCombo" Width="170" Margin="6,0,0,0"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                          SelectionChanged="OnChannelSelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="PlaybackDateLabel" Text="" Foreground="{StaticResource Brand.TextDim}" VerticalAlignment="Center"/>
                <DatePicker x:Name="DatePick" AutomationProperties.AutomationId="DatePick" Width="130" Margin="6,0,0,0"
                            Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                            SelectedDateChanged="OnDateChanged"/>
            </StackPanel>

            <Button x:Name="LoadButton" Content="" Click="OnLoadClicked" ToolTip=""
                    Padding="10,4" VerticalAlignment="Center"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="PlaybackLoadButton"/>
            <Button x:Name="RedactExportButton" Content="" Click="OnRedactFromPlaybackClicked" ToolTip=""
                    Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"
                    Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="PlaybackRedactButton"/>
            <TextBlock x:Name="LoadHint" Foreground="{StaticResource Brand.TextDim}"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                       AutomationProperties.AutomationId="PlaybackHint"/>
        </StackPanel>

        <!-- Left: segment list -->
        <Border Grid.Row="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PlaybackSegmentsLabel" Text="" Foreground="{StaticResource Brand.TextDim}" Margin="8,6" FontSize="11"/>
                <TextBlock x:Name="PlaybackDayEventsLabel" Text="" Foreground="{StaticResource Brand.TextDim}" Grid.Row="2" Margin="8,12,8,4" FontSize="11"/>
                <ListView x:Name="SegmentList" AutomationProperties.AutomationId="SegmentList" Grid.Row="1"
                          SelectionChanged="OnSegmentSelected"
                          Background="Transparent" BorderThickness="0"
                          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="SegColStart" Header="" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="SegColDuration" Header="" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="SegColSize" Header="" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Day event details (M16) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,12,8,4">
                    <TextBlock x:Name="PlaybackDayEventsLabel2" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="EventCountText" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <ListView x:Name="EventList" Grid.Row="3"
                          SelectionChanged="OnEventSelected"
                          AutomationProperties.AutomationId="PlaybackEventList"
                          Background="Transparent" BorderThickness="0"
                          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="EvtColStart" Header="" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StartLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="EvtColType" Header="" Width="64">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="EvtColDetail" Header="" Width="Auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DetailLabel}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Center: player -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PlayerArea" Background="#05090E" SizeChanged="OnPlayerAreaSizeChanged">
                <Border x:Name="PlayerFrame" BorderBrush="#2A4A73" BorderThickness="1" Background="#05090E"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="PlayerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                        <TextBlock x:Name="EmptyHint" Text=""
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="13"/>
                        <Canvas x:Name="RedactOverlay" IsHitTestVisible="False" ClipToBounds="True"
                                AutomationProperties.AutomationId="PlaybackRedactOverlay"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Timeline band: all of the day's segments, AI/motion markers, and the play position -->
            <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="#2A4A73" BorderThickness="1"
                    Background="#0F1D2E" Height="48" MouseLeftButtonDown="OnBandClicked">
                <Canvas x:Name="BandCanvas" SizeChanged="OnBandSizeChanged"
                        AutomationProperties.AutomationId="PlaybackBand"/>
            </Border>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
                <Slider x:Name="SeekSlider" AutomationProperties.AutomationId="SeekSlider" Width="150" VerticalAlignment="Center" Minimum="0" Maximum="10000"
                        Foreground="#2A5C8A" IsMoveToPointEnabled="True"
                        Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted"/>
                <TextBlock x:Name="CoverageText" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="PlaybackCoverageText"/>
                <Button x:Name="PlayPauseButton" Content="" Click="OnPlayPauseClicked" ToolTip=""
                        Width="76" Padding="0,6" Margin="16,0,0,0" IsEnabled="False"
                        Foreground="White" Background="#2660AA" BorderThickness="0" AutomationProperties.AutomationId="PlaybackPlayPauseButton"/>
                <Button x:Name="StopButton" Content="" Click="OnStopClicked" ToolTip=""
                        Width="70" Padding="0,6" Margin="8,0,0,0" IsEnabled="False"
                        Foreground="White" Background="#8A3C2E" BorderThickness="0" AutomationProperties.AutomationId="PlaybackStopButton"/>
                <TextBlock x:Name="PlaybackSpeedLabel" Text="" Foreground="{StaticResource Brand.TextDim}"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="SpeedCombo" AutomationProperties.AutomationId="SpeedCombo" Width="64" SelectedIndex="0" VerticalAlignment="Center"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"
                          SelectionChanged="OnSpeedChanged">
                    <ComboBoxItem Content="0.5×"/>
                    <ComboBoxItem Content="1×"/>
                    <ComboBoxItem Content="2×"/>
                    <ComboBoxItem Content="4×"/>
                    <ComboBoxItem Content="8×"/>
                </ComboBox>
                <TextBlock x:Name="TimeText" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0" Text="--:--:-- / --:--:--"
                           AutomationProperties.AutomationId="PlaybackTime"/>
                <CheckBox x:Name="AutoAdvanceCheck" Content="" Foreground="{StaticResource Brand.TextDim}" AutomationProperties.AutomationId="AutoAdvanceCheck" ToolTip=""
                          IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <CheckBox x:Name="RedactionOverlayCheck" Content="" Foreground="{StaticResource Brand.TextDim}"
                          AutomationProperties.AutomationId="RedactionOverlayCheck" ToolTip=""
                          IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"
                          Checked="OnRedactionOverlayToggled" Unchecked="OnRedactionOverlayToggled"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
