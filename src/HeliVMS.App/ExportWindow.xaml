<Window x:Class="HeliVMS.App.ExportWindow" FocusManager.FocusedElement="{Binding ElementName=StartTime}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ExportWindow"
        Title=""
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Closing="OnClosing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- Channel -->
            <TextBlock x:Name="ExportChannelLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="ChannelCombo"
                      Width="280" Margin="0,4,0,12"
                      Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>

            <!-- Time range -->
            <TextBlock x:Name="ExportRangeLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <DatePicker x:Name="StartDate" AutomationProperties.AutomationId="StartDate"
                            Width="140" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBox x:Name="StartTime" AutomationProperties.AutomationId="ExportStartTime" Width="70" Margin="6,0,0,0"
                         Text="00:00:00" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock Text=" ～ " VerticalAlignment="Center" Margin="6,0"/>
                <DatePicker x:Name="EndDate" AutomationProperties.AutomationId="EndDate"
                            Width="140" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBox x:Name="EndTime" AutomationProperties.AutomationId="ExportEndTime" Width="70" Margin="6,0,0,0"
                         Text="23:59:59" VerticalContentAlignment="Center"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
            </StackPanel>

            <!-- Output folder -->
            <TextBlock x:Name="ExportOutputFolderLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <DockPanel Margin="0,4,0,12">
                <Button x:Name="BrowseButton" Content="" Click="OnBrowseClicked" ToolTip=""
                        DockPanel.Dock="Right" Padding="12,6" Margin="6,0,0,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="BrowseButton"/>
                <TextBox x:Name="OutputFolderBox" AutomationProperties.AutomationId="OutputFolderBox"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
            </DockPanel>

            <!-- Watermark -->
            <TextBlock x:Name="ExportWatermarkLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <TextBox x:Name="WatermarkBox" AutomationProperties.AutomationId="WatermarkBox"
                     Width="320" Margin="0,4,0,12"
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>

            <!-- SHA-256 -->
            <CheckBox x:Name="HashCheckBox" AutomationProperties.AutomationId="HashCheckBox"
                      Content=""
                      IsChecked="True" Foreground="White" Margin="0,0,0,8"/>

            <!-- Apply stored redaction regions -->
            <CheckBox x:Name="ApplyRedactionCheckBox" AutomationProperties.AutomationId="ApplyRedactionCheckBox"
                      Content=""
                      IsChecked="False" Foreground="White" Margin="0,0,0,8"/>

            <!-- Evidence bundle -->
            <CheckBox x:Name="BundleCheckBox" AutomationProperties.AutomationId="BundleCheckBox"
                      Content=""
                      IsChecked="False" Foreground="White" Margin="0,0,0,4"/>
            <StackPanel Margin="22,0,0,8"
                        IsEnabled="{Binding ElementName=BundleCheckBox, Path=IsChecked}">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="ExportBundlePasswordLabel" Text="" DockPanel.Dock="Left"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="BundlePasswordBox" AutomationProperties.AutomationId="BundlePasswordBox"
                                 Width="180" HorizontalAlignment="Right"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="ExportBundleExpiryLabel" Text="" DockPanel.Dock="Left"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="BundleExpiryBox" AutomationProperties.AutomationId="BundleExpiryBox"
                             Width="120" HorizontalAlignment="Right"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,2"/>
                </DockPanel>
            </StackPanel>

            <!-- Status -->
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="ResultText"
                       Foreground="#56C886" FontSize="11"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <ProgressBar x:Name="ExportProgress" AutomationProperties.AutomationId="ExportProgress"
                         Height="18" Minimum="0" Maximum="100" Value="0"
                         Foreground="#2660AA" Background="#12233C" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" ToolTip=""
                        Content="" Click="OnExportClicked" IsDefault="True"
                        Width="100" Padding="0,8"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                <Button x:Name="OpenFolderButton" AutomationProperties.AutomationId="OpenFolderButton"
                        Content="" Click="OnOpenFolderClicked" ToolTip=""
                        Width="100" Padding="0,8" Margin="8,0,0,0" IsEnabled="False"
                        Foreground="White" Background="#2A7F6E" BorderThickness="0"/>
                <Button x:Name="CloseButton" Content="" Click="OnCloseClicked" ToolTip="" IsCancel="True"
                        Width="80" Padding="0,8" Margin="8,0,0,0"
                        Foreground="White" Background="#3A3A5A" BorderThickness="0" AutomationProperties.AutomationId="CloseButton"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
