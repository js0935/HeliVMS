<Window x:Class="HeliVMS.App.ExportWindow" FocusManager.FocusedElement="{Binding ElementName=StartTime}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ExportWindow"
        Title=""
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header row: borderless window has no system title bar, so the title and the close
             button live here (same pattern as LiveWindow/EventCenterWindow). -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderTitle" Text="" FontSize="15" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="HeaderCloseButton" Content="✕" Click="OnCloseClicked" ToolTip=""
                    Grid.Column="1" Padding="10,4" FontSize="14"
                    Foreground="White" Background="#C62828" BorderThickness="0"
                    VerticalAlignment="Center" AutomationProperties.AutomationId="ExportHeaderCloseButton"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: export settings -->
            <Border Grid.Column="0" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
                <StackPanel Margin="16">
                    <TextBlock x:Name="ExportFormHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                               Margin="0,0,0,10"/>

                    <!-- Channel: stretch so long camera names are not clipped. -->
                    <TextBlock x:Name="ExportChannelLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="ChannelCombo"
                              Margin="0,4,0,12"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>

                    <!-- Time range: 2x2 grid (start/end, date/time) with fixed widths:
                         the date column used to be star-sized (huge) while the time box
                         was left at 72px, clipping "23:59:59". -->
                    <TextBlock x:Name="ExportRangeLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <Grid Margin="0,4,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ExportStartLabel" Text="" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="StartDate" AutomationProperties.AutomationId="StartDate"
                                    Grid.Row="0" Grid.Column="1" Margin="0,4,0,0" Width="150" HorizontalAlignment="Left"
                                    Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <TextBox x:Name="StartTime" AutomationProperties.AutomationId="ExportStartTime"
                                 Grid.Row="0" Grid.Column="2" Margin="6,4,0,0" Width="92" HorizontalAlignment="Left"
                                 Text="00:00:00" VerticalContentAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <TextBlock x:Name="ExportEndLabel" Text="" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="EndDate" AutomationProperties.AutomationId="EndDate"
                                    Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Width="150" HorizontalAlignment="Left"
                                    Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                        <TextBox x:Name="EndTime" AutomationProperties.AutomationId="ExportEndTime"
                                 Grid.Row="1" Grid.Column="2" Margin="6,8,0,0" Width="92" HorizontalAlignment="Left"
                                 Text="23:59:59" VerticalContentAlignment="Center"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    </Grid>

                    <!-- Output folder -->
                    <TextBlock x:Name="ExportOutputFolderLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                               Margin="0,12,0,0"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button x:Name="BrowseButton" Content="" Click="OnBrowseClicked" ToolTip=""
                                DockPanel.Dock="Right" Padding="12,6" Margin="6,0,0,0"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="BrowseButton"/>
                        <TextBox x:Name="OutputFolderBox" AutomationProperties.AutomationId="OutputFolderBox"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    </DockPanel>

                    <!-- Watermark: stretch so the optional text is fully visible while typing. -->
                    <TextBlock x:Name="ExportWatermarkLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <TextBox x:Name="WatermarkBox" AutomationProperties.AutomationId="WatermarkBox"
                             Margin="0,4,0,12"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>

                    <!-- SHA-256 -->
                    <CheckBox x:Name="HashCheckBox" AutomationProperties.AutomationId="HashCheckBox"
                              Content=""
                              IsChecked="True" Foreground="White" Margin="0,0,0,8"/>

                    <!-- Apply stored redaction regions -->
                    <CheckBox x:Name="ApplyRedactionCheckBox" AutomationProperties.AutomationId="ApplyRedactionCheckBox"
                              Content=""
                              IsChecked="False" Foreground="White" Margin="0,0,0,8"/>

                    <!-- Evidence bundle -->
                    <CheckBox x:Name="BundleCheckBox" AutomationProperties.AutomationId="BundleCheckBox"
                              Content=""
                              IsChecked="False" Foreground="White" Margin="0,0,0,4"/>
                    <StackPanel Margin="22,0,0,8"
                                IsEnabled="{Binding ElementName=BundleCheckBox, Path=IsChecked}">
                        <TextBlock x:Name="ExportBundlePasswordLabel" Text=""
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <PasswordBox x:Name="BundlePasswordBox" AutomationProperties.AutomationId="BundlePasswordBox"
                                     Margin="0,4,0,8"
                                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,2"/>
                        <TextBlock x:Name="ExportBundleExpiryLabel" Text=""
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="BundleExpiryBox" AutomationProperties.AutomationId="BundleExpiryBox"
                                 Margin="0,4,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right: progress, status and result -->
            <Border Grid.Column="2" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ExportStatusHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                               Margin="0,0,0,10"/>

                    <ProgressBar x:Name="ExportProgress" AutomationProperties.AutomationId="ExportProgress"
                                 Grid.Row="1"
                                 Height="18" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#2660AA" Background="#12233C" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="ResultText"
                                   Foreground="#56C886" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" ToolTip=""
                                Content="" Click="OnExportClicked" IsDefault="True"
                                Width="120" Padding="0,8"
                                Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                        <Button x:Name="OpenFolderButton" AutomationProperties.AutomationId="OpenFolderButton"
                                Content="" Click="OnOpenFolderClicked" ToolTip=""
                                Width="120" Padding="0,8" Margin="8,0,0,0" IsEnabled="False"
                                Foreground="White" Background="#2A7F6E" BorderThickness="0"/>
                        <Button x:Name="CloseButton" Content="" Click="OnCloseClicked" ToolTip="" IsCancel="True"
                                Width="100" Padding="0,8" Margin="8,0,0,0"
                                Foreground="White" Background="#3A3A5A" BorderThickness="0" AutomationProperties.AutomationId="CloseButton"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
