<Window x:Class="HeliVMS.App.SchedulingWindow" FocusManager.FocusedElement="{Binding ElementName=ChannelCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="980" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: schedule form -->
        <Border BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E" Margin="0,0,10,0">
            <StackPanel Margin="14">
                <TextBlock x:Name="ScheduleFormHeader" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="ScheduleChannelLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="ChannelCombo" AutomationProperties.AutomationId="SchedulingChannelCombo" Margin="0,4,0,10"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>

                <TextBlock x:Name="ScheduleWeekdayLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <StackPanel Margin="0,4,0,10">
                    <UniformGrid Columns="4">
                        <CheckBox x:Name="SunBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="SunBox" ToolTip=""/>
                        <CheckBox x:Name="MonBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="MonBox" ToolTip=""/>
                        <CheckBox x:Name="TueBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="TueBox" ToolTip=""/>
                        <CheckBox x:Name="WedBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="WedBox" ToolTip=""/>
                        <CheckBox x:Name="ThuBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="ThuBox" ToolTip=""/>
                        <CheckBox x:Name="FriBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="FriBox" ToolTip=""/>
                        <CheckBox x:Name="SatBox" Content="" Foreground="White" Margin="0,2" AutomationProperties.AutomationId="SatBox" ToolTip=""/>
                    </UniformGrid>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ScheduleStartLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="StartBox" AutomationProperties.AutomationId="StartBox" Text="00:00" Margin="0,4,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ScheduleEndLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="EndBox" AutomationProperties.AutomationId="EndBox" Text="00:00" Margin="0,4,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="EnabledBox" Content="" Foreground="White" IsChecked="True" Margin="0,10,0,0" AutomationProperties.AutomationId="EnabledBox" ToolTip=""/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="AddButton" Content="" Click="OnAddClicked" ToolTip=""
                            Padding="14,6" Foreground="White" Background="#2A5C8A" BorderThickness="0" Width="120" AutomationProperties.AutomationId="AddButton"/>
                    <Button x:Name="UpdateButton" Content="" Click="OnUpdateClicked" ToolTip=""
                            Padding="14,6" Margin="8,0,0,0" IsEnabled="False"
                            Foreground="White" Background="#5A7A4A" BorderThickness="0" Width="90" AutomationProperties.AutomationId="UpdateButton"/>
                    <Button x:Name="ClearButton" Content="" Click="OnClearClicked" ToolTip=""
                            Padding="14,6" Margin="8,0,0,0"
                            Foreground="White" Background="#3A3A4A" BorderThickness="0" Width="70" AutomationProperties.AutomationId="ClearButton"/>
                </StackPanel>

                <TextBlock x:Name="HintText" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Text=""/>
            </StackPanel>
        </Border>

        <!-- Right: schedule list -->
        <Border Grid.Column="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ScheduleListHeader" Text="" Foreground="{StaticResource Brand.TextDim}"
                           Margin="8,6" FontSize="11"/>
                <ListView x:Name="ScheduleList" AutomationProperties.AutomationId="ScheduleList" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                          Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="ScheduleColChannel" Header="" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ScheduleColDays" Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ScheduleColTime" Header="" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ScheduleColState" Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="ToggleButton" Content="" Click="OnToggleClicked" ToolTip="" IsEnabled="False"
                            Padding="10,4" Foreground="White" Background="#5A4A2A" BorderThickness="0" AutomationProperties.AutomationId="ToggleButton"/>
                    <Button x:Name="DeleteButton" Content="" Click="OnDeleteClicked" ToolTip="" IsEnabled="False"
                            Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#8A3C2E" BorderThickness="0" AutomationProperties.AutomationId="DeleteButton"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
