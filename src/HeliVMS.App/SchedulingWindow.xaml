<Window x:Class="HeliVMS.App.SchedulingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliVMS 錄影排程"
        Width="980" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White"
        Loaded="OnLoaded" Closing="OnClosing">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：排程表單 -->
        <Border BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E" Margin="0,0,10,0">
            <StackPanel Margin="14">
                <TextBlock Text="新增／編輯排程" Foreground="{StaticResource Brand.TextDim}" FontSize="12"
                           Margin="0,0,0,10"/>

                <TextBlock Text="頻道" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="ChannelCombo" Margin="0,4,0,10"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>

                <TextBlock Text="星期" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <StackPanel Margin="0,4,0,10">
                    <UniformGrid Columns="4">
                        <CheckBox x:Name="SunBox" Content="日" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="MonBox" Content="一" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="TueBox" Content="二" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="WedBox" Content="三" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ThuBox" Content="四" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="FriBox" Content="五" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="SatBox" Content="六" Foreground="White" Margin="0,2"/>
                    </UniformGrid>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="開始（HH:mm）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="StartBox" Text="00:00" Margin="0,4,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="結束（HH:mm）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="EndBox" Text="00:00" Margin="0,4,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="EnabledBox" Content="啟用此排程" Foreground="White" IsChecked="True" Margin="0,10,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="AddButton" Content="新增排程" Click="OnAddClicked"
                            Padding="14,6" Foreground="White" Background="#2A5C8A" BorderThickness="0" Width="120"/>
                    <Button x:Name="UpdateButton" Content="更新" Click="OnUpdateClicked"
                            Padding="14,6" Margin="8,0,0,0" IsEnabled="False"
                            Foreground="White" Background="#5A7A4A" BorderThickness="0" Width="90"/>
                    <Button x:Name="ClearButton" Content="清除" Click="OnClearClicked"
                            Padding="14,6" Margin="8,0,0,0"
                            Foreground="White" Background="#3A3A4A" BorderThickness="0" Width="70"/>
                </StackPanel>

                <TextBlock x:Name="HintText" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="結束早於開始表示跨越午夜。尚未勾選任何星期時預設為每天。"/>
            </StackPanel>
        </Border>

        <!-- 右：排程清單 -->
        <Border Grid.Column="1" BorderBrush="#2A4A73" BorderThickness="1" Background="#0F1D2E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="排程清單（服務每 30 秒檢查一次）" Foreground="{StaticResource Brand.TextDim}"
                           Margin="8,6" FontSize="11"/>
                <ListView x:Name="ScheduleList" Grid.Row="1" SelectionChanged="OnSelectionChanged"
                          Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="頻道" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChannelName}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="星期" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="時段（本地）" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="狀態" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12"
                                                   Foreground="{Binding StateBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="8">
                    <Button x:Name="ToggleButton" Content="切換啟用" Click="OnToggleClicked" IsEnabled="False"
                            Padding="10,4" Foreground="White" Background="#5A4A2A" BorderThickness="0"/>
                    <Button x:Name="DeleteButton" Content="刪除排程" Click="OnDeleteClicked" IsEnabled="False"
                            Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>