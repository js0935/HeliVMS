<Window x:Class="HeliVMS.App.CameraManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="620" Width="900"
        Background="{StaticResource Brand.BgDeep}" Foreground="White"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="CameraHeader" Text="" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="CameraDesc" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,4,0,12"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="OnvifWizardButton" AutomationProperties.AutomationId="OnvifWizardButton"
                        Content="" Click="OnOnvifWizardClicked" Padding="10,5"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"
                        ToolTip=""/>
                <Button x:Name="RefreshDevicesButton" AutomationProperties.AutomationId="RefreshDevicesButton"
                        Content="" Click="OnRefreshDevicesClicked" Margin="6,0,0,0" Padding="10,5"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"
                        ToolTip=""/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" AutomationProperties.AutomationId="CameraManagerCloseButton"
                    Content="" Click="OnCloseClicked" Padding="16,6"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
        </StackPanel>

        <!-- Device groups / zones (section 7.4). Left panel: the group tree (group -> device ->
             channel). The tree is built in code-behind from explicit TreeViewItem nodes
             (deliberately no HierarchicalDataTemplate) so node identity and drag/drop stay
             simple: each item's Tag carries what it represents. -->
        <StackPanel DockPanel.Dock="Left" Width="250" Margin="0,0,12,0">
            <TextBlock x:Name="DeviceGroupHeader" Text="" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="DeviceGroupDesc" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,4,0,8"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="DeviceGroupNameLabel" Text="" VerticalAlignment="Center"
                       Foreground="White" FontSize="12"/>
            <TextBox x:Name="DeviceGroupNameBox" AutomationProperties.AutomationId="DeviceGroupNameBox"
                     Margin="0,4,0,6" ToolTip=""
                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
            <WrapPanel Margin="0,0,0,6">
                <Button x:Name="AddDeviceGroupButton" AutomationProperties.AutomationId="AddDeviceGroupButton"
                        Content="" Click="OnAddDeviceGroupClicked" Padding="8,5"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip=""/>
                <Button x:Name="RenameDeviceGroupButton" AutomationProperties.AutomationId="RenameDeviceGroupButton"
                        Content="" Click="OnRenameDeviceGroupClicked" Margin="6,0,0,0" Padding="8,5"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
                <Button x:Name="DeleteDeviceGroupButton" AutomationProperties.AutomationId="DeleteDeviceGroupButton"
                        Content="" Click="OnDeleteDeviceGroupClicked" Margin="6,0,0,0" Padding="8,5"
                        Foreground="White" Background="#8A3C2E" BorderThickness="0" ToolTip=""/>
            </WrapPanel>
            <Button x:Name="AssignDeviceToGroupButton" AutomationProperties.AutomationId="AssignDeviceToGroupButton"
                    Content="" Click="OnAssignDeviceToGroupClicked" Margin="0,0,0,8" Padding="8,5"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0" ToolTip=""/>
            <TreeView x:Name="DeviceTree" AutomationProperties.AutomationId="DeviceTree"
                      Height="330" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                      AllowDrop="True"
                      SelectedItemChanged="OnDeviceTreeNodeSelected"
                      PreviewMouseLeftButtonDown="OnDeviceTreeMouseDown"
                      MouseMove="OnDeviceTreeMouseMove"
                      DragOver="OnDeviceTreeDragOver"
                      Drop="OnDeviceTreeDrop"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock x:Name="DeviceGroupHintText" AutomationProperties.AutomationId="DeviceGroupHintText"
                       Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel>
            <ListView x:Name="DeviceList" AutomationProperties.AutomationId="DeviceList"
                      Height="150" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                      SelectionChanged="OnDeviceSelected"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="46"
                                        DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn x:Name="CameraColName" Header="" Width="150"
                                        DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn x:Name="CameraColAddress" Header="" Width="150"
                                        DisplayMemberBinding="{Binding IpPort}"/>
                        <GridViewColumn x:Name="CameraColVendor" Header="" Width="70"
                                        DisplayMemberBinding="{Binding Vendor}"/>
                        <GridViewColumn x:Name="CameraColCredential" Header="" Width="150"
                                        DisplayMemberBinding="{Binding CredentialLabel}"/>
                        <GridViewColumn x:Name="CameraColMainStream" Header="" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MainStreamUrl}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Live connection state, derived from the device's channel sessions and
                             refreshed by a timer in the code-behind (Online / Connecting / Offline).
                             Foreground is bound to a status-derived brush so the colour does not
                             depend on the localised text. -->
                        <GridViewColumn x:Name="CameraColStatus" Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Edit / add -->
            <TextBlock x:Name="CameraSettingsHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,14,0,6"/>
            <TextBlock x:Name="DeviceHintText" AutomationProperties.AutomationId="DeviceHintText"
                       Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <WrapPanel>
                <TextBlock x:Name="CameraNameLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DeviceNameBox" AutomationProperties.AutomationId="DeviceNameBox"
                         Width="150" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock Text="IP" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DeviceIpBox" AutomationProperties.AutomationId="DeviceIpBox"
                         Width="130" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="CameraPortLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DevicePortBox" AutomationProperties.AutomationId="DevicePortBox"
                         Width="60" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="CameraUsernameLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DeviceUsernameBox" AutomationProperties.AutomationId="DeviceUsernameBox"
                         Width="120" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="CameraPasswordLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <PasswordBox x:Name="DevicePasswordBox" AutomationProperties.AutomationId="DevicePasswordBox"
                             Width="120" Margin="6,0,0,0" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock x:Name="CameraMainLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DeviceMainUrlBox" AutomationProperties.AutomationId="DeviceMainUrlBox"
                         Width="320" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="CameraSubLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="DeviceSubUrlBox" AutomationProperties.AutomationId="DeviceSubUrlBox"
                         Width="260" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <Button x:Name="SaveDeviceButton" AutomationProperties.AutomationId="SaveDeviceButton"
                        Content="" Click="OnSaveDeviceClicked" Padding="12,5"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"
                        ToolTip=""/>
                <Button x:Name="DeleteDeviceButton" AutomationProperties.AutomationId="DeleteDeviceButton"
                        Content="" Click="OnDeleteDeviceClicked" Margin="6,0,0,0" Padding="12,5"
                        Foreground="White" Background="#8A3C2E" BorderThickness="0"
                        ToolTip=""/>
                <Button x:Name="OpenDeviceToolsButton" AutomationProperties.AutomationId="OpenDeviceToolsButton"
                        Content="" Click="OnOpenDeviceToolsClicked" Margin="12,0,0,0" Padding="12,5"
                        Foreground="White" Background="#2A4A73" BorderThickness="0"
                        ToolTip=""/>
                <Button x:Name="BatchFirmwareButton" AutomationProperties.AutomationId="BatchFirmwareButton"
                        Content="" Click="OnBatchFirmwareClicked" Margin="6,0,0,0" Padding="12,5"
                        Foreground="White" Background="#6B4423" BorderThickness="0"
                        ToolTip=""/>
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
