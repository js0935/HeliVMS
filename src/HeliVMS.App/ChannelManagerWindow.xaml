<Window x:Class="HeliVMS.App.ChannelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="640" Width="940"
        Background="{StaticResource Brand.BgDeep}" Foreground="White"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ChannelHeader" Text="" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="ChannelDesc" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,4,0,12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" AutomationProperties.AutomationId="ChannelManagerCloseButton"
                    Content="" Click="OnCloseClicked" Padding="16,6"
                    Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
        </StackPanel>

        <StackPanel>
            <!-- Add channel -->
            <TextBlock x:Name="ChannelAddHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="ChannelSourceLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="DeviceSourceCombo" AutomationProperties.AutomationId="DeviceSourceCombo"
                          Width="240" Margin="6,0,12,0" ToolTip=""
                          SelectionChanged="OnDeviceSourceChanged"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                    <ComboBoxItem Content=""/>
                </ComboBox>
                <Button x:Name="OnvifWizardButton" AutomationProperties.AutomationId="OnvifWizardButton"
                        Content="" Click="OnOnvifWizardClicked" Padding="8,4"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"
                        ToolTip=""/>
                <Button x:Name="RefreshChannelsButton" AutomationProperties.AutomationId="RefreshChannelsButton"
                        Content="" Click="OnRefreshChannelsClicked" Margin="6,0,0,0" Padding="8,4"
                        Foreground="White" Background="#3A5A7A" BorderThickness="0"
                        ToolTip=""/>
            </StackPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock x:Name="ChannelNameLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="AddChannelNameBox" AutomationProperties.AutomationId="AddChannelNameBox"
                         Width="130" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                <TextBlock x:Name="ChannelMainLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="AddChannelUrlBox" AutomationProperties.AutomationId="AddChannelUrlBox"
                         Width="300" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                <TextBlock x:Name="ChannelSubLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBox x:Name="AddChannelSubUrlBox" AutomationProperties.AutomationId="AddChannelSubUrlBox"
                         Width="240" Margin="6,0,12,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                <Button x:Name="AddChannelButton" AutomationProperties.AutomationId="AddChannelButton"
                        Content="" Click="OnAddChannelClicked" Padding="8,4"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0"
                        ToolTip=""/>
            </WrapPanel>

            <ListView x:Name="ChannelList" AutomationProperties.AutomationId="ChannelList"
                      Height="150" Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F"
                      SelectionChanged="OnChannelSelected"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="46">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ChannelColName" Header="" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ChannelColDevice" Header="" Width="120"
                                        DisplayMemberBinding="{Binding DeviceLabel}"/>
                        <GridViewColumn x:Name="ChannelColMain" Header="" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MainStreamUrl}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ChannelColRecording" Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RecordingModeLabel}" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ChannelColMotion" Header="" Width="52">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MotionLabel}" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ChannelColCell" Header="" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CellLabel}" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Channel edit/delete: edit after selecting a row. Delete uses a two-step
                 confirm because channels is a CASCADE parent; a mistaken delete also wipes
                 recording indexes and events. -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="ChannelEditHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="ChannelEditHintText" AutomationProperties.AutomationId="ChannelEditHint"
                           Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChannelEditNameLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <TextBox x:Name="ChannelEditNameBox" AutomationProperties.AutomationId="ChannelEditNameBox"
                             Width="140" Margin="6,0,12,0" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    <TextBlock x:Name="ChannelEditMainLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <TextBox x:Name="ChannelEditMainUrlBox" AutomationProperties.AutomationId="ChannelEditMainUrlBox"
                             Width="260" Margin="6,0,12,0" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    <TextBlock x:Name="ChannelEditSubLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <TextBox x:Name="ChannelEditSubUrlBox" AutomationProperties.AutomationId="ChannelEditSubUrlBox"
                             Width="220" Margin="6,0,0,0" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="ChannelEditRecordingLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <ComboBox x:Name="ChannelEditModeCombo" AutomationProperties.AutomationId="ChannelEditModeCombo"
                              Width="110" Margin="6,0,12,0" ToolTip=""
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content=""/>
                    </ComboBox>
                    <CheckBox x:Name="ChannelEditMotionCheck" AutomationProperties.AutomationId="ChannelEditMotionCheck"
                              Content="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="ChannelEditSensitivityLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="White" FontSize="12"/>
                    <TextBox x:Name="ChannelEditSensitivityBox" AutomationProperties.AutomationId="ChannelEditSensitivityBox"
                             Width="60" Margin="6,0,12,0" ToolTip=""
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                    <TextBlock x:Name="ChannelEditCellLabel" Text="" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                    <ComboBox x:Name="ChannelEditCellCombo" AutomationProperties.AutomationId="ChannelEditCellCombo"
                              Width="80" Margin="6,0,12,0" ToolTip=""
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="ApplyChannelEditButton" AutomationProperties.AutomationId="ApplyChannelEditButton"
                            Content="" Click="OnApplyChannelEditClicked" Padding="8,4"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            ToolTip=""/>
                    <Button x:Name="DeleteChannelButton" AutomationProperties.AutomationId="DeleteChannelButton"
                            Content="" Click="OnDeleteChannelClicked" Margin="6,0,0,0" Padding="8,4"
                            Foreground="White" Background="#8A3C2E" BorderThickness="0"
                            ToolTip=""/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
