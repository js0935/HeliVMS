<Window x:Class="HeliVMS.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="HeliVMS 設定中心"
        Width="860" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：分類導航 -->
        <Border Background="#12233C" BorderBrush="#1F3A5F" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="設定分類"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="4,2,0,8"/>
                <ListBox x:Name="SettingsNav" AutomationProperties.AutomationId="SettingsNav"
                         SelectionChanged="OnNavChanged"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBoxItem Content="一般"/>
                    <ListBoxItem Content="儲存"/>
                    <ListBoxItem Content="頻道"/>
                    <ListBoxItem Content="授權"/>
                    <ListBoxItem Content="功能"/>
                    <ListBoxItem Content="通知"/>
                    <ListBoxItem Content="規則"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右：內容區 -->
        <Grid Grid.Column="1" Margin="12,0,0,0">

            <!-- 一般 -->
            <StackPanel x:Name="PageGeneral" AutomationProperties.AutomationId="SettingsPageGeneral">
                <TextBlock Text="一般" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock Text="版本" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="VersionText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="資料根目錄" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="DataRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="錄影目錄" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="RecordingsRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="快照目錄" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="SnapshotsRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="提示：資料根目錄可由環境變數 HELIVMS_DATA 覆寫（唯讀）。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 儲存 -->
            <StackPanel x:Name="PageStorage" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageStorage">
                <TextBlock Text="儲存" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock Text="錄影保留上限（GB；每小時依此配額自動清除最舊錄影段）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,14">
                    <Button x:Name="ApplyQuotaButton" Content="套用配額" Click="OnApplyQuotaClicked"
                            DockPanel.Dock="Right" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <TextBox x:Name="QuotaTextBox" AutomationProperties.AutomationId="QuotaTextBox"
                             Width="120" Margin="0,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>

                <TextBlock Text="目前錄影用量" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="UsageText" Margin="0,2,0,14" TextWrapping="Wrap"/>

                <TextBlock Text="快照保留（天；每小時依此刪除更舊的快照檔 jpg/bmp）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,14">
                    <Button x:Name="ApplySnapshotDaysButton" Content="套用天數" Click="OnApplySnapshotDaysClicked"
                            DockPanel.Dock="Right" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <TextBox x:Name="SnapshotDaysTextBox" AutomationProperties.AutomationId="SnapshotDaysTextBox"
                             Width="120" Margin="0,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="CleanupButton" Content="立即清理" Click="OnCleanupClicked"
                            DockPanel.Dock="Left" Padding="12,6"
                            Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
                    <TextBlock x:Name="CleanupReportText" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </DockPanel>
            </StackPanel>

            <!-- 頻道 -->
            <StackPanel x:Name="PageChannels" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageChannels">
                <TextBlock Text="頻道" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="頻道為監看與錄影之源頭資料（§4 channels 表）。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="AddChannelUrlBox" AutomationProperties.AutomationId="AddChannelUrlBox"
                             Width="300" ToolTip="RTSP 位址"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBox x:Name="AddChannelNameBox" AutomationProperties.AutomationId="AddChannelNameBox"
                             Width="120" Margin="6,0,0,0" ToolTip="頻道名稱"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <Button x:Name="AddChannelButton" AutomationProperties.AutomationId="AddChannelButton"
                            Content="＋加入頻道" Click="OnAddChannelClicked" Margin="6,0,0,0" Padding="8,4"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <Button x:Name="OnvifWizardButton" AutomationProperties.AutomationId="OnvifWizardButton"
                            Content="ONVIF 探索" Click="OnOnvifWizardClicked" Margin="6,0,0,0" Padding="8,4"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <Button x:Name="RefreshChannelsButton" AutomationProperties.AutomationId="RefreshChannelsButton"
                            Content="重新整理" Click="OnRefreshChannelsClicked" Margin="6,0,0,0" Padding="8,4"
                            Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
                </StackPanel>
                <ListView x:Name="ChannelList" AutomationProperties.AutomationId="ChannelList"
                          Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="名稱" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="RTSP" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MainStreamUrl}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="錄影" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecordingModeLabel}" FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="運動" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MotionLabel}" FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <!-- 授權 -->
            <StackPanel x:Name="PageLicense" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageLicense">
                <TextBlock Text="授權" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock Text="授權狀態" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="LicenseStatusText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="本機機器指紋（授權綁定用）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="MachineText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="貼入授權金鑰後套用（驗證成功會存到 %LOCALAPPDATA%\HeliVMS\license.lic）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="LicenseKeyBox" AutomationProperties.AutomationId="LicenseKeyBox"
                         Height="64" Margin="0,6,0,8" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <DockPanel>
                    <Button x:Name="ApplyLicenseButton" Content="套用授權金鑰" Click="OnApplyLicenseClicked"
                            DockPanel.Dock="Left" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <TextBlock x:Name="LicenseApplyText" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </DockPanel>
            </StackPanel>

            <!-- 功能 -->
            <StackPanel x:Name="PageLaunch" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageLaunch">
                <TextBlock Text="功能整合入口" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock Text="從設定中心快速開啟各功能視窗（個別功能維持獨立視窗操作）。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,12"
                           TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="LaunchPlaybackButton" Content="回放" Click="OnLaunchPlaybackClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White"/>
                    <Button x:Name="LaunchEventsButton" Content="事件中心" Click="OnLaunchEventsClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#6A5A2E" BorderThickness="0"
                            Foreground="White"/>
                    <Button x:Name="LaunchScheduleButton" Content="錄影排程" Click="OnLaunchScheduleClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White"/>
                    <Button x:Name="LaunchDetectionButton" Content="AI 偵測" Click="OnLaunchDetectionClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White"/>
                </WrapPanel>
            </StackPanel>

            <!-- 通知 -->
            <StackPanel x:Name="PageNotify" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageNotify">
                <TextBlock Text="通知" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="事件發生時外送 Webhook／SMTP（M22，§18.5 通知平面）。設定以 app_settings 為權威。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <CheckBox x:Name="NotifyEnabledBox" AutomationProperties.AutomationId="NotifyEnabledBox"
                          Content="啟用通知中心" Foreground="White" Margin="0,0,0,10"/>

                <TextBlock Text="Webhook 端點 URL（留空即停用）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="NotifyWebhookUrlBox" AutomationProperties.AutomationId="NotifyWebhookUrlBox"
                         Width="420" Margin="0,4,0,12"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>

                <CheckBox x:Name="NotifySmtpEnabledBox" AutomationProperties.AutomationId="NotifySmtpEnabledBox"
                          Content="啟用 SMTP 郵件通知" Foreground="White" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="SMTP 主機" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="NotifySmtpHostBox" AutomationProperties.AutomationId="NotifySmtpHostBox"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                        <TextBlock Text="埠（預設 587）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="NotifySmtpPortBox" AutomationProperties.AutomationId="NotifySmtpPortBox"
                                 Text="587" Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                        <TextBlock Text="寄件者地址" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="NotifySmtpFromBox" AutomationProperties.AutomationId="NotifySmtpFromBox"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="收件者（逗號分隔）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="NotifySmtpToBox" AutomationProperties.AutomationId="NotifySmtpToBox"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                        <TextBlock Text="帳號（選填；留空＝匿名）" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <TextBox x:Name="NotifySmtpUserBox" AutomationProperties.AutomationId="NotifySmtpUserBox"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                        <TextBlock Text="密碼（留空＝不變更；以 DPAPI 加密保存）"
                                   Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                        <PasswordBox x:Name="NotifySmtpPasswordBox"
                                     AutomationProperties.AutomationId="NotifySmtpPasswordBox"
                                     Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4" Margin="0,4,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="靜默時段（此期間內事件不通知；24h制 HH:mm，可跨午夜，留空＝停用）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <TextBlock Text="開始" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyQuietStartBox" AutomationProperties.AutomationId="NotifyQuietStartBox"
                             Width="90" Margin="6,0,14,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="結束" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyQuietEndBox" AutomationProperties.AutomationId="NotifyQuietEndBox"
                             Width="90" Margin="6,0,0,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                </StackPanel>

                <CheckBox x:Name="NotifyQuietRetransmitBox"
                          AutomationProperties.AutomationId="NotifyQuietRetransmitBox"
                          Content="靜默時段內事件延後補送（靜默結束後一併外送）"
                          Foreground="White" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                    <CheckBox x:Name="NotifyMqttEnabledBox" AutomationProperties.AutomationId="NotifyMqttEnabledBox"
                              Content="MQTT 發送" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="主機" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyMqttHostBox" AutomationProperties.AutomationId="NotifyMqttHostBox"
                             Width="130" Margin="6,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="埠" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyMqttPortBox" AutomationProperties.AutomationId="NotifyMqttPortBox"
                             Width="50" Margin="6,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="主題" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyMqttTopicBox" AutomationProperties.AutomationId="NotifyMqttTopicBox"
                             Width="120" Margin="6,0,0,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                    <TextBlock Text="使用者" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyMqttUserBox" AutomationProperties.AutomationId="NotifyMqttUserBox"
                             Width="110" Margin="6,0,14,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="密碼" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="NotifyMqttPasswordBox" AutomationProperties.AutomationId="NotifyMqttPasswordBox"
                                 Width="150" Margin="6,0,0,0"
                                 Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                </StackPanel>

                <TextBlock Text="Web Push 推播（RFC 8030/8292，不需外部服務）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                    <CheckBox x:Name="NotifyPushEnabledBox" AutomationProperties.AutomationId="NotifyPushEnabledBox"
                              Content="推播發送" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="端點 URL" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifyPushEndpointBox" AutomationProperties.AutomationId="NotifyPushEndpointBox"
                             Width="300" Margin="6,0,0,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                </StackPanel>
                <TextBlock Text="啟用且端點非空時自動產生 VAPID 金鑰對（ES256 P-256）；私鑰以 DPAPI 加密保存。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,12"
                           TextWrapping="Wrap"/>

                <TextBlock Text="SNMP 陷阱（SNMPv2c，裸 UDP 手編 BER，不需外部服務）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                    <CheckBox x:Name="NotifySnmpEnabledBox" AutomationProperties.AutomationId="NotifySnmpEnabledBox"
                              Content="SNMP 發送" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="主機" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifySnmpHostBox" AutomationProperties.AutomationId="NotifySnmpHostBox"
                             Width="130" Margin="6,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="埠" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifySnmpPortBox" AutomationProperties.AutomationId="NotifySnmpPortBox"
                             Width="50" Margin="6,0,10,0" Text="162"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBlock Text="Community" Foreground="{StaticResource Brand.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="NotifySnmpCommunityBox" AutomationProperties.AutomationId="NotifySnmpCommunityBox"
                             Width="90" Margin="6,0,0,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                </StackPanel>

                <DockPanel>
                    <Button x:Name="NotifyApplyButton" AutomationProperties.AutomationId="NotifyApplyButton"
                            Content="套用通知設定" Click="OnApplyNotifyClicked"
                            DockPanel.Dock="Left" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                    <TextBlock x:Name="NotifyReportText" AutomationProperties.AutomationId="NotifyReportText"
                               Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>

            <!-- 告警規則 -->
            <StackPanel x:Name="PageRules" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageRules">
                <TextBlock Text="告警規則" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="命中規則的事件限走指定通道（條件全 AND；無規則時維持全部啟用通道；第一筆命中優先）。"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="RuleNameBox" AutomationProperties.AutomationId="RuleNameBox"
                             Width="120" ToolTip="規則名稱"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <TextBox x:Name="RuleEventTypeBox" AutomationProperties.AutomationId="RuleEventTypeBox"
                             Width="100" Margin="6,0,0,0" ToolTip="事件類型（留空＝不限）"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <ComboBox x:Name="RuleChannelCombo" AutomationProperties.AutomationId="RuleChannelCombo"
                              Width="120" Margin="6,0,0,0"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="2,4"/>
                    <TextBox x:Name="RuleKeywordBox" AutomationProperties.AutomationId="RuleKeywordBox"
                             Width="110" Margin="6,0,0,0" ToolTip="事件類型或細節含此字串（留空＝不限）"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="8,4"/>
                    <Button x:Name="AddRuleButton" AutomationProperties.AutomationId="AddRuleButton"
                            Content="＋新增規則" Click="OnAddRuleClicked" Margin="6,0,0,0" Padding="8,4"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                </StackPanel>

                <TextBlock Text="限制通道（勾選＝白名單；未勾任何且規則命中＝仍走全部啟用通道）"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="RuleChannelWebhookBox" Content="Webhook" Foreground="White"/>
                    <CheckBox x:Name="RuleChannelSmtpBox" Content="SMTP" Foreground="White" Margin="18,0,0,0"/>
                    <CheckBox x:Name="RuleChannelMqttBox" Content="MQTT" Foreground="White" Margin="18,0,0,0"/>
                    <CheckBox x:Name="RuleChannelPushBox" Content="推播" Foreground="White" Margin="18,0,0,0"/>
                    <CheckBox x:Name="RuleChannelSnmpBox" Content="SNMP" Foreground="White" Margin="18,0,0,0"/>
                    <Button x:Name="ToggleRuleButton" Content="啟用/停用" Click="OnToggleRuleClicked" Margin="24,0,0,0"
                            Padding="8,4" Foreground="White" Background="#3A5A7A" BorderThickness="0"/>
                    <Button x:Name="DeleteRuleButton" Content="刪除" Click="OnDeleteRuleClicked" Margin="6,0,0,0"
                            Padding="8,4" Foreground="White" Background="#8A3C2E" BorderThickness="0"/>
                </StackPanel>

                <ListView x:Name="RuleList" AutomationProperties.AutomationId="RuleList" SelectionMode="Single"
                          Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F" Height="230">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名稱" Width="130" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="事件類型" Width="90" DisplayMemberBinding="{Binding EventType}"/>
                            <GridViewColumn Header="頻道" Width="90" DisplayMemberBinding="{Binding ChannelLabel}"/>
                            <GridViewColumn Header="關鍵字" Width="100" DisplayMemberBinding="{Binding Keyword}"/>
                            <GridViewColumn Header="通道" Width="150" DisplayMemberBinding="{Binding Channels}"/>
                            <GridViewColumn Header="啟用" Width="70" DisplayMemberBinding="{Binding EnabledLabel}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="RuleReportText" AutomationProperties.AutomationId="RuleReportText"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>