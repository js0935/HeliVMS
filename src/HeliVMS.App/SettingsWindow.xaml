<Window x:Class="HeliVMS.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow"
        Title=""
        Width="860" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: category navigation -->
        <Border Background="#12233C" BorderBrush="#1F3A5F" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock x:Name="NavHeading" DockPanel.Dock="Top" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="4,2,0,8"/>
                <ListBox x:Name="SettingsNav" AutomationProperties.AutomationId="SettingsNav"
                         SelectionChanged="OnNavChanged"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBoxItem x:Name="NavGeneral" Content=""/>
                    <ListBoxItem x:Name="NavDevices" Content=""/>
                    <ListBoxItem x:Name="NavStorage" Content=""/>
                    <ListBoxItem x:Name="NavLicense" Content=""/>
                    <ListBoxItem x:Name="NavLaunch" Content=""/>
                    <ListBoxItem x:Name="NavNotify" Content=""/>
                    <ListBoxItem x:Name="NavRules" Content=""/>
                    <ListBoxItem x:Name="NavIo" Content=""/>
                    <ListBoxItem x:Name="NavMap" Content=""/>
                    <ListBoxItem x:Name="NavUsers" Content=""/>
                    <ListBoxItem x:Name="NavBackup" Content=""/>
                    <ListBoxItem x:Name="NavAbout" Content=""/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: content area -->
        <Grid Grid.Column="1" Margin="12,0,0,0">

            <!-- General -->
            <StackPanel x:Name="PageGeneral" AutomationProperties.AutomationId="SettingsPageGeneral">
                <TextBlock x:Name="GeneralTitle" Text="" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="VersionLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="VersionText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock x:Name="DataRootLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="DataRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock x:Name="RecordingsRootLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="RecordingsRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock x:Name="SnapshotsRootLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="SnapshotsRootText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock x:Name="DataRootHintText" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock x:Name="ShareIntroText" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                    <CheckBox x:Name="ShareEnabledBox" AutomationProperties.AutomationId="ShareEnabledBox"
                              Content="" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SharePortLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <TextBox x:Name="SharePortBox" AutomationProperties.AutomationId="SharePortBox"
                             Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <TextBlock x:Name="ShareBaseUrlLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                    <TextBox x:Name="ShareBaseUrlBox" AutomationProperties.AutomationId="ShareBaseUrlBox"
                             Width="200" Margin="8,0,0,0" VerticalContentAlignment="Center"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="ShareApplyButton" AutomationProperties.AutomationId="ShareApplyButton" ToolTip=""
                            Content="" Click="OnApplyShareClicked" Margin="12,0,0,0" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="ShareServiceStatusText" AutomationProperties.AutomationId="ShareServiceStatusText"
                           Foreground="#9FB8D8" TextWrapping="Wrap"/>

                <CheckBox x:Name="OskToggleCheck" AutomationProperties.AutomationId="OskToggleCheck"
                          Content="" Foreground="#EBF3FF"
                          Margin="0,14,0,0" Checked="OnOskToggleChanged" Unchecked="OnOskToggleChanged"
                          ToolTip=""/>
                <TextBlock x:Name="LangLabel" Text="" Foreground="{StaticResource Brand.TextDim}"

                           FontSize="11" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="LangCombo" AutomationProperties.AutomationId="LangCombo"
                              Width="140" SelectionChanged="OnLangChanged"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                        <ComboBoxItem Content="" Tag="zh-Hant"/>
                        <ComboBoxItem Content="" Tag="zh-Hans"/>
                        <ComboBoxItem Content="" Tag="en"/>
                    </ComboBox>
                    <TextBlock x:Name="LangHintText" AutomationProperties.AutomationId="LangHintText"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                </StackPanel>

                <TextBlock x:Name="HwAccelLabel" Text="" Foreground="{StaticResource Brand.TextDim}"
                           FontSize="11" Margin="0,14,0,0"/>
                <ComboBox x:Name="HwAccelCombo" AutomationProperties.AutomationId="HwAccelCombo"
                          Width="180" HorizontalAlignment="Left" Margin="0,6,0,0"
                          SelectionChanged="OnHwAccelChanged"
                          Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73">
                    <ComboBoxItem Content="off" Tag="off"/>
                    <ComboBoxItem Content="auto" Tag="auto"/>
                    <ComboBoxItem Content="d3d11va" Tag="d3d11va"/>
                    <ComboBoxItem Content="cuda" Tag="cuda"/>
                    <ComboBoxItem Content="dxva2" Tag="dxva2"/>
                </ComboBox>
                <TextBlock x:Name="HwAccelHintText" AutomationProperties.AutomationId="HwAccelHintText"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"
                           Text=""/>
            </StackPanel>

            <!-- Storage -->
            <StackPanel x:Name="PageStorage" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageStorage">
                <TextBlock x:Name="StorageTitle" Text="" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="RecordingsDiskLabel" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                    <ComboBox x:Name="RecordingsDiskCombo" AutomationProperties.AutomationId="RecordingsDiskCombo"
                              Width="300" VerticalContentAlignment="Center"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="AddRecordingsDiskButton" Content="" Click="OnAddRecordingsDiskClicked" ToolTip=""
                            Padding="12,6" Margin="10,0,0,0"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            AutomationProperties.AutomationId="AddRecordingsDiskButton"/>
                </StackPanel>
                <ListView x:Name="RecordingsDiskList" Height="120" Margin="0,0,0,8"
                          AutomationProperties.AutomationId="RecordingsDiskList"
                          Foreground="White" Background="#12233D" BorderBrush="#2A4A73">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="DiskColDrive" DisplayMemberBinding="{Binding Root}" Width="110"/>
                            <GridViewColumn x:Name="DiskColRole" DisplayMemberBinding="{Binding RoleLabel}" Width="90"/>
                            <GridViewColumn x:Name="DiskColSpace" DisplayMemberBinding="{Binding SpaceLabel}" Width="280"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="SetPrimaryRecordingsDiskButton" Content="" Click="OnSetPrimaryRecordingsDiskClicked" ToolTip=""
                            Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            AutomationProperties.AutomationId="SetPrimaryRecordingsDiskButton"/>
                    <Button x:Name="RemoveRecordingsDiskButton" Content="" Click="OnRemoveRecordingsDiskClicked" ToolTip=""
                            Padding="12,6" Margin="10,0,0,0"
                            Foreground="White" Background="#8A3C2E" BorderThickness="0"
                            AutomationProperties.AutomationId="RemoveRecordingsDiskButton"/>
                    <Button x:Name="ApplyRecordingsDiskButton" Content="" Click="OnApplyRecordingsDiskClicked" ToolTip=""
                            Padding="12,6" Margin="10,0,0,0"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            AutomationProperties.AutomationId="ApplyRecordingsDiskButton"/>
                </StackPanel>
                <TextBlock x:Name="RecordingsDiskHintText" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="RecordingsDiskStatusText" Text="" TextWrapping="Wrap" Margin="0,4,0,14"
                           AutomationProperties.AutomationId="RecordingsDiskStatusText"/>
                <TextBlock x:Name="BandwidthBudgetLabel" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,4">
                    <Button x:Name="ApplyBandwidthBudgetButton" Content="" Click="OnApplyBandwidthBudgetClicked" ToolTip=""
                            DockPanel.Dock="Right" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            AutomationProperties.AutomationId="ApplyBandwidthBudgetButton"/>
                    <TextBox x:Name="BandwidthBudgetTextBox" AutomationProperties.AutomationId="BandwidthBudgetTextBox"
                             Width="120" Margin="0,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>
                <TextBlock x:Name="BandwidthBudgetHintText" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="BandwidthBudgetStatusText" Text="" TextWrapping="Wrap" Margin="0,0,0,14"
                           AutomationProperties.AutomationId="BandwidthBudgetStatusText"/>
                <TextBlock x:Name="QuotaLabel" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,14">
                    <Button x:Name="ApplyQuotaButton" Content="" Click="OnApplyQuotaClicked" ToolTip=""
                            DockPanel.Dock="Right" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="ApplyQuotaButton"/>
                    <TextBox x:Name="QuotaTextBox" AutomationProperties.AutomationId="QuotaTextBox"
                             Width="120" Margin="0,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>

                <TextBlock x:Name="UsageLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="UsageText" Margin="0,2,0,14" TextWrapping="Wrap"/>

                <TextBlock x:Name="SnapshotDaysLabel" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,14">
                    <Button x:Name="ApplySnapshotDaysButton" Content="" Click="OnApplySnapshotDaysClicked" ToolTip=""
                            DockPanel.Dock="Right" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="ApplySnapshotDaysButton"/>
                    <TextBox x:Name="SnapshotDaysTextBox" AutomationProperties.AutomationId="SnapshotDaysTextBox"
                             Width="120" Margin="0,0,10,0"
                             Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="CleanupButton" Content="" Click="OnCleanupClicked" ToolTip=""
                            DockPanel.Dock="Left" Padding="12,6"
                            Foreground="White" Background="#8A3C2E" BorderThickness="0" AutomationProperties.AutomationId="CleanupButton"/>
                    <TextBlock x:Name="CleanupReportText" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </DockPanel>
            </StackPanel>

            <!-- Devices and channels: camera (devices) and channel (channels) management was split into
                 CameraManagerWindow/ChannelManagerWindow; this page only hosts the entry points.
                 Management logic stays centralized in those windows so the two UIs cannot diverge. -->
            <StackPanel x:Name="PageDevices" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageDevices">
                <TextBlock x:Name="DevicesTitle" Text="" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="DevicesDesc" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="OpenCameraManagerButton" AutomationProperties.AutomationId="OpenCameraManagerButton"
                            Content="" Click="OnOpenCameraManagerClicked" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            ToolTip=""/>
                    <Button x:Name="OpenChannelManagerButton" AutomationProperties.AutomationId="OpenChannelManagerButton"
                            Content="" Click="OnOpenChannelManagerClicked" Padding="12,6" Margin="8,0,0,0"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            ToolTip=""/>
                </StackPanel>
            </StackPanel>



            <!-- License -->
            <StackPanel x:Name="PageLicense" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageLicense">
                <TextBlock x:Name="LicenseTitle" Text="" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="LicenseStatusLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBlock x:Name="LicenseStatusText" Margin="0,2,0,14" TextWrapping="Wrap"/>
                <TextBlock x:Name="LicenseExpiryText" Visibility="Collapsed" Margin="0,0,0,14" TextWrapping="Wrap"
                           Foreground="#F5D78E" AutomationProperties.AutomationId="LicenseExpiryText"
                           Text=""/>
                <TextBlock x:Name="LicenseStep1" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,2,0,6">
                    <Button x:Name="CopyMachineButton" Content="" Click="OnCopyMachineClicked" DockPanel.Dock="Right"
                            Padding="10,4" Margin="8,0,0,0" Foreground="White" Background="#2A5C8A" BorderThickness="0"
                            ToolTip="" AutomationProperties.AutomationId="CopyMachineButton"/>
                    <TextBlock x:Name="MachineText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="LicenseSeatsText" Margin="0,0,0,14" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"
                           AutomationProperties.AutomationId="LicenseSeatsText" Text=""/>
                <TextBlock x:Name="LicenseFeaturesLabel" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ItemsControl x:Name="LicenseFeatureList" Margin="0,2,0,14"
                              AutomationProperties.AutomationId="LicenseFeatureList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Margin="0,0,6,4" Padding="8,3"
                                       Background="#16273D" Foreground="#BFD4EC" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LicenseStep2" Text="" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="LicenseKeyBox" AutomationProperties.AutomationId="LicenseKeyBox"
                         Height="64" Margin="0,6,0,8" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                <TextBlock x:Name="LicenseStep3" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="ApplyLicenseButton" Content="" Click="OnApplyLicenseClicked" ToolTip=""
                            DockPanel.Dock="Left" Padding="12,6"
                            Foreground="White" Background="#2A5C8A" BorderThickness="0" AutomationProperties.AutomationId="ApplyLicenseButton"/>
                    <TextBlock x:Name="LicenseApplyText" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </DockPanel>
            </StackPanel>

            <!-- Features -->
            <StackPanel x:Name="PageLaunch" Visibility="Collapsed"
                        AutomationProperties.AutomationId="SettingsPageLaunch">
                <TextBlock x:Name="LaunchTitle" Text="" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
                <TextBlock x:Name="LaunchDesc" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,12"
                           TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="LaunchPlaybackButton" Content="" Click="OnLaunchPlaybackClicked" ToolTip=""
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="LaunchPlaybackButton"/>
                    <Button x:Name="LaunchEventsButton" Content="" Click="OnLaunchEventsClicked" ToolTip=""
                            Width="92" Height="40" Margin="0,0,8,8" Background="#6A5A2E" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="LaunchEventsButton"/>
                    <Button x:Name="LaunchScheduleButton" Content="" Click="OnLaunchScheduleClicked" ToolTip=""
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="LaunchScheduleButton"/>
                    <Button x:Name="LaunchDetectionButton" Content="" Click="OnLaunchDetectionClicked" ToolTip=""
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="LaunchDetectionButton"/>
                </WrapPanel>

                <TextBlock x:Name="ToolsRecordingHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,18,0,6"/>
                <WrapPanel>
                    <Button x:Name="ExportButton" Content="" ToolTip="" Click="OnExportClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="ExportButton"/>
                    <Button x:Name="ExportCenterButton" Content="" ToolTip="" Click="OnExportCenterClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="ExportCenterButton"/>
                    <Button x:Name="NotificationButton" Content="" ToolTip="" Click="OnNotificationClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#6A5A2E" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="NotificationButton"/>
                </WrapPanel>
                <TextBlock x:Name="ToolsImageHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,10,0,6"/>
                <WrapPanel>
                    <Button x:Name="RedactionButton" Content="" ToolTip="" Click="OnRedactionClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="RedactionButton"/>
                    <Button x:Name="DewarpButton" Content="" ToolTip="" Click="OnDewarpClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="DewarpButton"/>
                    <ComboBox x:Name="PtzChannelCombo" Width="120" Height="40" Margin="0,0,8,8"
                              DisplayMemberPath="Name" AutomationProperties.AutomationId="PtzChannelCombo"
                              Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73"/>
                    <Button x:Name="PtzButton" Content="" ToolTip="" Click="OnPtzClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="PtzButton"/>
                    <Button x:Name="StreamButton" Content="" ToolTip="" Click="OnStreamClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="StreamButton"/>
                    <Button x:Name="AudioButton" Content="" ToolTip="" Click="OnAudioClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="AudioButton"/>
                    <Button x:Name="PatrolButton" Content="" ToolTip="" Click="OnPatrolClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="PatrolButton"/>
                </WrapPanel>
                <TextBlock x:Name="ToolsAnalyticsHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,10,0,6"/>
                <WrapPanel>
                    <Button x:Name="ReportsButton" Content="" ToolTip="" Click="OnReportsClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="ReportsButton"/>
                    <Button x:Name="SynopsisButton" Content="" ToolTip="" Click="OnSynopsisClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="SynopsisButton"/>
                    <Button x:Name="SearchButton" Content="" ToolTip="" Click="OnSearchClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="SearchButton"/>
                    <Button x:Name="SystemHealthButton" Content="" ToolTip="" Click="OnSystemHealthClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="SystemHealthButton"/>
                    <Button x:Name="AlarmButton" Content="" ToolTip="" Click="OnAlarmManagerClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#6A5A2E" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="AlarmButton"/>
                    <Button x:Name="RulesButton" Content="" ToolTip="" Click="OnRulesClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="RulesButton"/>
                </WrapPanel>
                <TextBlock x:Name="ToolsSystemHeader" Text="" FontSize="15" FontWeight="Bold" Margin="0,10,0,6"/>
                <WrapPanel>
                    <Button x:Name="IoButton" Content="" ToolTip="" Click="OnIoClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="IoButton"/>
                    <Button x:Name="AuditButton" Content="" ToolTip="" Click="OnAuditClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="AuditButton"/>
                    <Button x:Name="LegalHoldButton" Content="" ToolTip="" Click="OnLegalHoldClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#4A4A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="LegalHoldButton"/>
                    <Button x:Name="SmartwallButton" Content="" ToolTip="" Click="OnSmartwallClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="SmartwallButton"/>
                    <Button x:Name="PosButton" Content="" ToolTip="" Click="OnPosClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#2A5C8A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="PosButton"/>
                    <Button x:Name="EdgeBackfillButton" Content="" ToolTip="" Click="OnEdgeBackfillClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#3A5A7A" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="EdgeBackfillButton"/>
                    <Button x:Name="FailoverButton" Content="" ToolTip="" Click="OnFailoverClicked"
                            Width="92" Height="40" Margin="0,0,8,8" Background="#8A3C2E" BorderThickness="0"
                            Foreground="White" AutomationProperties.AutomationId="FailoverButton"/>
                </WrapPanel>
                <TextBlock x:Name="ToolsStatusText" Text="" Foreground="#F5D78E" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ToolsStatusText"/>

                <TextBlock x:Name="TamperHeading" Text="" FontSize="15" FontWeight="Bold" Margin="0,18,0,8"/>
                <CheckBox x:Name="TamperEnabledBox" AutomationProperties.AutomationId="TamperEnabledBox"
                          Foreground="White" Checked="OnTamperToggled" Unchecked="OnTamperToggled"
                          Content=""/>
