                            <GridViewColumn x:Name="BackupColCopied" Header="" Width="54" DisplayMemberBinding="{Binding CopiedLabel}"/>
                            <GridViewColumn x:Name="BackupColFailed" Header="" Width="54" DisplayMemberBinding="{Binding FailedLabel}"/>
                            <GridViewColumn x:Name="BackupColAdvanced" Header="" Width="54" DisplayMemberBinding="{Binding AdvancedLabel}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <!-- About -->
            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <TextBlock x:Name="AboutTitle" Text="" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap"
                           Foreground="#EBF3FF" FontSize="12" Margin="0,0,0,2"/>
                <TextBlock x:Name="AboutStorageLabel" Text="" Foreground="{StaticResource Brand.TextDim}"
                           FontSize="11" Margin="0,12,0,4"/>
                <TextBlock x:Name="AboutDataText" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,2"/>
                <TextBlock x:Name="AboutRecordingText" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,2"/>
                <TextBlock x:Name="AboutSnapshotText" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,2"/>
                <TextBlock x:Name="AboutMapText" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,0,0,2"/>
                <CheckBox x:Name="AutoStartBox"
                          AutomationProperties.AutomationId="AutoStartBox" Margin="0,14,0,0"
                          Foreground="#EBF3FF" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                <TextBlock x:Name="AutoStartStatusText" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="24,4,0,0"/>
                <TextBlock x:Name="AboutVersionNote" Text=""
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11" Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>