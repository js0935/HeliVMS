<Window x:Class="HeliVMS.App.LegalHoldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="LegalHoldWindow"
        Title="HeliVMS 保存鎖定"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="保存鎖定（M66，§14.1 #13）：指定時段豁免配額汰除；沖銷留稽核（需管理員）"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="頻道" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="LegalHoldChannelCombo" AutomationProperties.AutomationId="LegalHoldChannelCombo"
                          Width="140" Margin="8,0,0,0" Foreground="Black"/>
                <TextBlock Text="起" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="LegalHoldFromBox" AutomationProperties.AutomationId="LegalHoldFromBox"
                         Width="140" Margin="8,0,0,0" Foreground="Black"/>
                <TextBlock Text="訖" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="LegalHoldToBox" AutomationProperties.AutomationId="LegalHoldToBox"
                         Width="140" Margin="8,0,0,0" Foreground="Black"/>
                <Button x:Name="LegalHoldAddButton" AutomationProperties.AutomationId="LegalHoldAddButton"
                        Content="加入鎖定" Click="OnAddClicked"
                        Width="80" Padding="0,6" Margin="14,0,0,0"
                        Foreground="White" Background="#2A8A5A" BorderThickness="0"/>
                <Button x:Name="LegalHoldRevokeButton" AutomationProperties.AutomationId="LegalHoldRevokeButton"
                        Content="沖銷選取" Click="OnRevokeClicked"
                        Width="80" Padding="0,6" Margin="8,0,0,0"
                        Foreground="White" Background="#8A3A2A" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="原因" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="LegalHoldReasonBox" AutomationProperties.AutomationId="LegalHoldReasonBox"
                         Width="420" Margin="8,0,0,0" Foreground="Black"/>
            </StackPanel>
            <TextBlock Text="時間格式：yyyy-MM-dd HH:mm（本機時間）" Margin="2,4,0,0"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="10"/>
        </StackPanel>

        <ListView Grid.Row="1" x:Name="LegalHoldList" AutomationProperties.AutomationId="LegalHoldList"
                  Margin="0,12,0,0" Foreground="White" Background="#0E1B2A"
                  BorderBrush="#1F3A5F" BorderThickness="1" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="頻道" Width="60" DisplayMemberBinding="{Binding ChannelId}"/>
                    <GridViewColumn Header="起（UTC）" Width="150" DisplayMemberBinding="{Binding FromText}"/>
                    <GridViewColumn Header="迄（UTC）" Width="150" DisplayMemberBinding="{Binding ToText}"/>
                    <GridViewColumn Header="原因" Width="160" DisplayMemberBinding="{Binding Reason}"/>
                    <GridViewColumn Header="建立人" Width="80" DisplayMemberBinding="{Binding CreatedBy}"/>
                    <GridViewColumn Header="狀態" Width="80" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="LegalHoldStatusText" AutomationProperties.AutomationId="LegalHoldStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>