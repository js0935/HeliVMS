<Window x:Class="HeliVMS.App.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AuditLogWindow"
        Title=""
        Width="1040" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="AuditHeadingText" Text=""
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="AuditCategoryLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AuditCategoryCombo" AutomationProperties.AutomationId="AuditCategoryCombo"
                          Width="120" Margin="6,0,10,0" Foreground="Black"/>
                <TextBlock x:Name="AuditActorLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AuditActorBox" AutomationProperties.AutomationId="AuditActorBox"
                         Width="120" Margin="6,0,10,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="AuditActionLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AuditActionBox" AutomationProperties.AutomationId="AuditActionBox"
                         Width="120" Margin="6,0,10,0" ToolTip=""
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock x:Name="AuditFromLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="AuditFromDate" AutomationProperties.AutomationId="AuditFromDate"
                            Width="120" Margin="6,0,10,0"/>
                <TextBlock x:Name="AuditToLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="AuditToDate" AutomationProperties.AutomationId="AuditToDate"
                            Width="120" Margin="6,0,10,0"/>
                <TextBlock x:Name="AuditLimitLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AuditLimitCombo" AutomationProperties.AutomationId="AuditLimitCombo"
                          Width="80" Margin="6,0,10,0" Foreground="Black"/>
                <Button x:Name="AuditQueryButton" AutomationProperties.AutomationId="AuditQueryButton"
                        Content="" Click="OnQueryClicked" Width="72" Padding="0,6" Margin="0,0,8,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip=""/>
                <Button x:Name="AuditExportButton" AutomationProperties.AutomationId="AuditExportButton"
                        Content="" Click="OnExportClicked" Width="92" Padding="0,6"
                        Foreground="White" Background="#3A6A5A" BorderThickness="0"
                        ToolTip=""/>
            </WrapPanel>
        </StackPanel>

        <ListView x:Name="AuditList" AutomationProperties.AutomationId="AuditList"
                  Grid.Row="1" Margin="0,12,0,0"
                  Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Time}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Actor}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Target}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="AuditStatusText" AutomationProperties.AutomationId="AuditStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
