<Window x:Class="HeliVMS.App.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AuditLogWindow"
        Title="HeliVMS 稽核日誌"
        Width="1040" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="稽核日誌（M109，§14.1）：誰、何時、對什麼、做了什麼。時序由新到舊。"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="類別" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AuditCategoryCombo" AutomationProperties.AutomationId="AuditCategoryCombo"
                          Width="120" Margin="6,0,10,0" Foreground="Black"/>
                <TextBlock Text="操作者" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AuditActorBox" AutomationProperties.AutomationId="AuditActorBox"
                         Width="120" Margin="6,0,10,0" ToolTip="精確比對操作者帳號"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock Text="動作" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <TextBox x:Name="AuditActionBox" AutomationProperties.AutomationId="AuditActionBox"
                         Width="120" Margin="6,0,10,0" ToolTip="精確比對動作代碼"
                         Foreground="White" Background="#1A2C49" BorderBrush="#2A4A73" Padding="6,4"/>
                <TextBlock Text="起" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="AuditFromDate" AutomationProperties.AutomationId="AuditFromDate"
                            Width="120" Margin="6,0,10,0"/>
                <TextBlock Text="迄" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <DatePicker x:Name="AuditToDate" AutomationProperties.AutomationId="AuditToDate"
                            Width="120" Margin="6,0,10,0"/>
                <TextBlock Text="筆數" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
                <ComboBox x:Name="AuditLimitCombo" AutomationProperties.AutomationId="AuditLimitCombo"
                          Width="80" Margin="6,0,10,0" Foreground="Black"/>
                <Button x:Name="AuditQueryButton" AutomationProperties.AutomationId="AuditQueryButton"
                        Content="查詢" Click="OnQueryClicked" Width="72" Padding="0,6" Margin="0,0,8,0"
                        Foreground="White" Background="#2A5C8A" BorderThickness="0" ToolTip="依條件重新載入稽核日誌"/>
                <Button x:Name="AuditExportButton" AutomationProperties.AutomationId="AuditExportButton"
                        Content="匯出 CSV" Click="OnExportClicked" Width="92" Padding="0,6"
                        Foreground="White" Background="#3A6A5A" BorderThickness="0"
                        ToolTip="將目前查詢條件的所有符合列匯出為 CSV（UTF-8 BOM）"/>
            </WrapPanel>
        </StackPanel>

        <ListView x:Name="AuditList" AutomationProperties.AutomationId="AuditList"
                  Grid.Row="1" Margin="0,12,0,0"
                  Background="#0E1D33" Foreground="White" BorderBrush="#1F3A5F">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時間" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Time}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="類別" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="動作" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="操作者" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Actor}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="目標" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Target}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="明細" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="AuditStatusText" AutomationProperties.AutomationId="AuditStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>
