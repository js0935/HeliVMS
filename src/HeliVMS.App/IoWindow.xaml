<Window x:Class="HeliVMS.App.IoWindow" FocusManager.FocusedElement="{Binding ElementName=IoDiCombo}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="IoWindow"
        Title=""
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1622" Foreground="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="IoHeadingText" Text=""
                   Foreground="{StaticResource Brand.TextDim}" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="IoDiLabel" Text="" VerticalAlignment="Center" Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
            <ComboBox x:Name="IoDiCombo" AutomationProperties.AutomationId="IoDiCombo"
                      Width="180" Margin="8,0,0,0" Foreground="Black"/>
            <CheckBox x:Name="IoClosedCheck" AutomationProperties.AutomationId="IoClosedCheck"
                      Content="" VerticalAlignment="Center" Margin="18,0,0,0"/>
            <Button x:Name="IoFireButton" AutomationProperties.AutomationId="IoFireButton" ToolTip=""
                    Content="" Click="OnFireClicked"
                    Width="90" Padding="0,6" Margin="14,0,0,0"
                    Foreground="White" Background="#2A6A9A" BorderThickness="0"/>
            <TextBlock x:Name="IoPhysicalLabel" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource Brand.TextDim}" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="IoPortList" AutomationProperties.AutomationId="IoPortList"
                      Foreground="White" Background="#0E1B2A" BorderBrush="#1F3A5F" BorderThickness="1"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="44" DisplayMemberBinding="{Binding KindText}"/>
                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Number}"/>
                        <GridViewColumn Header="" Width="110" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding PolarityText}"/>
                        <GridViewColumn Header="" Width="70" DisplayMemberBinding="{Binding StateText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <ListView Grid.Column="2" x:Name="IoRuleList" AutomationProperties.AutomationId="IoRuleList"
                      Foreground="White" Background="#0E1B2A" BorderBrush="#1F3A5F" BorderThickness="1"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="50" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="" Width="70" DisplayMemberBinding="{Binding InputText}"/>
                        <GridViewColumn Header="" Width="110" DisplayMemberBinding="{Binding ActionText}"/>
                        <GridViewColumn Header="" Width="70" DisplayMemberBinding="{Binding RetriggerSec}"/>
                        <GridViewColumn Header="" Width="50" DisplayMemberBinding="{Binding EnabledText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="IoStatusText" AutomationProperties.AutomationId="IoStatusText"
                   Margin="0,10,0,0" Foreground="#9FB8D8" TextWrapping="Wrap"/>
    </Grid>
</Window>