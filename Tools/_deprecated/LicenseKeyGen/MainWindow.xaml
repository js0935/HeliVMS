<Window x:Class="LicenseKeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliVMS 授權金鑰產生工具"
        Icon="app.ico"
        Width="520" Height="680"
        MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="8,8,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="HeliVMS 授權金鑰產生工具"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Click="Minimize_Click"
                                Foreground="{StaticResource SecondaryTextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <TextBlock Text="─" FontSize="14"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Click="Close_Click"
                                Foreground="{StaticResource SecondaryTextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <TextBlock Text="✕" FontSize="14"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>

                    <TextBlock FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,20">
                        <Run Text="🔑"/>
                        <Run Text=" HeliVMS 授權金鑰產生工具"/>
                    </TextBlock>

                    <!-- ===== Section 1: Device Code ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="① 設備碼" Style="{StaticResource SectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DeviceCodeBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas" FontSize="16"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="複製設備碼" Style="{StaticResource CopyButton}"
                                        Margin="8,0,0,0" Click="CopyDeviceCode_Click"/>
                            </Grid>

                            <Button Content="重新取得設備碼" Style="{StaticResource CopyButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="RefreshDeviceCode_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Section 2: License Parameters ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="② 授權參數" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="最大攝影機數" Style="{StaticResource FieldLabel}"
                                           Grid.Row="0" Grid.Column="0"/>
                                <TextBox x:Name="MaxCamerasBox" Style="{StaticResource InputBox}"
                                         Grid.Row="0" Grid.Column="1"
                                         Text="64" FontSize="13"/>

                                <TextBlock Text="到期日" Style="{StaticResource FieldLabel}"
                                           Grid.Row="1" Grid.Column="0" Margin="0,8,0,4"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,4"
                                            Orientation="Horizontal">
                                    <DatePicker x:Name="ExpiryPicker" Style="{StaticResource DatePickerInput}"
                                                FontSize="13" Width="160"/>
                                    <TextBlock Text="（留空=永久）" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="授權類型" Style="{StaticResource FieldLabel}"
                                           Grid.Row="2" Grid.Column="0" Margin="0,8,0,4"/>
                                <ComboBox x:Name="LicenseTypeBox" Style="{StaticResource ComboBoxInput}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          Grid.Row="2" Grid.Column="1" Margin="0,8,0,4">
                                    <ComboBoxItem Content="基本版 (4)" IsSelected="False"/>
                                    <ComboBoxItem Content="標準版 (16)" IsSelected="False"/>
                                    <ComboBoxItem Content="專業版 (32)" IsSelected="False"/>
                                    <ComboBoxItem Content="進階版 (64)" IsSelected="True"/>
                                    <ComboBoxItem Content="企業版 (128)" IsSelected="False"/>
                                    <ComboBoxItem Content="客製版" IsSelected="False"/>
                                </ComboBox>

                                <TextBlock Text="被授權人" Style="{StaticResource FieldLabel}"
                                           Grid.Row="3" Grid.Column="0" Margin="0,8,0,4"/>
                                <TextBox x:Name="LicenseeBox" Style="{StaticResource InputBox}"
                                         Grid.Row="3" Grid.Column="1" Margin="0,8,0,4"
                                         Text="禾秝公司" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Section 3: Generate ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="③ 產生授權碼" Style="{StaticResource SectionHeader}"/>

                            <Button x:Name="GenerateBtn" Content="產生授權碼"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Click="GenerateKey_Click"/>

                            <TextBlock Text="授權碼（格式：AAAA-BBBB-CCCC-DDDD）" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LicenseKeyBox" Style="{StaticResource ReadOnlyBox}"
                                         FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                         TextWrapping="Wrap" MaxHeight="80"
                                         VerticalScrollBarVisibility="Auto"/>
                                <Button Grid.Column="1" Content="複製授權碼" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" VerticalAlignment="Bottom"
                                        Click="CopyLicenseKey_Click"/>
                            </Grid>

                            <TextBlock x:Name="StatusText" Style="{StaticResource FieldLabel}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="禾秝軟體開發團隊  版權所有"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔑 變更密碼"
                                Style="{StaticResource CopyButton}"
                                FontSize="11" Padding="8,2"
                                Click="ChangePassword_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
