<Window x:Class="LicenseKeyGen.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeliVMS 授權金鑰工具 — 驗證"
        Width="380" Height="270"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        MouseDown="Window_MouseDown">
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="8,8,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="HeliVMS 授權金鑰工具 — 驗證"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <Button Width="32" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Click="Close_Click"
                            Foreground="{StaticResource SecondaryTextBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <TextBlock Text="✕" FontSize="14"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0,24,24">
                <TextBlock Text="🔑 HeliVMS 授權金鑰產生工具"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="請輸入密碼"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <PasswordBox x:Name="PasswordInput"
                             Style="{StaticResource PasswordBoxInput}"
                             FontSize="16"
                             Padding="10,8"
                             MaxLength="32"
                             KeyDown="PasswordInput_KeyDown"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                <Button Content="登入" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Padding="40,8"
                        Click="Login_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
